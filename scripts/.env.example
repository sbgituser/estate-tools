# =============================================
# update-cities.mjs API キー設定
# =============================================
# このファイルをコピーして .env にリネームしてください
# cp scripts/.env.example scripts/.env

# --------------------------------------------------
# 国土交通省 不動産情報ライブラリ API キー（必須）
# 取得: https://www.reinfolib.mlit.go.jp/ → 新規登録 → APIキー発行
# --------------------------------------------------
REINFOLIB_API_KEY=your_reinfolib_api_key_here

# --------------------------------------------------
# e-Stat API アプリケーション ID（人口・世帯数取得に使用）
# 取得: https://www.e-stat.go.jp/api/ → ユーザ登録 → アプリケーションID発行
# --------------------------------------------------
ESTAT_APP_ID=your_estat_app_id_here
