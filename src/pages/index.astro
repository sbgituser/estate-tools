---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';

const tools = [
  {
    href: '/calculators/yield',
    icon: '📊',
    label: 'Calculator',
    title: '不動産利回り計算ツール',
    description: '物件価格・家賃・空室率・諸費用を入力するだけで、表面利回りと実質利回りを即時算出。投資判断の第一歩に。',
    badge: '無料',
  },
  {
    href: '/calculators/roi',
    icon: '💹',
    label: 'Calculator',
    title: '不動産投資ROI計算ツール',
    description: '頭金・諸費用・ローン返済まで考慮した自己資金ベースの投資収益率（ROI）を計算。実際の手残りキャッシュフローも確認できます。',
    badge: '無料',
  },
  {
    href: '/calculators/mortgage',
    icon: '🏦',
    label: 'Simulator',
    title: '住宅ローン返済シミュレーター',
    description: '借入額・金利・返済年数を入力するだけで毎月返済額・総返済額・返済負担率を即計算。元利均等と元金均等の比較も可能です。',
    badge: '無料',
  },
  {
    href: '/calculators/fixed-asset-tax',
    icon: '🏛️',
    label: 'Simulator',
    title: '固定資産税シミュレーター',
    description: '土地・建物の評価額を入力するだけで固定資産税・都市計画税の年間概算額を即計算。住宅用地の特例や新築軽減にも対応。',
    badge: '無料',
  },
  {
    href: '/calculators/real-estate-acquisition-tax',
    icon: '🏷️',
    label: 'Simulator',
    title: '不動産取得税シミュレーター',
    description: '新築・中古住宅・土地の不動産取得税を評価額から概算計算。宅地評価土地の1/2特例・住宅用軽減措置に対応した購入時コストの試算ツール。',
    badge: '無料',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '不動産ツールズ',
  url: 'https://estate.kuras-plus.com',
  description: '不動産投資の意思決定をサポートする無料計算ツール集',
};
---

<BaseLayout
  title="不動産ツールズ | kuras-plus"
  description="不動産投資の意思決定をサポートする無料ツール集。利回り計算・ROI計算など。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/" />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <p class="hero-eyebrow">Real Estate Tools</p>
      <h1 class="hero-title">不動産投資を、<br />数字で考える。</h1>
      <p class="hero-desc">
        物件選びから収益シミュレーションまで、不動産投資の意思決定を支援する無料ツール集です。
      </p>
    </div>
  </section>

  <!-- Tools -->
  <section class="container mt-48">
    <h2 class="section-title">ツール一覧</h2>
    <p class="section-sub">すべて無料・登録不要でご利用いただけます</p>
    <div class="tool-grid">
      {tools.map((tool) => (
        <ToolCard {...tool} />
      ))}
    </div>
  </section>

  <!-- About -->
  <section class="container mt-48" style="max-width: 680px; padding-bottom: 80px;">
    <h2 class="section-title">このサイトについて</h2>
    <p class="section-sub" style="margin-bottom: 0; line-height: 1.8;">
      不動産ツールズは、個人投資家や不動産購入を検討している方向けに、
      複雑な計算をシンプルに解決するウェブツールを提供しています。
      登録・ログイン不要、すべてブラウザ上で完結します。
    </p>
  </section>

  <Footer slot="footer" />
</BaseLayout>
