<script>
/* ─── Helpers ─── */
function fmt(v: number, d = 0): string {
  return v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d });
}
function getNum(id: string, fb = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fb;
  const v = parseFloat(el.value);
  return isNaN(v) ? fb : v;
}
function setText(id: string, t: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = t;
}
function clamp(v: number, a: number, b: number): number {
  return Math.max(a, Math.min(b, v));
}
function getRadio(name: string, fb: string): string {
  const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
  return el?.value ?? fb;
}
function updateFill(s: HTMLInputElement) {
  const mn = parseFloat(s.min) || 0, mx = parseFloat(s.max) || 100, v = parseFloat(s.value) || 0;
  s.style.setProperty('--pct', `${clamp((v - mn) / (mx - mn) * 100, 0, 100)}%`);
}
function updateDisplay(id: string, val: string) {
  const el = document.getElementById(`${id}Display`);
  if (el) el.textContent = val;
}
function hideSampleBadge() {
  const b = document.getElementById('sampleBadge');
  if (b) b.hidden = true;
}
function show(id: string, visible: boolean) {
  const el = document.getElementById(id);
  if (el) el.hidden = !visible;
}

/* ─── Visibility ─── */
function updateVisibility() {
  const type = getRadio('propertyType', 'detached');
  const isLandOnly = type === 'land-only';
  const usage = getRadio('usage', 'residential');
  const isResidentialLand = getRadio('isResidentialLand', 'yes') === 'yes';

  show('buildingSection', !isLandOnly);
  show('smallScaleGroup', isResidentialLand);
  show('newBuildingGroup', !isLandOnly && usage === 'residential');
}

/* ─── Calculate ─── */
function calculate() {
  const type              = getRadio('propertyType', 'detached');
  const usage             = getRadio('usage', 'residential');
  const isCityTaxArea     = getRadio('cityTax', 'yes') === 'yes';
  const landAssess        = getNum('landAssess', 1500);
  const isResidentialLand = getRadio('isResidentialLand', 'yes') === 'yes';
  const isSmallScale      = getRadio('isSmallScale', 'yes') === 'yes';
  const isLandOnly        = type === 'land-only';
  const buildingAssess    = isLandOnly ? 0 : getNum('buildingAssess', 800);
  const isNewBuilding     = !isLandOnly && usage === 'residential' && getRadio('newBuilding', 'no') === 'yes';

  // Validate
  const errEl = document.getElementById('errorMsg');
  if (landAssess <= 0 && buildingAssess <= 0) {
    if (errEl) { errEl.textContent = '土地または建物の評価額を1以上で入力してください。'; errEl.hidden = false; }
    return;
  }
  if (errEl) errEl.hidden = true;

  // ── Land ──
  let landPropBase: number, landCityBase: number;
  if (isResidentialLand) {
    if (isSmallScale) {
      landPropBase = landAssess / 6;
      landCityBase = landAssess / 3;
    } else {
      landPropBase = landAssess / 3;
      landCityBase = landAssess * 2 / 3;
    }
  } else {
    landPropBase = landAssess;
    landCityBase = landAssess;
  }
  const landPropTax  = landPropBase * 0.014;
  const landCityTax  = isCityTaxArea ? landCityBase * 0.003 : 0;

  // ── Building ──
  const buildingPropBase = isNewBuilding ? buildingAssess / 2 : buildingAssess;
  const buildingPropTax  = buildingPropBase * 0.014;
  const buildingCityTax  = isCityTaxArea && !isLandOnly ? buildingAssess * 0.003 : 0;

  // ── Totals ──
  const totalPropTax = landPropTax + buildingPropTax;
  const totalCityTax = landCityTax + buildingCityTax;
  const totalTax     = totalPropTax + totalCityTax;
  const monthlyTax   = totalTax / 12;

  // ── No-reduction comparison ──
  const noRedLand     = landAssess * 0.014 + (isCityTaxArea ? landAssess * 0.003 : 0);
  const noRedBuilding = isLandOnly ? 0 : (buildingAssess * 0.014 + (isCityTaxArea ? buildingAssess * 0.003 : 0));
  const noRedTotal    = noRedLand + noRedBuilding;
  const saving        = noRedTotal - totalTax;

  // ── DOM update ──
  setText('rTotal',          fmt(totalTax, 2) + ' 万円/年');
  setText('rMonthly',        fmt(monthlyTax, 2) + ' 万円/月');
  setText('rPropTax',        fmt(totalPropTax, 2) + ' 万円');
  setText('rLandPropTax',    fmt(landPropTax, 2) + ' 万円');
  setText('rBuildingPropTax',fmt(buildingPropTax, 2) + ' 万円');
  setText('rCityTax',        fmt(totalCityTax, 2) + ' 万円');
  setText('rLandCityTax',    fmt(landCityTax, 2) + ' 万円');
  setText('rBuildingCityTax',fmt(buildingCityTax, 2) + ' 万円');
  setText('rNoReduction',    fmt(noRedTotal, 2) + ' 万円/年');
  setText('rSaving',         saving > 0.005
    ? '▼ ' + fmt(saving, 2) + ' 万円/年の節税効果'
    : '特例・軽減の適用なし（同額）');

  // ── Conditional display ──
  show('bldPropRow',  !isLandOnly);
  show('citySection', isCityTaxArea);
  show('bldCityRow',  !isLandOnly && isCityTaxArea);

  // ── Special measures ──
  const measures: string[] = [];
  if (isResidentialLand) {
    if (isSmallScale) {
      measures.push('小規模住宅用地の特例：固定資産税は評価額の 1/6、都市計画税は 1/3 に軽減');
    } else {
      measures.push('住宅用地の特例（大規模）：固定資産税は評価額の 1/3、都市計画税は 2/3 に軽減');
    }
  }
  if (isNewBuilding) {
    measures.push('新築住宅の軽減措置：建物の固定資産税を 1/2 に軽減（戸建て3年・マンション等5年）');
  }
  if (!isCityTaxArea) {
    measures.push('都市計画税：対象外のため 0 円');
  }
  if (measures.length === 0) {
    measures.push('特例・軽減の適用なし');
  }
  const measuresList = document.getElementById('measuresList');
  if (measuresList) {
    measuresList.innerHTML = measures.map(m => `<div class="measure-item">✓ ${m}</div>`).join('');
  }

  // ── Investment note ──
  const totalAssess = landAssess + buildingAssess;
  if (totalAssess > 0) {
    const rate = (totalTax / totalAssess * 100).toFixed(2);
    setText('rInvestNote',
      `年間保有コスト（税合計）は評価額合計の約 ${rate}% です。` +
      `投資物件のROI計算では、この固定資産税額（年間 ${fmt(totalTax, 1)} 万円）を` +
      `ROI計算ツールの「年間固定費」に入力することで、より正確な収益シミュレーションができます。`
    );
  }
}

/* ─── Slider sync ─── */
function syncSliderToNum(slider: HTMLInputElement) {
  const targetId = slider.dataset.target;
  if (!targetId) return;
  const numEl = document.getElementById(targetId) as HTMLInputElement | null;
  if (!numEl) return;
  numEl.value = slider.value;
  updateFill(slider);
  updateDisplay(targetId, slider.value);
}

function syncNumToSlider(numEl: HTMLInputElement) {
  const slider = document.querySelector<HTMLInputElement>(`input.range-slider[data-target="${numEl.id}"]`);
  if (!slider) return;
  const mn = parseFloat(slider.min) || 0, mx = parseFloat(slider.max) || 100, step = parseFloat(slider.step) || 1;
  let v = parseFloat(numEl.value);
  if (isNaN(v) || v < mn) v = mn;
  if (v > mx) v = mx;
  v = Math.round(v / step) * step;
  numEl.value = String(v); slider.value = String(v);
  updateFill(slider);
  updateDisplay(numEl.id, numEl.value);
}

/* ─── Init ─── */
document.addEventListener('DOMContentLoaded', () => {
  // Sliders
  document.querySelectorAll<HTMLInputElement>('input.range-slider').forEach(slider => {
    updateFill(slider);
    slider.addEventListener('input', () => {
      syncSliderToNum(slider);
      hideSampleBadge();
      calculate();
    });
  });

  // Number inputs
  document.querySelectorAll<HTMLInputElement>('input.field-input').forEach(numEl => {
    numEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['-', 'e', 'E', '+'].includes(e.key)) e.preventDefault();
    });
    numEl.addEventListener('change', () => {
      syncNumToSlider(numEl);
      hideSampleBadge();
      calculate();
    });
  });

  // Radio buttons
  document.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', () => {
      hideSampleBadge();
      updateVisibility();
      calculate();
    });
  });

  updateVisibility();
  calculate();
});
</script>
