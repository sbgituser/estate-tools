---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';

const faqItems = [
  {
    q: 'ROIと利回りはどう違いますか？',
    a: '利回り（表面・実質）は物件価格全体に対する収益率です。ROIは頭金＋諸費用という「実際に自分が出したお金」に対する収益率です。同じ物件でも頭金が少ない（レバレッジを効かせる）ほどROIは高くなります。利回りは物件の収益力、ROIは自己資金の効率を測る指標です。',
  },
  {
    q: '不動産ROIの目安は何%ですか？',
    a: '一般的にROI8〜15%程度が良好とされますが、借入比率によって大きく変わるため一概には言えません。フルローンに近い場合はROIが非常に高く見えますが、空室・修繕などのリスクに耐える自己資金の余裕も必要です。ROIの数値だけでなく、年間手残り額（CF）の絶対値も必ず確認してください。',
  },
  {
    q: '自己資金が少ないほどROIは高くなりますか？',
    a: 'その通りですが、注意が必要です。頭金を減らすと借入が増えローン返済額も増えるため、年間CFが減る可能性があります。またROIの「分母」が小さくなるので率としては上がりますが、CFがマイナスになればROIもマイナスです。自己資金とレバレッジのバランスをシミュレーターで複数パターン比較することをお勧めします。',
  },
  {
    q: 'ROIが高い物件ほど良い投資ですか？',
    a: '必ずしもそうではありません。ROIは高くても①空室リスクが高い立地、②修繕費が多い築古物件、③変動金利リスクが高い条件、④出口（売却）で価格が下がる物件などは総合的な収益が悪化します。ROIと同時に利回り・CF・立地・物件状態・出口戦略を総合的に判断することが重要です。',
  },
  {
    q: 'ローンを使うとROIはどう変わりますか？',
    a: 'ローンを使うと自己資金（分母）が小さくなるためROIは上がりやすくなります。ただし返済利息分だけ実質的な収益は下がります。金利が低く物件利回りが高い（スプレッドがプラス）場合はレバレッジが効きROIを高められますが、金利が物件利回りを上回るとCFはマイナスになります。このシミュレーターでローン条件を変えながら確認してみてください。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '不動産投資ROI計算ツール',
    url: 'https://estate.kuras-plus.com/calculators/roi',
    description: '頭金・諸費用・ローン返済を含めた実質ROI（投資収益率）を無料で即計算。自己資金に対する収益率を正確に把握できます。',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: '不動産投資ROIの計算方法｜利回りとの違いも分かるシミュレーター付き',
    url: 'https://estate.kuras-plus.com/calculators/roi',
    description: '不動産投資ROIの計算方法を初心者向けに解説。利回りとの違い、自己資金ベースでの見方、注意点を整理しながらシミュレーターで試算できます。',
    author: { '@type': 'Organization', name: '不動産ツールズ | kuras-plus' },
    publisher: { '@type': 'Organization', name: '不動産ツールズ | kuras-plus', url: 'https://estate.kuras-plus.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://estate.kuras-plus.com' },
      { '@type': 'ListItem', position: 2, name: 'ROI計算ツール', item: 'https://estate.kuras-plus.com/calculators/roi' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const relatedTools = [
  { href: '/calculators/yield',              icon: '📊', title: '不動産利回り計算ツール',         desc: '表面・実質利回りをシンプルに確認' },
  { href: '/calculators/cash-flow',          icon: '💰', title: 'CFシミュレーター',               desc: 'ローン返済後の年間手残りを長期試算' },
  { href: '/calculators/repair-cost',        icon: '🔧', title: '修繕費シミュレーター',           desc: '築年数別の長期修繕コストを試算' },
  { href: '/calculators/rent-vacancy-impact',icon: '📉', title: '家賃下落・空室率影響シミュレーター', desc: '2軸マトリクスで収益への影響を確認' },
  { href: '/calculators/price-check',        icon: '🔍', title: '価格妥当性チェッカー',           desc: '購入価格が相場として適正かを確認' },
  { href: '/calculators/down-payment',       icon: '💴', title: '頭金シミュレーター',             desc: '頭金の違いがCF・ROIに与える影響を比較' },
];

const relatedArticles = [
  { href: '/articles/roi-vs-yield',           tag: 'ROI解説',   title: 'ROIと利回りの違い｜不動産投資2つの収益指標を徹底比較',  desc: '計算式・具体例でROIと利回りの使い分けを解説' },
  { href: '/articles/cashflow-basics',        tag: 'CF解説',    title: '不動産投資のキャッシュフローとは｜計算方法と目安を解説', desc: '手残り収益の計算方法と目安、利回りとの違い' },
  { href: '/articles/how-much-down-payment',  tag: '頭金',      title: '頭金はいくら必要か｜不動産投資の自己資金の目安と考え方', desc: '頭金の目安とROI・CFへの影響をわかりやすく解説' },
  { href: '/articles/vacancy-rate',           tag: 'リスク管理', title: '空室率の目安と見込み方｜不動産投資リスク管理の基本',    desc: 'エリア別空室率の目安とシナリオ設定方法' },
];
---

<BaseLayout
  title="不動産投資ROIの計算方法｜利回りとの違いも分かるシミュレーター付き"
  description="不動産投資ROIの計算方法を初心者向けに解説。利回りとの違い、自己資金ベースでの見方、注意点を整理しながらシミュレーターで試算できます。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/roi" />

  <!-- ── Hero ── -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>ROI計算ツール</span>
      </nav>
      <p class="hero-eyebrow">ROI Calculator · 解説＋シミュレーター</p>
      <h1 class="hero-title">不動産投資ROIの計算方法</h1>
      <p class="hero-desc">
        利回りとの違い・自己資金ベースの見方を解説しながら、<br />
        シミュレーターで実際の数値を即時確認できます。
      </p>
    </div>
  </section>

  <!-- ── Article body ── -->
  <div class="article-outer">
    <div class="article-container">

      <!-- Summary Box -->
      <div class="summary-box">
        <p class="sb-lead">この記事でわかること</p>
        <ul class="sb-list">
          <li>ROI（投資収益率）の定義と計算式</li>
          <li>ROIと利回りの具体的な違い</li>
          <li>自己資金・レバレッジとROIの関係</li>
          <li>ROIだけで判断してはいけない理由</li>
        </ul>
      </div>

      <!-- Section 1: ROIとは -->
      <section class="art-section">
        <h2 class="art-h2">ROI（投資収益率）とは何か</h2>
        <p class="art-prose">
          ROI（Return on Investment）とは、投資に使った自己資金に対してどれだけの収益を得られたかを示す指標です。
          不動産投資では以下の式で計算します。
        </p>
        <div class="formula-block">
          <div class="formula-main">ROI（%）＝ 年間手残り収益（CF） ÷ 投下自己資金 × 100</div>
          <div class="formula-sub">
            <span>年間手残り収益（CF）＝ 年間NOI − 年間ローン返済額</span>
            <span>投下自己資金 ＝ 頭金 ＋ 購入時諸費用</span>
          </div>
        </div>
        <p class="art-prose">
          利回りはローン返済を考慮しませんが、ROIはローン返済後の実際の手残りを自己資金で割るため、
          借入（レバレッジ）の効果を含んだ収益率を把握できます。
        </p>
      </section>

      <!-- Section 2: ROIと利回りの違い -->
      <section class="art-section">
        <h2 class="art-h2">ROIと利回りの違い</h2>
        <p class="art-prose">
          3つの指標はそれぞれ「分母」が異なります。見ている観点が違うため、用途に応じて使い分けることが重要です。
        </p>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th></th>
                <th>表面利回り</th>
                <th>実質利回り</th>
                <th class="highlight-col">ROI</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="row-label">分母</td>
                <td>物件価格</td>
                <td>物件価格＋諸費用</td>
                <td class="highlight-col">頭金＋諸費用</td>
              </tr>
              <tr>
                <td class="row-label">ローン返済</td>
                <td>含まない</td>
                <td>含まない</td>
                <td class="highlight-col">含む</td>
              </tr>
              <tr>
                <td class="row-label">レバレッジ反映</td>
                <td>されない</td>
                <td>されない</td>
                <td class="highlight-col">される</td>
              </tr>
              <tr>
                <td class="row-label">主な用途</td>
                <td>物件の大まかな比較</td>
                <td>物件収益力の評価</td>
                <td class="highlight-col">自己資金効率の評価</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="art-prose">
          例えば5,000万円の物件を頭金500万円（諸費用150万円）で購入し、年間CF100万円なら、<br />
          ROI ＝ 100 ÷ 650 × 100 ≒ <strong>15.4%</strong>　←　自己資金に対してこれだけ効率よく稼いでいる
        </p>
      </section>

      <!-- Section 3: ROIを見るメリット -->
      <section class="art-section">
        <h2 class="art-h2">ROIを見るメリット</h2>
        <div class="merit-list">
          <div class="merit-item">
            <div class="merit-num">01</div>
            <div class="merit-body">
              <h3 class="merit-title">レバレッジ効果を数値で把握できる</h3>
              <p class="merit-desc">
                ローンを使うと少ない自己資金で大きな物件を運用できます。ROIはその効果を「自己資金ベースの収益率」として明示します。
                利回りでは見えないこのレバレッジ効果を確認できる点がROI最大のメリットです。
              </p>
            </div>
          </div>
          <div class="merit-item">
            <div class="merit-num">02</div>
            <div class="merit-body">
              <h3 class="merit-title">異なる資金調達方法を比較できる</h3>
              <p class="merit-desc">
                同じ物件でも「頭金20%」と「頭金30%」ではROIが変わります。
                どの資金配分が自己資金を最も効率よく運用できるか、シミュレーターで複数パターンを試算して比較できます。
              </p>
            </div>
          </div>
          <div class="merit-item">
            <div class="merit-num">03</div>
            <div class="merit-body">
              <h3 class="merit-title">他の投資との比較ができる</h3>
              <p class="merit-desc">
                ROIは不動産以外の投資（株式・債券など）とも共通の指標です。
                「同じ自己資金を他の投資に回した場合と比べてどうか」という観点で判断する際にも使えます。
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Banner -->
      <div class="cta-banner">
        <p class="cta-banner-text">
          頭金・金利・空室率を変えるとROIがどう変わるか、<br class="sp-br" />
          下のシミュレーターで実際に確認してみましょう。
        </p>
        <a href="#simulator" class="cta-banner-btn">シミュレーターを使う ↓</a>
      </div>

    </div>
  </div>

  <!-- ── Calculator ── -->
  <div class="container tool-section" id="simulator">
    <h2 class="section-title tool-heading">🧮 ROIシミュレーター</h2>
    <p class="tool-desc">各入力値を変更すると結果がリアルタイムで更新されます。</p>

    <div class="calc-layout">

      <!-- ── Inputs ── -->
      <section class="card" aria-label="入力フォーム">
        <h2 class="card-heading">投資情報を入力</h2>

        <p class="group-label">物件・自己資金</p>

        <!-- 物件価格 -->
        <div class="field-group">
          <div class="field-label">
            <label for="price">物件価格</label>
            <span class="field-display"><span id="priceDisplay">3,000</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="priceSlider"
            data-target="price" value="3000" min="100" max="20000" step="100" />
          <input class="field-input" type="number" id="price"
            value="3000" min="100" max="20000" step="100" inputmode="numeric"
            data-shared="shared-property-price" />
        </div>

        <!-- 頭金 -->
        <div class="field-group">
          <div class="field-label">
            <label for="down">頭金</label>
            <span class="field-display"><span id="downDisplay">600</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="downSlider"
            data-target="down" value="600" min="0" max="3000" step="50" />
          <input class="field-input" type="number" id="down"
            value="600" min="0" max="3000" step="50" inputmode="numeric"
            data-shared="shared-down-payment" />
          <p class="field-hint">物件価格の20〜30%が一般的な目安。0の場合はフルローン。</p>
        </div>

        <!-- 諸費用 -->
        <div class="field-group">
          <div class="field-label">
            <label for="expenses">諸費用</label>
            <span class="field-display"><span id="expensesDisplay">120</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="expensesSlider"
            data-target="expenses" value="120" min="0" max="500" step="10" />
          <input class="field-input" type="number" id="expenses"
            value="120" min="0" max="500" step="10" inputmode="numeric" />
          <p class="field-hint">仲介手数料・登記費用・火災保険等。物件価格の3〜5%が目安。</p>
        </div>

        <hr class="divider" />
        <p class="group-label">収益・費用</p>

        <!-- 月額家賃 -->
        <div class="field-group">
          <div class="field-label">
            <label for="rent">月額家賃（満室想定）</label>
            <span class="field-display"><span id="rentDisplay">12.0</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="rentSlider"
            data-target="rent" value="12" min="1" max="100" step="0.5" />
          <input class="field-input" type="number" id="rent"
            value="12" min="1" max="100" step="0.5" inputmode="decimal"
            data-shared="shared-monthly-rent" />
        </div>

        <!-- 空室率 -->
        <div class="field-group">
          <div class="field-label">
            <label for="vacancy">空室率</label>
            <span class="field-display"><span id="vacancyDisplay">10</span> %</span>
          </div>
          <input class="range-slider" type="range" id="vacancySlider"
            data-target="vacancy" value="10" min="0" max="50" step="1" />
          <input class="field-input" type="number" id="vacancy"
            value="10" min="0" max="50" step="1" inputmode="numeric"
            data-shared="shared-vacancy-rate" />
        </div>

        <!-- 年間固定費 -->
        <div class="field-group">
          <div class="field-label">
            <label for="fixedCosts">年間固定費</label>
            <span class="field-display"><span id="fixedCostsDisplay">0</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="fixedCostsSlider"
            data-target="fixedCosts" value="0" min="0" max="200" step="5" />
          <input class="field-input" type="number" id="fixedCosts"
            value="0" min="0" max="200" step="5" inputmode="numeric" />
          <p class="field-hint">固定資産税・都市計画税・保険料など。</p>
        </div>

        <!-- 管理費率 -->
        <div class="field-group">
          <div class="field-label">
            <label for="mgmtRate">管理費率</label>
            <span class="field-display"><span id="mgmtRateDisplay">5.0</span> %</span>
          </div>
          <input class="range-slider" type="range" id="mgmtRateSlider"
            data-target="mgmtRate" value="5" min="0" max="20" step="0.5" />
          <input class="field-input" type="number" id="mgmtRate"
            value="5" min="0" max="20" step="0.5" inputmode="decimal" />
          <p class="field-hint">家賃収入に対する管理会社手数料。5〜10%が目安。</p>
        </div>

        <!-- 修繕費 -->
        <div class="field-group">
          <div class="field-label">
            <label for="repair">修繕費（年間）</label>
            <span class="field-display"><span id="repairDisplay">6</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="repairSlider"
            data-target="repair" value="6" min="0" max="100" step="1" />
          <input class="field-input" type="number" id="repair"
            value="6" min="0" max="100" step="1" inputmode="numeric" />
        </div>

        <!-- その他費用 -->
        <div class="field-group">
          <div class="field-label">
            <label for="other">その他年間費用</label>
            <span class="field-display"><span id="otherDisplay">0</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="otherSlider"
            data-target="other" value="0" min="0" max="100" step="1" />
          <input class="field-input" type="number" id="other"
            value="0" min="0" max="100" step="1" inputmode="numeric" />
        </div>

        <hr class="divider" />
        <p class="group-label">ローン条件</p>

        <!-- ローン金利 -->
        <div class="field-group">
          <div class="field-label">
            <label for="loanRate">ローン金利（年利）</label>
            <span class="field-display"><span id="loanRateDisplay">1.5</span> %</span>
          </div>
          <input class="range-slider" type="range" id="loanRateSlider"
            data-target="loanRate" value="1.5" min="0" max="10" step="0.1" />
          <input class="field-input" type="number" id="loanRate"
            value="1.5" min="0" max="10" step="0.1" inputmode="decimal"
            data-shared="shared-loan-rate" />
          <p class="field-hint">変動金利は0.5〜1%台、固定金利は1〜2%台が現在の目安。</p>
        </div>

        <!-- ローン年数 -->
        <div class="field-group">
          <div class="field-label">
            <label for="loanYears">ローン年数</label>
            <span class="field-display"><span id="loanYearsDisplay">35</span> 年</span>
          </div>
          <input class="range-slider" type="range" id="loanYearsSlider"
            data-target="loanYears" value="35" min="1" max="50" step="1" />
          <input class="field-input" type="number" id="loanYears"
            value="35" min="1" max="50" step="1" inputmode="numeric"
            data-shared="shared-loan-years" />
        </div>

        <div id="errorMsg" class="error-msg" hidden></div>
      </section>

      <!-- ── Results ── -->
      <section class="card results-card" aria-label="計算結果" aria-live="polite">
        <h2 class="card-heading">計算結果</h2>

        <div id="sampleBadge" class="sample-badge">
          <span>📋</span> サンプル値による計算例 — 値を変更すると即時更新されます
        </div>

        <div id="resultContent">

          <!-- ROI + Cashflow hero -->
          <div class="hero-metrics">
            <div class="metric-box" id="roiBox">
              <div class="metric-label">ROI（自己資金収益率）</div>
              <div class="metric-value" id="roiValue">—</div>
              <div class="metric-bar-wrap">
                <div class="metric-bar" id="roiBar" style="width:0%"></div>
              </div>
              <div class="metric-note" id="roiNote"></div>
            </div>
            <div class="metric-box sub" id="cashflowBox">
              <div class="metric-label">年間手残り収益</div>
