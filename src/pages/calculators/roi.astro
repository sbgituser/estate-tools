<script>
/* ─── Helpers ─────────────────────────────────────── */

function fmt(val: number, dec = 0): string {
  return val.toLocaleString('ja-JP', {
    minimumFractionDigits: dec,
    maximumFractionDigits: dec,
  });
}

function getNum(id: string, fallback = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fallback;
  const v = parseFloat(el.value);
  return isNaN(v) ? fallback : v;
}

function setText(id: string, text: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = text;
}

function clamp(val: number, min: number, max: number): number {
  return Math.max(min, Math.min(max, val));
}

/** スライダーの塗り色を更新 */
function updateFill(slider: HTMLInputElement) {
  const min = parseFloat(slider.min) || 0;
  const max = parseFloat(slider.max) || 100;
  const val = parseFloat(slider.value) || 0;
  const pct = clamp((val - min) / (max - min) * 100, 0, 100);
  slider.style.setProperty('--pct', `${pct}%`);
}

/** ライブ表示スパン更新 */
function updateDisplay(id: string, val: string) {
  const el = document.getElementById(`${id}Display`);
  if (el) el.textContent = val;
}

/* ─── 計算 ─────────────────────────────────────────── */

function pmt(principal: number, annualRatePct: number, years: number): number {
  if (principal <= 0) return 0;
  if (annualRatePct === 0) return principal / (years * 12);
  const r = annualRatePct / 100 / 12;
  const n = years * 12;
  return principal * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
}

function classifyROI(roi: number): 'good' | 'ok' | 'low' {
  if (roi >= 6) return 'good';
  if (roi >= 3) return 'ok';
  return 'low';
}

function calculate() {
  const price      = getNum('price',      3000);
  const down       = getNum('down',        600);
  const expenses   = getNum('expenses',    120);
  const rent       = getNum('rent',         12);
  const vacancy    = getNum('vacancy',      10);
  const fixedCosts = getNum('fixedCosts',    0);
  const mgmtRate   = getNum('mgmtRate',      5);
  const repair     = getNum('repair',        6);
  const other      = getNum('other',         0);
  const loanRate   = getNum('loanRate',    1.5);
  const loanYears  = getNum('loanYears',    35);

  // バリデーション
  const errEl = document.getElementById('errorMsg');
  if (price <= 0 || rent <= 0) {
    if (errEl) { errEl.textContent = '物件価格と月額家賃は1以上の値を入力してください。'; errEl.hidden = false; }
    return;
  }
  if (errEl) errEl.hidden = true;

  const loanPrincipal  = Math.max(0, price - down);
  const annualRent     = rent * 12;
  const effectiveRent  = annualRent * (1 - vacancy / 100);
  const mgmtCost       = effectiveRent * (mgmtRate / 100);
  const otherCosts     = fixedCosts + repair + other;
  const totalCost      = mgmtCost + otherCosts;
  const noi            = effectiveRent - totalCost;
  const monthlyLoan    = pmt(loanPrincipal, loanRate, loanYears);
  const annualLoan     = monthlyLoan * 12;
  const cashflow       = noi - annualLoan;
  const ownCapital     = down + expenses;
  const roi            = ownCapital > 0 ? (cashflow / ownCapital) * 100 : 0;

  // ROI ボックス
  const roiBox = document.getElementById('roiBox');
  const roiBar = document.getElementById('roiBar') as HTMLElement | null;
  const cls = classifyROI(roi);
  if (roiBox) { roiBox.classList.remove('good', 'ok', 'low'); roiBox.classList.add(cls); }
  if (roiBar) roiBar.style.width = clamp(roi / 12 * 100, 0, 100) + '%';
  setText('roiValue', roi.toFixed(2) + '%');
  setText('roiNote', roi >= 6 ? '高ROI' : roi >= 3 ? '良好' : roi >= 0 ? 'やや低め' : 'マイナス');

  // キャッシュフロー ボックス
  const cfBox = document.getElementById('cashflowBox');
  if (cfBox) {
    cfBox.classList.remove('good', 'ok', 'low');
    cfBox.classList.add(cashflow > 0 ? 'good' : 'low');
  }
  setText('cashflowValue', fmt(cashflow, 1) + '万円');
  setText('cashflowNote', cashflow > 0 ? '毎年プラス収支' : cashflow === 0 ? '収支トントン' : '毎年マイナス収支');

  // テーブル
  setText('rAnnualRent',   fmt(annualRent,    2) + ' 万円');
  setText('rEffectiveRent',fmt(effectiveRent, 2) + ' 万円');
  setText('rMgmt',         fmt(mgmtCost,      2) + ' 万円');
  setText('rOtherCosts',   fmt(otherCosts,    2) + ' 万円');
  setText('rTotalCost',    fmt(totalCost,     2) + ' 万円');
  setText('rNOI',          fmt(noi,           2) + ' 万円');
  setText('rLoanPrincipal',fmt(loanPrincipal,  0) + ' 万円');
  setText('rMonthlyLoan',  fmt(monthlyLoan,   2) + ' 万円');
  setText('rAnnualLoan',   fmt(annualLoan,    2) + ' 万円');
  setText('rOwnCapital',   fmt(ownCapital,     0) + ' 万円');
  setText('rCashflow',     fmt(cashflow,      2) + ' 万円');
  setText('rROI',          roi.toFixed(2) + '%');
}

/* ─── サンプルバッジ ─────────────────────────────────── */

function hideSampleBadge() {
  const badge = document.getElementById('sampleBadge');
  if (badge) badge.hidden = true;
}

/* ─── スライダー ↔ 数値入力 の同期 ─────────────────── */

function syncSliderToNum(slider: HTMLInputElement) {
  const targetId = slider.dataset.target;
  if (!targetId) return;
  const numEl = document.getElementById(targetId) as HTMLInputElement | null;
  if (!numEl) return;

  numEl.value = slider.value;
  updateFill(slider);
  updateDisplay(targetId, slider.value);
}

function syncNumToSlider(numEl: HTMLInputElement) {
  const slider = document.querySelector<HTMLInputElement>(
    `input.range-slider[data-target="${numEl.id}"]`
  );
  if (!slider) return;

  const min  = parseFloat(slider.min)  || 0;
  const max  = parseFloat(slider.max)  || 100;
  const step = parseFloat(slider.step) || 1;
  let val = parseFloat(numEl.value);

  // 負の値・範囲外を防止
  if (isNaN(val) || val < min) val = min;
  if (val > max)                val = max;
  // ステップに丸める
  val = Math.round(val / step) * step;

  numEl.value   = String(val);
  slider.value  = String(val);
  updateFill(slider);
  updateDisplay(numEl.id, numEl.value);
}

/** 頭金スライダーの max を物件価格に合わせて更新 */
function updateDownMax() {
  const price     = getNum('price', 3000);
  const downSlider = document.querySelector<HTMLInputElement>('input.range-slider[data-target="down"]');
  const downNum    = document.getElementById('down') as HTMLInputElement | null;
  if (!downSlider || !downNum) return;

  const newMax = price;
  downSlider.max = String(newMax);
  downNum.max    = String(newMax);

  const curDown = getNum('down', 0);
  if (curDown > newMax) {
    downSlider.value = String(newMax);
    downNum.value    = String(newMax);
    updateDisplay('down', String(newMax));
  }
  updateFill(downSlider);
}

/* ─── 初期化 ─────────────────────────────────────────── */

document.addEventListener('DOMContentLoaded', () => {

  // 全スライダーの初期塗り設定
  document.querySelectorAll<HTMLInputElement>('input.range-slider').forEach(slider => {
    updateFill(slider);

    slider.addEventListener('input', () => {
      syncSliderToNum(slider);
      if (slider.dataset.target === 'price') updateDownMax();
      hideSampleBadge();
      calculate();
    });
  });

  // 数値入力の同期・バリデーション
  document.querySelectorAll<HTMLInputElement>('input.field-input').forEach(numEl => {
    // マイナス記号・e記号の入力を禁止
    numEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === '-' || e.key === 'e' || e.key === 'E' || e.key === '+') {
        e.preventDefault();
      }
    });

    numEl.addEventListener('change', () => {
      syncNumToSlider(numEl);
      if (numEl.id === 'price') updateDownMax();
      hideSampleBadge();
      calculate();
    });
  });

  calculate(); // 初期計算（サンプル値）
});
</script>
