---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '家賃下落・空室率影響シミュレーター',
  url: 'https://estate.kuras-plus.com/calculators/rent-vacancy-impact',
  description: '家賃下落率・空室率の上昇が不動産投資の利回り・収益にどう影響するか即シミュレーション。感度分析マトリクスで2軸のリスクを視覚的に把握できる無料ツール。',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '家賃が下がると利回りはどれくらい下がりますか？',
      acceptedAnswer: { '@type': 'Answer', text: '例えば月額10万円・物件価格3,000万円・年間費用25万円の場合、家賃が10%下落すると実質利回りは約2.97%から2.41%へ0.56ポイント低下します。家賃下落率が大きいほど収益への影響は加速度的に大きくなります。' },
    },
    {
      '@type': 'Question',
      name: '空室率が上がると年間収益はどう変わりますか？',
      acceptedAnswer: { '@type': 'Answer', text: '空室率10%上昇（例：5%→15%）で年間収入は約10%減少します。月額10万円の物件なら年間約12万円の収入減です。固定費は変わらないため、収益への影響は収入の減少よりさらに大きくなります。' },
    },
    {
      '@type': 'Question',
      name: '表面利回りと実質利回りはなぜ違うのですか？',
      acceptedAnswer: { '@type': 'Answer', text: '表面利回りは満室時の年間家賃収入を物件価格で割った理想値です。実質利回りは空室損失・管理費・修繕費・固定資産税などを差し引いた実態に近い値です。表面利回りより実質利回りが2〜3ポイント低いことがよくあります。' },
    },
    {
      '@type': 'Question',
      name: '不動産投資ではどれくらいの空室率を見込むべきですか？',
      acceptedAnswer: { '@type': 'Answer', text: '一般的に都市部で5〜10%、地方で10〜20%程度を見込むことが多いです。ただし築年数・立地・管理状況によって大きく異なります。ベースケースで10%、ワーストケースで15〜20%をシミュレーションしておくことをおすすめします。' },
    },
    {
      '@type': 'Question',
      name: '家賃下落と空室率ではどちらの影響が大きいですか？',
      acceptedAnswer: { '@type': 'Answer', text: '物件・状況によりますが、長期的には家賃下落の影響のほうが大きくなる傾向があります。空室は改善できる可能性がありますが、地域の家賃相場の下落は構造的なため、一度下がると回復しにくいためです。' },
    },
    {
      '@type': 'Question',
      name: 'シミュレーション結果は実際の投資判断にどう使えばよいですか？',
      acceptedAnswer: { '@type': 'Answer', text: 'ベースケース（想定どおり）とワーストケース（家賃-15%・空室15%）の2つをシミュレーションし、ワーストケースでもキャッシュフローがプラスかどうかを確認することがポイントです。ワーストケースでも赤字にならない物件を選ぶことがリスク管理の基本です。' },
    },
  ],
};
---

<BaseLayout
  title="家賃下落・空室率影響シミュレーター | 不動産投資リスクを即試算"
  description="家賃下落率・空室率の上昇が不動産投資の実質利回りとキャッシュフローにどう影響するかをリアルタイムでシミュレーション。感度分析マトリクスで2軸のリスクを一目で把握できる無料ツールです。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/rent-vacancy-impact" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>家賃下落・空室率影響シミュレーター</span>
      </nav>
      <p class="hero-eyebrow">Rent Decline &amp; Vacancy Impact Simulator</p>
      <h1 class="hero-title">家賃下落・空室率影響シミュレーター</h1>
      <p class="hero-desc">
        家賃下落と空室率の上昇が収益・利回りにどう効くかをリアルタイム試算。<br />
        感度分析マトリクスでリスクを2軸で見える化します。
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <div class="container mt-48">
    <div class="calc-layout">

      <!-- ── Inputs ── -->
      <section class="card" aria-label="入力フォーム">
        <h2 class="card-heading">物件・費用条件を入力</h2>

        <p class="group-label">基本条件</p>

        <!-- 物件価格 -->
        <div class="field-group">
          <div class="field-label">
            <label for="propertyPrice">物件価格</label>
            <span class="field-display"><span id="propertyPriceDisplay">3,000</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="propertyPriceSlider"
            data-target="propertyPrice" value="3000" min="500" max="20000" step="100" />
          <input class="field-input" type="number" id="propertyPrice"
            value="3000" min="100" max="999999" step="100" inputmode="numeric" />
        </div>

        <!-- 月額家賃 -->
        <div class="field-group">
          <div class="field-label">
            <label for="currentRent">現在の月額家賃</label>
            <span class="field-display"><span id="currentRentDisplay">10</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="currentRentSlider"
            data-target="currentRent" value="10" min="1" max="100" step="0.5" />
          <input class="field-input" type="number" id="currentRent"
            value="10" min="0.1" max="9999" step="0.5" inputmode="decimal" />
        </div>

        <!-- 現在空室率 -->
        <div class="field-group">
          <div class="field-label">
            <label for="currentVacancy">現在の空室率</label>
            <span class="field-display"><span id="currentVacancyDisplay">5</span> %</span>
          </div>
          <input class="range-slider" type="range" id="currentVacancySlider"
            data-target="currentVacancy" value="5" min="0" max="50" step="1" />
          <input class="field-input" type="number" id="currentVacancy"
            value="5" min="0" max="100" step="1" inputmode="numeric" />
          <p class="field-hint">都市部: 5〜10%、地方: 10〜20% が目安です。</p>
        </div>

        <hr class="divider" />
        <p class="group-label">年間費用</p>

        <!-- 管理費 -->
        <div class="field-group">
          <div class="field-label">
            <label for="expMgmt">管理費（年間）</label>
            <span class="field-display"><span id="expMgmtDisplay">6</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="expMgmtSlider"
            data-target="expMgmt" value="6" min="0" max="100" step="1" />
          <input class="field-input" type="number" id="expMgmt"
            value="6" min="0" max="9999" step="1" inputmode="numeric" />
          <p class="field-hint">管理委託費は月額家賃の5〜10%程度が一般的です。</p>
        </div>

        <!-- 修繕費 -->
        <div class="field-group">
          <div class="field-label">
            <label for="expRepair">修繕費（年間）</label>
            <span class="field-display"><span id="expRepairDisplay">6</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="expRepairSlider"
            data-target="expRepair" value="6" min="0" max="100" step="1" />
          <input class="field-input" type="number" id="expRepair"
            value="6" min="0" max="9999" step="1" inputmode="numeric" />
        </div>

        <!-- 固定資産税 -->
        <div class="field-group">
          <div class="field-label">
            <label for="expPropTax">固定資産税（年間）</label>
            <span class="field-display"><span id="expPropTaxDisplay">10</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="expPropTaxSlider"
            data-target="expPropTax" value="10" min="0" max="100" step="1" />
          <input class="field-input" type="number" id="expPropTax"
            value="10" min="0" max="9999" step="1" inputmode="numeric" />
          <p class="field-hint">
            <a href="/calculators/fixed-asset-tax" class="inline-link">固定資産税シミュレーター</a>で試算できます。
          </p>
        </div>

        <!-- その他 -->
        <div class="field-group">
          <div class="field-label">
            <label for="expOther">その他費用（年間）</label>
            <span class="field-display"><span id="expOtherDisplay">3</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="expOtherSlider"
            data-target="expOther" value="3" min="0" max="100" step="1" />
          <input class="field-input" type="number" id="expOther"
            value="3" min="0" max="9999" step="1" inputmode="numeric" />
          <p class="field-hint">火災保険・税理士費用など。</p>
        </div>

        <hr class="divider" />
        <p class="group-label">🎯 変動条件（リスクシナリオ）</p>

        <!-- 家賃下落率 -->
        <div class="field-group">
          <div class="field-label">
            <label for="rentDecline">家賃下落率</label>
            <span class="field-display decline-display"><span id="rentDeclineDisplay">10</span> %下落</span>
          </div>
          <input class="range-slider decline-slider" type="range" id="rentDeclineSlider"
            data-target="rentDecline" value="10" min="0" max="40" step="1" />
          <input class="field-input" type="number" id="rentDecline"
            value="10" min="0" max="100" step="1" inputmode="numeric" />
          <p class="field-hint" id="futureRentHint">変動後の想定月額家賃: <strong id="futureRentCalc">—</strong></p>
        </div>

        <!-- 将来空室率 -->
        <div class="field-group">
          <div class="field-label">
            <label for="futureVacancy">将来の想定空室率</label>
            <span class="field-display decline-display"><span id="futureVacancyDisplay">10</span> %</span>
          </div>
          <input class="range-slider decline-slider" type="range" id="futureVacancySlider"
            data-target="futureVacancy" value="10" min="0" max="50" step="1" />
          <input class="field-input" type="number" id="futureVacancy"
            value="10" min="0" max="100" step="1" inputmode="numeric" />
        </div>

        <hr class="divider" />
        <p class="group-label">ローン（任意）</p>

        <!-- ローン -->
        <div class="field-group">
          <div class="field-label">
            <label for="loanPayment">年間ローン返済額</label>
            <span class="field-display"><span id="loanPaymentDisplay">0</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="loanPaymentSlider"
            data-target="loanPayment" value="0" min="0" max="200" step="5" />
          <input class="field-input" type="number" id="loanPayment"
            value="0" min="0" max="9999" step="5" inputmode="numeric" />
          <p class="field-hint">
            0の場合はローンなしとして計算します。
            <a href="/calculators/mortgage" class="inline-link">ローン返済シミュレーター</a>で試算できます。
          </p>
        </div>

        <div id="errorMsg" class="error-msg" hidden></div>
      </section>

      <!-- ── Results ── -->
      <section class="card results-card" aria-label="試算結果" aria-live="polite">
        <h2 class="card-heading">シミュレーション結果</h2>

        <div id="sampleBadge" class="sample-badge">
          <span>📋</span> サンプル値による試算例 — 値を変更すると即時更新されます
        </div>

        <!-- Hero metrics (3-up) -->
        <div class="hero-metrics-3">
          <div class="metric-box primary-box">
            <div class="metric-label">変動後 実質利回り</div>
            <div class="metric-value" id="rFutureNetYield">—</div>
          </div>
          <div class="metric-box" id="yieldDiffBox">
            <div class="metric-label">利回り変化幅</div>
            <div class="metric-value sm" id="rYieldDiff">—</div>
          </div>
          <div class="metric-box" id="profitDiffBox">
            <div class="metric-label">年間収益の変化</div>
            <div class="metric-value sm" id="rProfitDiff">—</div>
          </div>
        </div>

        <!-- Before / After comparison cards -->
        <div class="ba-wrap">
          <div class="ba-col">
            <div class="ba-head current-head">📍 現在</div>
            <div class="ba-row">
              <span class="ba-label">年間家賃収入（満室）</span>
              <span class="ba-val" id="rCurrentGross">—</span>
            </div>
            <div class="ba-row">
              <span class="ba-label">空室考慮後収入</span>
              <span class="ba-val" id="rCurrentNet">—</span>
            </div>
            <div class="ba-row">
              <span class="ba-label">年間総費用</span>
              <span class="ba-val cost-val" id="rExpenses">—</span>
            </div>
            <div class="ba-row ba-total">
              <span class="ba-label">営業利益</span>
              <span class="ba-val" id="rCurrentProfit">—</span>
            </div>
            <div class="ba-row" id="cfCurrentRow">
              <span class="ba-label">手残り（ローン後）</span>
              <span class="ba-val" id="rCurrentCF">—</span>
            </div>
            <div class="ba-divider"></div>
            <div class="ba-row yield-row">
              <span class="ba-label">表面利回り</span>
              <span class="ba-val yield-val" id="rCurrentGrossYield">—</span>
            </div>
            <div class="ba-row yield-row ba-primary">
              <span class="ba-label">実質利回り</span>
              <span class="ba-val primary-val" id="rCurrentNetYield">—</span>
            </div>
          </div>

          <div class="ba-arrow" aria-hidden="true">→</div>

          <div class="ba-col future-col">
            <div class="ba-head future-head">🎯 変動後</div>
            <div class="ba-row">
              <span class="ba-label">年間家賃収入（満室）</span>
              <span class="ba-val" id="rFutureGross">—</span>
            </div>
            <div class="ba-row">
              <span class="ba-label">空室考慮後収入</span>
              <span class="ba-val" id="rFutureNet">—</span>
            </div>
            <div class="ba-row">
              <span class="ba-label">年間総費用</span>
              <span class="ba-val cost-val" id="rFutureExpenses">—</span>
            </div>
            <div class="ba-row ba-total">
              <span class="ba-label">営業利益</span>
              <span class="ba-val" id="rFutureProfit">—</span>
            </div>
            <div class="ba-row" id="cfFutureRow">
              <span class="ba-label">手残り（ローン後）</span>
              <span class="ba-val" id="rFutureCF">—</span>
            </div>
            <div class="ba-divider"></div>
            <div class="ba-row yield-row">
              <span class="ba-label">表面利回り</span>
              <span class="ba-val yield-val" id="rFutureGrossYield">—</span>
            </div>
            <div class="ba-row yield-row ba-primary">
              <span class="ba-label">実質利回り</span>
              <span class="ba-val primary-val" id="rFutureNetYield2">—</span>
            </div>
          </div>
        </div>

        <!-- Visual bar chart -->
        <div class="bar-section">
          <div class="bar-title">年間収入の比較</div>
          <div class="bar-row">
            <span class="bar-name">現在収入</span>
            <div class="bar-track">
              <div class="bar-fill bar-current" id="barCurrent"></div>
            </div>
            <span class="bar-val-label" id="barCurrentLabel">—</span>
          </div>
          <div class="bar-row">
            <span class="bar-name">変動後収入</span>
            <div class="bar-track">
              <div class="bar-fill bar-future" id="barFuture"></div>
            </div>
            <span class="bar-val-label" id="barFutureLabel">—</span>
          </div>
        </div>

        <!-- Impact summary -->
        <div class="impact-card" id="impactCard">
          <div class="impact-title">📊 影響サマリー</div>
          <p id="impactText" class="impact-text"></p>
        </div>

        <p class="result-disclaimer">
          ※ 本試算は概算です。実際の収益は税制・管理状況・市場動向により異なります。
          投資判断はご自身の責任において行ってください。
        </p>
      </section>
    </div>

    <!-- ── Sensitivity Matrix ── -->
    <section class="matrix-section mt-48">
      <h2 class="section-title">感度分析マトリクス</h2>
      <p class="section-sub">家賃下落率 × 空室率の組み合わせによる実質利回りの変化。現在の入力値に近いセルを強調表示しています。</p>
      <div class="matrix-legend">
        <span class="legend-item"><span class="legend-dot good"></span> 4%以上（良好）</span>
        <span class="legend-item"><span class="legend-dot ok"></span> 2〜4%（許容範囲）</span>
        <span class="legend-item"><span class="legend-dot warn"></span> 0〜2%（要注意）</span>
        <span class="legend-item"><span class="legend-dot bad"></span> 0%未満（赤字）</span>
      </div>
      <div class="matrix-wrap">
        <table class="matrix-table" id="sensitivityMatrix" aria-label="感度分析マトリクス">
          <thead>
            <tr>
              <th class="mx-corner">下落率↓ / 空室率→</th>
              <th class="mx-head">空室 0%</th>
              <th class="mx-head">空室 5%</th>
              <th class="mx-head">空室 10%</th>
              <th class="mx-head">空室 15%</th>
              <th class="mx-head">空室 20%</th>
            </tr>
          </thead>
          <tbody id="matrixBody">
            <tr><td colspan="6" class="mx-loading">計算中...</td></tr>
          </tbody>
        </table>
      </div>
      <p class="matrix-note">※ 強調表示（太枠）は現在の変動条件に最も近いセルです。</p>
    </section>

    <!-- ── Related tools ── -->
    <section class="related-section mt-48">
      <h2 class="section-title">関連ツール</h2>
      <p class="section-sub">リスクシナリオを確認したら、他のツールと組み合わせて総合的な投資判断を行いましょう。</p>
      <div class="related-grid">
        <a href="/calculators/yield" class="related-card">
          <div class="related-icon">📊</div>
          <div class="related-title">不動産利回り計算ツール</div>
          <p class="related-desc">現在の表面・実質利回りを詳細に計算する</p>
          <span class="related-arrow">使ってみる →</span>
        </a>
        <a href="/calculators/roi" class="related-card">
          <div class="related-icon">💹</div>
          <div class="related-title">不動産投資ROI計算ツール</div>
          <p class="related-desc">自己資金ベースのROI・キャッシュフローを計算する</p>
          <span class="related-arrow">使ってみる →</span>
        </a>
        <a href="/calculators/mortgage" class="related-card">
          <div class="related-icon">🏦</div>
          <div class="related-title">住宅ローン返済シミュレーター</div>
          <p class="related-desc">ローン返済額を確認して手残り収益を試算する</p>
          <span class="related-arrow">使ってみる →</span>
        </a>
        <a href="/calculators/fixed-asset-tax" class="related-card">
          <div class="related-icon">🏛️</div>
          <div class="related-title">固定資産税シミュレーター</div>
          <p class="related-desc">年間費用の固定資産税を事前に試算する</p>
          <span class="related-arrow">使ってみる →</span>
        </a>
      </div>
    </section>

    <!-- ── Explanation ── -->
    <section class="explain mt-48">
      <h2 class="section-title">家賃下落・空室率リスクの基礎知識</h2>
      <div class="explain-grid">

        <div class="explain-card">
          <h3>📉 家賃下落・空室率影響シミュレーターとは</h3>
          <p>
            現在の家賃・空室率・費用条件を入力することで、家賃下落や空室率の上昇が
            年間収益・実質利回り・キャッシュフローにどう影響するかを確認できるツールです。
            「利回りが良く見える物件でも、家賃下落が起きると収益がどう変わるか」を
            投資判断前に体感するためのリスク感度分析ツールです。
          </p>
        </div>

        <div class="explain-card">
          <h3>📊 家賃下落が利回りに与える影響</h3>
          <p>
            家賃が下落すると年間収入が直接減少し、利回りも同じ割合で下がります。
            例えば家賃10%下落は表面利回りが10%低下することを意味します。
            しかし固定費は変わらないため、<strong>実質利回りへの影響はより大きく</strong>なります。
            利回り3%の物件で家賃10%下落すると、実質利回りが0%近くまで下がることがあります。
          </p>
        </div>

        <div class="explain-card">
          <h3>🏚️ 空室率がキャッシュフローに与える影響</h3>
          <p>
            空室率が上がると実際の収入が減りますが、管理費・修繕費・固定資産税などの
            固定費は変わりません。空室率15%では年間収入が15%減少し、
            収益率は利回りの低下以上に悪化します。
            特にローンがある場合、空室による収入減がローン返済を超えると
            <strong>手出しが発生（キャッシュアウト）</strong>します。
          </p>
        </div>

        <div class="explain-card">
          <h3>🧮 表面利回りだけでは分からない理由</h3>
          <p>
            表面利回り（満室時年間家賃 ÷ 物件価格）は費用も空室も考慮していません。
            実際の投資では管理費・修繕費・固定資産税・保険料などで
            年間収入の20〜30%以上が費用になることがあります。
            表面利回り5%の物件でも、実質利回りは2〜3%になるケースが多く、
            そこから家賃下落・空室が加わるとさらに低下します。
          </p>
        </div>

        <div class="explain-card">
          <h3>⚠️ 不動産投資で想定すべきリスクの考え方</h3>
          <ul>
            <li><strong>家賃下落リスク</strong>：エリアの人口減少・築年数増加・競合物件増加</li>
            <li><strong>空室リスク</strong>：入退居サイクル・賃貸需要の変化</li>
            <li><strong>修繕リスク</strong>：設備劣化・大規模修繕の発生</li>
            <li><strong>金利上昇リスク</strong>：変動金利の場合、ローン返済額が増加</li>
            <li>複数のリスクが同時に発生することも想定する必要があります</li>
          </ul>
        </div>

        <div class="explain-card">
          <h3>📋 ベースケースとワーストケースを比較する重要性</h3>
          <p>
            投資判断では楽観シナリオだけでなく、<strong>ワーストケースでも収益が成立するか</strong>を
            確認することが重要です。目安として：
            ベースケース（家賃-5%・空室10%）で実質利回りがプラスか、
            ワーストケース（家賃-15%・空室15%）でも手出しが許容範囲内か、
            を確認することをおすすめします。
          </p>
        </div>

        <div class="explain-card">
          <h3>💡 シミュレーション結果をどう活用するか</h3>
          <p>
            本ツールの感度分析マトリクスで「どの家賃下落率・空室率の組み合わせが
            損益分岐点になるか」を確認してください。
            その分岐点より現実が悪化する可能性が低ければ投資候補として検討できます。
            また、<a href="/calculators/roi" class="inline-link">ROI計算ツール</a>と組み合わせて
            自己資金に対するリターンも確認することをおすすめします。
          </p>
        </div>

        <div class="explain-card">
