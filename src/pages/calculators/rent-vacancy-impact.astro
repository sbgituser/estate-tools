.faq-section { max-width: 760px; }
.faq-list { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
.faq-item {
  background: var(--c-bg-card);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--c-primary);
  cursor: pointer;
  list-style: none;
  gap: 12px;
}
.faq-q::-webkit-details-marker { display: none; }
.faq-q::after { content: '＋'; font-size: 1.1rem; color: var(--c-primary); flex-shrink: 0; transition: transform 0.2s; }
.faq-item[open] .faq-q::after { transform: rotate(45deg); }
.faq-a {
  padding: 0 18px 16px;
  font-size: 0.82rem;
  color: var(--c-text-muted);
  line-height: 1.8;
}
.faq-a p + p { margin-top: 8px; }
</style>

<script>
/* ─── Helpers ─── */
function fmt(v: number, d = 1): string {
  return v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d });
}
function getNum(id: string, fb = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fb;
  const v = parseFloat(el.value);
  return isNaN(v) ? fb : v;
}
function setText(id: string, t: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = t;
}
function clamp(v: number, a: number, b: number): number {
  return Math.max(a, Math.min(b, v));
}
function updateFill(s: HTMLInputElement) {
  const mn = parseFloat(s.min) || 0, mx = parseFloat(s.max) || 100, v = parseFloat(s.value) || 0;
  s.style.setProperty('--pct', `${clamp((v - mn) / (mx - mn) * 100, 0, 100)}%`);
}
function updateDisplay(id: string, raw: string) {
  const el = document.getElementById(`${id}Display`);
  if (el) el.textContent = Number(raw).toLocaleString('ja-JP');
}
function hideSampleBadge() {
  const b = document.getElementById('sampleBadge');
  if (b) b.hidden = true;
}
function setColor(id: string, val: number, positiveIsGood = true) {
  const el = document.getElementById(id);
  if (!el) return;
  const good = positiveIsGood ? val >= 0 : val <= 0;
  el.style.color = val === 0 ? '' : good ? 'var(--c-success)' : 'var(--c-danger)';
}

/* ─── Sensitivity matrix ─── */
const RD_STEPS = [0, 5, 10, 15, 20];
const V_STEPS  = [0, 5, 10, 15, 20];

function buildMatrix(rent: number, expenses: number, price: number, activeRD: number, activeV: number) {
  let html = '';
  for (const rd of RD_STEPS) {
    html += `<tr><th class="mx-row-head">下落 ${rd}%</th>`;
    for (const v of V_STEPS) {
      const fRent   = rent * (1 - rd / 100);
      const netInc  = fRent * 12 * (1 - v / 100);
      const profit  = netInc - expenses;
      const ny      = price > 0 ? (profit / price) * 100 : 0;
      // Find nearest step to active values
      const nearRD  = RD_STEPS.reduce((a, b) => Math.abs(b - activeRD) < Math.abs(a - activeRD) ? b : a);
      const nearV   = V_STEPS.reduce((a, b)  => Math.abs(b - activeV)  < Math.abs(a - activeV)  ? b : a);
      const isCurrent = rd === nearRD && v === nearV;
      let cls = 'mx-cell';
      if (ny >= 4)      cls += ' mx-good';
      else if (ny >= 2) cls += ' mx-ok';
      else if (ny >= 0) cls += ' mx-warn';
      else              cls += ' mx-bad';
      if (isCurrent)    cls += ' mx-current';
      html += `<td class="${cls}">${ny.toFixed(1)}%</td>`;
    }
    html += '</tr>';
  }
  const tbody = document.getElementById('matrixBody');
  if (tbody) tbody.innerHTML = html;
}

/* ─── Main calculation ─── */
function calculate() {
  const propertyPrice  = getNum('propertyPrice', 3000);
  const currentRent    = getNum('currentRent', 10);
  const currentVacancy = getNum('currentVacancy', 5);
  const expMgmt        = getNum('expMgmt', 6);
  const expRepair      = getNum('expRepair', 6);
  const expPropTax     = getNum('expPropTax', 10);
  const expOther       = getNum('expOther', 3);
  const rentDecline    = getNum('rentDecline', 10);
  const futureVacancy  = getNum('futureVacancy', 10);
  const loanPayment    = getNum('loanPayment', 0);

  const errEl = document.getElementById('errorMsg');
  if (propertyPrice <= 0 || currentRent <= 0) {
    if (errEl) { errEl.textContent = '物件価格と月額家賃は1以上で入力してください。'; errEl.hidden = false; }
    return;
  }
  if (errEl) errEl.hidden = true;

  const totalExpenses = expMgmt + expRepair + expPropTax + expOther;

  /* ── Current ── */
  const currentGross    = currentRent * 12;
  const currentNet      = currentGross * (1 - currentVacancy / 100);
  const currentProfit   = currentNet - totalExpenses;
  const currentCF       = currentProfit - loanPayment;
  const currentGrossYld = propertyPrice > 0 ? (currentGross / propertyPrice) * 100 : 0;
  const currentNetYld   = propertyPrice > 0 ? (currentProfit / propertyPrice) * 100 : 0;

  /* ── Future ── */
  const futureRent      = currentRent * (1 - rentDecline / 100);
  const futureGross     = futureRent * 12;
  const futureNet       = futureGross * (1 - futureVacancy / 100);
  const futureProfit    = futureNet - totalExpenses;
  const futureCF        = futureProfit - loanPayment;
  const futureGrossYld  = propertyPrice > 0 ? (futureGross / propertyPrice) * 100 : 0;
  const futureNetYld    = propertyPrice > 0 ? (futureProfit / propertyPrice) * 100 : 0;

  /* ── Diffs ── */
  const profitDiff = futureProfit - currentProfit;
  const yieldDiff  = futureNetYld - currentNetYld;

  /* ── Update future rent hint ── */
  setText('futureRentCalc', `${fmt(futureRent, 1)} 万円/月`);

  /* ── Hero metrics ── */
  setText('rFutureNetYield', `${fmt(futureNetYld, 2)}%`);

  const yieldDiffEl = document.getElementById('rYieldDiff');
  if (yieldDiffEl) {
    yieldDiffEl.textContent = `${yieldDiff >= 0 ? '▲' : '▼'} ${fmt(Math.abs(yieldDiff), 2)}pt`;
    yieldDiffEl.style.color = yieldDiff >= 0 ? 'var(--c-success)' : 'var(--c-danger)';
  }
  const profitDiffEl = document.getElementById('rProfitDiff');
  if (profitDiffEl) {
    profitDiffEl.textContent = `${profitDiff >= 0 ? '▲' : '▼'} ${fmt(Math.abs(profitDiff), 1)}万円/年`;
    profitDiffEl.style.color = profitDiff >= 0 ? 'var(--c-success)' : 'var(--c-danger)';
  }

  /* ── Before/After comparison ── */
  setText('rCurrentGross',     `${fmt(currentGross, 1)} 万円`);
  setText('rCurrentNet',       `${fmt(currentNet, 1)} 万円`);
  setText('rExpenses',         `${fmt(totalExpenses, 0)} 万円/年`);
  const currentProfitEl = document.getElementById('rCurrentProfit');
  if (currentProfitEl) {
    currentProfitEl.textContent = `${fmt(currentProfit, 1)} 万円`;
    currentProfitEl.style.color = currentProfit >= 0 ? 'var(--c-primary)' : 'var(--c-danger)';
  }
  setText('rFutureGross',      `${fmt(futureGross, 1)} 万円`);
  setText('rFutureNet',        `${fmt(futureNet, 1)} 万円`);
  setText('rFutureExpenses',   `${fmt(totalExpenses, 0)} 万円/年`);
  const futureProfitEl = document.getElementById('rFutureProfit');
  if (futureProfitEl) {
    futureProfitEl.textContent = `${fmt(futureProfit, 1)} 万円`;
    futureProfitEl.style.color = futureProfit >= 0 ? 'var(--c-primary)' : 'var(--c-danger)';
  }

  // Loan CF rows
  const hasLoan = loanPayment > 0;
  const cfCurrentRow = document.getElementById('cfCurrentRow');
  const cfFutureRow  = document.getElementById('cfFutureRow');
  if (cfCurrentRow) cfCurrentRow.hidden = !hasLoan;
  if (cfFutureRow)  cfFutureRow.hidden  = !hasLoan;
  if (hasLoan) {
    const cfCEl = document.getElementById('rCurrentCF');
    if (cfCEl) { cfCEl.textContent = `${fmt(currentCF, 1)} 万円`; cfCEl.style.color = currentCF >= 0 ? 'var(--c-success)' : 'var(--c-danger)'; }
    const cfFEl = document.getElementById('rFutureCF');
    if (cfFEl) { cfFEl.textContent = `${fmt(futureCF, 1)} 万円`; cfFEl.style.color = futureCF >= 0 ? 'var(--c-success)' : 'var(--c-danger)'; }
  }

  // Yields
  setText('rCurrentGrossYield', `${fmt(currentGrossYld, 2)}%`);
  setText('rCurrentNetYield',   `${fmt(currentNetYld, 2)}%`);
  setText('rFutureGrossYield',  `${fmt(futureGrossYld, 2)}%`);
  setText('rFutureNetYield2',   `${fmt(futureNetYld, 2)}%`);

  /* ── Bar chart ── */
  const maxIncome = Math.max(currentNet, futureNet, 0.01);
  const barCurrent = document.getElementById('barCurrent') as HTMLElement | null;
  const barFuture  = document.getElementById('barFuture')  as HTMLElement | null;
  if (barCurrent) barCurrent.style.width = `${(currentNet / maxIncome * 100).toFixed(1)}%`;
  if (barFuture)  barFuture.style.width  = `${(futureNet  / maxIncome * 100).toFixed(1)}%`;
  setText('barCurrentLabel', `${fmt(currentNet, 1)} 万円`);
  setText('barFutureLabel',  `${fmt(futureNet, 1)} 万円`);

  /* ── Impact summary ── */
  const impactCard = document.getElementById('impactCard');
  const impactText = document.getElementById('impactText');
  if (impactText && impactCard) {
    const absProfit = Math.abs(profitDiff);
    const baseStr   = `家賃${rentDecline}%下落・空室率${futureVacancy}%の条件で、年間営業利益は ${fmt(absProfit, 1)} 万円 ${profitDiff >= 0 ? '増加' : '減少'} します（${fmt(currentProfit, 1)} 万円 → ${fmt(futureProfit, 1)} 万円）。実質利回りは ${fmt(currentNetYld, 2)}% → ${fmt(futureNetYld, 2)}%（${fmt(Math.abs(yieldDiff), 2)}ポイント${yieldDiff >= 0 ? '上昇' : '下落'}）です。`;
    impactText.textContent = baseStr + (futureProfit < 0 ? '　⚠️ 変動後は赤字（年間費用を収入が下回る状態）です。損益分岐点を確認してください。' : '');
    impactCard.className = 'impact-card' + (futureProfit < 0 ? ' impact-danger' : yieldDiff < -1 ? ' impact-warn' : '');
    const titleEl = impactCard.querySelector('.impact-title') as HTMLElement | null;
    if (titleEl) titleEl.textContent = futureProfit < 0 ? '⚠️ 影響サマリー（赤字転落）' : yieldDiff < -1 ? '⚠️ 影響サマリー（要注意）' : '📊 影響サマリー';
  }

  /* ── Sensitivity matrix ── */
  buildMatrix(currentRent, totalExpenses, propertyPrice, rentDecline, futureVacancy);
}

/* ─── Slider sync ─── */
function syncSliderToNum(slider: HTMLInputElement) {
  const targetId = slider.dataset.target;
  if (!targetId) return;
  const numEl = document.getElementById(targetId) as HTMLInputElement | null;
  if (!numEl) return;
  numEl.value = slider.value;
  updateFill(slider);
  updateDisplay(targetId, slider.value);
}
function syncNumToSlider(numEl: HTMLInputElement) {
  const slider = document.querySelector<HTMLInputElement>(`input.range-slider[data-target="${numEl.id}"]`);
  if (!slider) return;
  const mx = parseFloat(slider.max) || 100;
  let v = parseFloat(numEl.value);
  if (isNaN(v) || v < 0) v = 0;
  slider.value = String(Math.min(v, mx));
  updateFill(slider);
  updateDisplay(numEl.id, numEl.value);
}

/* ─── Init ─── */
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll<HTMLInputElement>('input.range-slider').forEach(slider => {
    updateFill(slider);
    slider.addEventListener('input', () => {
      syncSliderToNum(slider);
      hideSampleBadge();
      calculate();
    });
  });

  document.querySelectorAll<HTMLInputElement>('input.field-input').forEach(numEl => {
    numEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['-', 'e', 'E', '+'].includes(e.key)) e.preventDefault();
    });
    numEl.addEventListener('change', () => {
      syncNumToSlider(numEl);
      hideSampleBadge();
      calculate();
    });
  });

  calculate();
});
</script>
