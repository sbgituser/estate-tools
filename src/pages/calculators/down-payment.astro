---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';

const relatedArticles = [
  {
    href: '/articles/how-much-down-payment',
    tag: '頭金',
    title: '不動産投資の頭金はいくら必要？｜物件価格別の目安',
    desc: '物件価格帯別の頭金シミュレーションと準備の考え方',
  },
  {
    href: '/articles/real-estate-investment-basics',
    tag: '基礎知識',
    title: '不動産投資の基礎知識｜利回り・ROI・CFで何を見ればよいか',
    desc: '投資判断に必要な3指標の違いと使い方を初心者向けに解説',
  },
  {
    href: '/articles/cashflow-basics',
    tag: 'CF',
    title: '不動産投資のキャッシュフローとは｜計算方法と目安を解説',
    desc: 'ローン返済後の実態収支「手残り」の考え方を分かりやすく解説',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '頭金シミュレーター',
    url: 'https://estate.kuras-plus.com/calculators/down-payment',
    description: '住宅ローンの頭金を変えた場合の毎月返済額・総利息を比較できる無料シミュレーターです。',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: '頭金シミュレーター｜住宅ローンの頭金を変えると返済額・総利息はどう変わる？',
    url: 'https://estate.kuras-plus.com/calculators/down-payment',
    description: '住宅ローンの頭金を変えた場合の毎月返済額・総返済額・総利息を比較計算。頭金0〜20%の4シナリオを一覧表示できる無料シミュレーターです。',
    author: { '@type': 'Organization', name: '不動産ツールズ | kuras-plus' },
    publisher: {
      '@type': 'Organization',
      name: '不動産ツールズ | kuras-plus',
      url: 'https://estate.kuras-plus.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://estate.kuras-plus.com' },
      { '@type': 'ListItem', position: 2, name: '頭金シミュレーター', item: 'https://estate.kuras-plus.com/calculators/down-payment' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '頭金はいくら必要ですか？',
        acceptedAnswer: { '@type': 'Answer', text: '一般的に物件価格の10〜20%が目安です。フラット35では頭金10%以上で金利優遇があります。諸費用（物件価格の3〜7%）は別途現金で用意する必要があります。' },
      },
      {
        '@type': 'Question',
        name: '頭金なしで住宅ローンは組めますか？',
        acceptedAnswer: { '@type': 'Answer', text: 'フルローン（頭金0円）でも住宅ローンを組める金融機関はあります。ただし総返済額・総利息が増えるほか、諸費用は別途現金で用意が必要な場合が多いです。' },
      },
      {
        '@type': 'Question',
        name: '頭金を入れると利息はどれくらい減りますか？',
        acceptedAnswer: { '@type': 'Answer', text: '金利1.5%・35年返済の場合、頭金100万円につき総利息はおよそ23〜26万円減少します。頭金500万円なら約120〜130万円の利息削減効果があります。' },
      },
      {
        '@type': 'Question',
        name: '住宅ローンの頭金平均はいくらですか？',
        acceptedAnswer: { '@type': 'Answer', text: '国土交通省の住宅市場動向調査によると、住宅購入時の自己資金比率の平均は物件価格の20〜30%程度です。ただし30代以下では10%未満のケースも多くあります。' },
      },
      {
        '@type': 'Question',
        name: '頭金なし（フルローン）で投資用不動産を購入できますか？',
        acceptedAnswer: { '@type': 'Answer', text: '投資用不動産の場合、フルローンを受け付けない金融機関が多いです。一般的には物件価格の10〜30%の頭金が必要とされています。ただし投資実績・自己資金額・物件の評価によって審査基準が異なるため、複数の金融機関に相談することをお勧めします。' },
      },
      {
        '@type': 'Question',
        name: '頭金以外に必要な初期費用はどのくらいですか？',
        acceptedAnswer: { '@type': 'Answer', text: '購入時諸費用として物件価格の3〜10%が必要です。内訳は仲介手数料（3%程度）・登記費用・ローン事務手数料・火災保険料・不動産取得税などです。中古物件は新築より諸費用が高くなる傾向があります。諸費用はローンに組み込むことも可能な場合があります。' },
      },
    ],
  },
];
---

<BaseLayout
  title="頭金シミュレーター｜住宅ローンの頭金を変えると返済額・総利息はどう変わる？"
  description="住宅ローンの頭金を変えた場合の毎月返済額・総返済額・総利息を比較計算。頭金0〜20%の4シナリオを一覧表示できる無料シミュレーターです。登録不要。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/down-payment" />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>頭金シミュレーター</span>
      </nav>
      <p class="hero-eyebrow">Down Payment Simulator</p>
      <h1 class="hero-title">頭金シミュレーター</h1>
      <p class="hero-desc">
        頭金を変えた場合の毎月返済額・総利息を瞬時に比較。<br />
        「頭金はいくら入れるべき？」を数字で確認できます。
      </p>
    </div>
  </section>

  <!-- Article Body -->
  <div class="article-outer">
    <div class="container article-container">

      <!-- このページで分かること -->
      <div class="summary-box">
        <p class="summary-title">このページで分かること</p>
        <ul class="summary-list">
          <li>頭金の適正額と物件価格に対する目安</li>
          <li>頭金を多く入れるメリット・デメリット</li>
          <li>フルローンと頭金ありの月々返済額の違い</li>
          <li>自己資金をいくら残すべきかの判断基準</li>
        </ul>
      </div>

      <!-- ─── Section 1: 頭金とは ─── -->
      <section class="article-section" id="what-is-down-payment">
        <h2 class="article-h2">頭金とは何か — 不動産購入における自己資金の考え方</h2>
        <p class="article-prose">
          「頭金」とは、不動産購入時に自分で支払う自己資金のことです。
          住宅ローンを組む場合、購入価格から頭金を差し引いた額がローンの借入額になります。
        </p>
        <p class="article-prose">
          たとえば4,000万円の物件を購入する際に頭金800万円を用意すれば、ローンで借りるのは3,200万円です。
          借入額が少なければ毎月の返済額も少なくなり、支払う利息も削減できます。
        </p>
        <div class="formula-wrap">
          <div class="formula-card formula-card--main">
            <div class="formula-title">頭金の基本公式</div>
            <div class="formula-body">頭金 = 物件価格 × 頭金割合(%)</div>
            <p class="formula-note">例）4,000万円の物件で頭金20%の場合 → 4,000万円 × 20% = 800万円</p>
          </div>
        </div>
        <div class="point-box">
          <p class="point-label">まず押さえたいポイント</p>
          <ul class="point-list">
            <li>頭金が多いほど借入額が減り、毎月の返済額と利息が減少する</li>
            <li>頭金とは別に「諸費用」（物件価格の3〜7%）が必要</li>
            <li>全ての資金を頭金に充てると生活資金がなくなるリスク</li>
          </ul>
        </div>
      </section>

      <!-- ─── Section 2: 頭金の目安 ─── -->
      <section class="article-section" id="down-payment-benchmark">
        <h2 class="article-h2">頭金の目安 — 物件価格の何%が適切か</h2>
        <p class="article-prose">
          不動産購入時の頭金は、一般的に物件価格の10〜20%が目安とされています。
          以下の表は、物件価格別の頭金目安と特徴をまとめたものです。
        </p>
        <div class="table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th>頭金割合</th>
                <th>特徴・メリット</th>
                <th>注意点</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>0%</strong><br />（フルローン）</td>
                <td>手元資金を温存できる。投資に回す余裕が生まれる。</td>
                <td>金利が高くなるケースがある。審査が厳しい。総返済額が増加。</td>
              </tr>
              <tr>
                <td><strong>5〜10%</strong><br />（少額）</td>
                <td>手元資金の負担が少ない。生活費を確保しやすい。</td>
                <td>月々の返済負担が大きい。金利優遇を受けにくい。</td>
              </tr>
              <tr>
                <td><strong>10〜20%</strong><br />（一般的）</td>
                <td>金利優遇がある（フラット35）。返済負担と資金バランスが良い。</td>
                <td>一定額の貯蓄が必要。購入タイミングが限定される可能性。</td>
              </tr>
              <tr>
                <td><strong>20%以上</strong><br />（多額）</td>
                <td>月々の返済額が最小化。審査が通りやすい。利息が大幅削減。</td>
                <td>手元資金が不足する可能性。緊急時の対応が困難。</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="small-note">
          ※ 上記はあくまで参考値です。金融機関・物件種別・市況によって異なります。
        </p>
      </section>

      <!-- ─── CTA to Simulator ─── -->
      <div class="cta-banner">
        <h3>計算式と目安が分かったところで、実際の物件で試算してみましょう。</h3>
        <a href="#simulator" class="cta-btn">↓ シミュレーターで今すぐ試算する（無料）</a>
      </div>

      <!-- ─── Section 3: Simulator ─── -->
      <section class="tool-section" id="simulator">
        <h2 class="article-h2">🧮 頭金シミュレーター（無料）</h2>
        <p class="tool-section-desc">
          物件価格・金利・返済年数を入力するだけで、頭金を変えた場合の毎月返済額・総利息を瞬時に比較します。
          登録不要・完全無料でご利用いただけます。
        </p>

    </div>
  </div>

  <!-- Calculator -->
  <div class="container mt-48" style="padding-bottom: 80px;">
    <div class="calc-layout">

      <!-- ── Inputs ── -->
      <section class="card" aria-label="入力フォーム">
        <h2 class="card-heading">条件を入力</h2>

        <p class="group-label">物件情報</p>

        <!-- 物件価格 -->
        <div class="field-group">
          <div class="field-label">
            <label for="price">物件価格</label>
            <span class="field-display"><span id="priceDisplay">4,000</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="priceSlider"
            data-target="price" value="4000" min="100" max="20000" step="100" />
          <input class="field-input" type="number" id="price"
            value="4000" min="100" max="20000" step="100" inputmode="numeric"
            data-shared="shared-property-price" />
        </div>

        <!-- 頭金 -->
        <div class="field-group">
          <div class="field-label">
            <label for="down">頭金（現在の設定）</label>
            <span class="field-display"><span id="downDisplay">800</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="downSlider"
            data-target="down" value="800" min="0" max="4000" step="50" />
          <input class="field-input" type="number" id="down"
            value="800" min="0" max="4000" step="50" inputmode="numeric"
            data-shared="shared-down-payment" />
          <p class="field-hint">
            物件価格の <strong id="downPctDisplay">20.0</strong>%。
            スライダーで動かすと比較表が即時更新されます。
          </p>
        </div>

        <!-- 借入額（自動計算） -->
        <div class="borrow-display">
          <span class="borrow-label">借入額（自動計算）</span>
          <span class="borrow-value" id="borrowDisplay">3,200 万円</span>
        </div>

        <hr class="divider" />
        <p class="group-label">返済条件</p>

        <!-- 年利 -->
        <div class="field-group">
          <div class="field-label">
            <label for="rate">年利（金利）</label>
            <span class="field-display"><span id="rateDisplay">1.5</span> %</span>
          </div>
          <input class="range-slider" type="range" id="rateSlider"
            data-target="rate" value="1.5" min="0" max="10" step="0.05" />
          <input class="field-input" type="number" id="rate"
            value="1.5" min="0" max="10" step="0.05" inputmode="decimal"
            data-shared="shared-loan-rate" />
          <p class="field-hint">変動金利：0.3〜1%台 / 固定10年：1〜2%台 / フラット35：1.8〜2.5%台（目安）</p>
        </div>

        <!-- 返済年数 -->
        <div class="field-group">
          <div class="field-label">
            <label for="years">返済年数</label>
            <span class="field-display"><span id="yearsDisplay">35</span> 年</span>
          </div>
          <input class="range-slider" type="range" id="yearsSlider"
            data-target="years" value="35" min="1" max="50" step="1" />
          <input class="field-input" type="number" id="years"
            value="35" min="1" max="50" step="1" inputmode="numeric"
            data-shared="shared-loan-years" />
        </div>

        <!-- 返済方式 -->
        <div class="field-group">
          <div class="field-label-text">返済方式</div>
          <div class="repay-toggle">
            <label class="repay-option">
              <input type="radio" name="repayType" value="equal-payment" checked />
              <span>元利均等返済</span>
            </label>
            <label class="repay-option">
              <input type="radio" name="repayType" value="equal-principal" />
              <span>元金均等返済</span>
            </label>
          </div>
          <p class="field-hint">元利均等：毎月同額。元金均等：当初高く徐々に減少。</p>
        </div>

        <hr class="divider" />
        <p class="group-label">任意設定</p>

        <!-- ボーナス返済 -->
        <div class="field-group">
          <div class="field-label">
            <label for="bonus">ボーナス加算額（年2回）</label>
            <span class="field-display"><span id="bonusDisplay">0</span> 万円/回</span>
          </div>
          <input class="range-slider" type="range" id="bonusSlider"
            data-target="bonus" value="0" min="0" max="50" step="1" />
          <input class="field-input" type="number" id="bonus"
            value="0" min="0" max="50" step="1" inputmode="numeric" />
        </div>

        <!-- 管理費・修繕積立金 -->
        <div class="field-group">
          <div class="field-label">
            <label for="fee">管理費・修繕積立金（月額）</label>
            <span class="field-display"><span id="feeDisplay">0</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="feeSlider"
            data-target="fee" value="0" min="0" max="20" step="0.5" />
          <input class="field-input" type="number" id="fee"
            value="0" min="0" max="20" step="0.5" inputmode="decimal" />
          <p class="field-hint">マンション購入の場合に入力。戸建てなら0でOK。</p>
        </div>
      </section>

      <!-- ── Results ── -->
      <section class="card results-card" aria-label="計算結果" aria-live="polite">
        <h2 class="card-heading">計算結果</h2>

        <div id="sampleBadge" class="sample-badge">
          <span>📋</span> サンプル値による計算例 — 値を変更すると即時更新されます
        </div>

        <div id="errorMsg" class="error-msg" hidden></div>

        <!-- Hero metrics -->
        <div class="hero-metrics">
          <div class="metric-box primary-box">
            <div class="metric-label">毎月返済額</div>
            <div class="metric-value" id="rMonthly">—</div>
          </div>
          <div class="metric-box">
            <div class="metric-label">借入額</div>
            <div class="metric-value sm" id="rBorrow">—</div>
          </div>
        </div>

        <!-- Sub metrics -->
        <div class="sub-metrics">
          <div class="sub-metric">
            <div class="sub-label">総返済額</div>
            <div class="sub-value" id="rTotal">—</div>
          </div>
          <div class="sub-metric">
            <div class="sub-label">総利息</div>
            <div class="sub-value" id="rInterest">—</div>
          </div>
          <div class="sub-metric">
            <div class="sub-label">年間返済額</div>
            <div class="sub-value" id="rAnnual">—</div>
          </div>
          <div class="sub-metric">
            <div class="sub-label">管理費込み月支払</div>
            <div class="sub-value" id="rWithFee">—</div>
          </div>
        </div>

        <!-- Bonus row -->
        <div id="bonusRow" class="info-row" hidden>
          <span class="info-row-label">ボーナス月返済額</span>
          <span class="info-row-value" id="rBonusMonthly">—</span>
        </div>

        <!-- Diff box -->
        <div id="diffBox" class="diff-box" hidden>
          <p class="diff-title" id="diffTitle">頭金XXX万円を入れると…</p>
          <div class="diff-grid">
            <div class="diff-item">
              <span class="diff-label">月返済の節約</span>
              <span class="diff-value green" id="diffMonthly">—</span>
            </div>
            <div class="diff-item">
              <span class="diff-label">総利息の節約</span>
              <span class="diff-value green" id="diffInterest">—</span>
            </div>
          </div>
        </div>

        <!-- Comparison table -->
        <p class="section-label mt-16">頭金別シミュレーション</p>
        <div class="scenario-wrap">
          <table class="scenario-table">
            <thead>
              <tr>
                <th>頭金</th>
                <th>頭金率</th>
                <th>借入額</th>
                <th>月返済</th>
                <th>総利息</th>
                <th>月返済差額<br /><small>（頭金0比）</small></th>
              </tr>
            </thead>
            <tbody id="scenarioBody"></tbody>
          </table>
        </div>

        <!-- Charts -->
        <p class="section-label mt-16">グラフで比較</p>
        <div class="charts-wrap">
          <div class="chart-box">
            <p class="chart-title">頭金額 vs 月返済額</p>
            <svg id="chartMonthly" class="bar-chart" viewBox="0 0 280 160"
              preserveAspectRatio="xMidYMax meet"
              aria-label="頭金額と月返済額の棒グラフ"></svg>
          </div>
          <div class="chart-box">
            <p class="chart-title">頭金額 vs 総利息</p>
            <svg id="chartInterest" class="bar-chart" viewBox="0 0 280 160"
              preserveAspectRatio="xMidYMax meet"
              aria-label="頭金額と総利息の棒グラフ"></svg>
          </div>
        </div>

        <p class="result-disclaimer">
          ※ 元利均等・元金均等ともに概算です。ボーナス返済は年2回の加算として計算。
          団体信用生命保険料・諸費用・税金は含まれていません。
        </p>
      </section>
    </div>

    <!-- ── Explanation ── -->
    <section class="explain mt-48">
      <h2 class="section-title">頭金を入れるメリット</h2>
      <div class="explain-grid">
        <div class="explain-card">
          <h3>💰 月々の返済額が下がる</h3>
          <p>
            頭金を入れると借入額が減るため毎月の返済額が下がります。
            4,000万円の物件で頭金800万円（20%）を用意すると借入額は3,200万円になります。
            金利1.5%・35年返済で試算するとフルローンより月約2.4万円減少します。
          </p>
        </div>
        <div class="explain-card">
          <h3>📉 総利息が大幅に減る</h3>
          <p>
            頭金の効果は月返済額だけでなく総利息の削減にも現れます。
            頭金100万円につき（金利1.5%・35年返済）総利息を<strong>約23〜26万円</strong>減らす効果があります。
