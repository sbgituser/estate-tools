<script>
/* ─── Defaults ─── */
const D = { price: 4000, down: 800, rate: 1.5, years: 35, bonus: 0, fee: 0 };
const SCENARIO_PCTS = [0, 5, 10, 20];

/* ─── Helpers ─── */
function fmt(v: number, d = 0): string {
  return v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d });
}
function fmtYen(v: number): string {
  return Math.round(v).toLocaleString('ja-JP') + ' 円';
}
function getNum(id: string, fb = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fb;
  const v = parseFloat(el.value);
  return isNaN(v) ? fb : v;
}
function setText(id: string, t: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = t;
}
function clamp(v: number, a: number, b: number): number {
  return Math.max(a, Math.min(b, v));
}
function updateFill(s: HTMLInputElement) {
  const mn = parseFloat(s.min) || 0, mx = parseFloat(s.max) || 100, v = parseFloat(s.value) || 0;
  s.style.setProperty('--pct', `${clamp((v - mn) / (mx - mn) * 100, 0, 100)}%`);
}
function updateDisplay(id: string, val: string) {
  const el = document.getElementById(`${id}Display`);
  if (el) el.textContent = val;
}
function hideSampleBadge() {
  const b = document.getElementById('sampleBadge');
  if (b) b.hidden = true;
}

/* ─── Loan Calc ─── */
function pmt(P: number, ratePct: number, years: number): number {
  if (P <= 0) return 0;
  const n = years * 12;
  if (ratePct === 0) return P / n;
  const r = ratePct / 100 / 12;
  const pw = Math.pow(1 + r, n);
  return P * r * pw / (pw - 1);
}

function calcEP(P: number, ratePct: number, years: number) {
  const m = pmt(P, ratePct, years);
  const total = m * years * 12;
  return { monthly: m, total, interest: Math.max(0, total - P) };
}

function calcEPR(P: number, ratePct: number, years: number) {
  const n = years * 12, r = ratePct / 100 / 12;
  const mp = P / n;
  const first = mp + P * r;
  const last  = mp + mp * r;
  const interest = ratePct === 0 ? 0 : P * r * (n + 1) / 2;
  return { firstMonthly: first, lastMonthly: last, total: P + interest, interest };
}

/* ─── Scenario calc ─── */
function calcScenario(price: number, pct: number, rate: number, years: number, isEP: boolean) {
  const down = price * pct / 100;
  const borrow = Math.max(0, price - down);
  if (borrow <= 0) return { pct, down, borrow: 0, monthly: 0, totalInt: 0, totalPay: 0 };
  const ep  = calcEP(borrow, rate, years);
  const epr = calcEPR(borrow, rate, years);
  return {
    pct, down, borrow,
    monthly:  isEP ? ep.monthly : epr.firstMonthly,
    totalInt: isEP ? ep.interest : epr.interest,
    totalPay: isEP ? ep.total   : epr.total,
  };
}

/* ─── SVG Bar Chart ─── */
function drawBarChart(svgId: string, data: { label: string; subLabel: string; value: number; valueLabel: string; current: boolean }[]) {
  const svg = document.getElementById(svgId);
  if (!svg) return;
  while (svg.firstChild) svg.removeChild(svg.firstChild);

  const W = 280, H = 160, padT = 28, padB = 38, padL = 8, padR = 8;
  const chartH = H - padT - padB;
  const chartW = W - padL - padR;
  const n = data.length;
  const slotW = chartW / n;
  const barW = Math.min(52, slotW * 0.62);
  const maxVal = Math.max(...data.map(d => d.value), 0.01);
  const ns = 'http://www.w3.org/2000/svg';

  data.forEach((d, i) => {
    const barH = Math.max((d.value / maxVal) * chartH, d.value > 0 ? 2 : 0);
    const x = padL + i * slotW + (slotW - barW) / 2;
    const y = padT + chartH - barH;
    const color = d.current ? '#1a4a3a' : '#c9943a';

    // Bar
    const rect = document.createElementNS(ns, 'rect');
    rect.setAttribute('x', String(x));
    rect.setAttribute('y', String(y));
    rect.setAttribute('width', String(barW));
    rect.setAttribute('height', String(barH));
    rect.setAttribute('rx', '3');
    rect.setAttribute('fill', color);
    rect.setAttribute('opacity', d.current ? '1' : '0.75');
    svg.appendChild(rect);

    // Value above bar
    if (d.value > 0) {
      const vt = document.createElementNS(ns, 'text');
      vt.setAttribute('x', String(x + barW / 2));
      vt.setAttribute('y', String(y - 4));
      vt.setAttribute('text-anchor', 'middle');
      vt.setAttribute('font-size', '9');
      vt.setAttribute('fill', d.current ? '#1a4a3a' : '#444');
      vt.setAttribute('font-weight', d.current ? '700' : '400');
      vt.textContent = d.valueLabel;
      svg.appendChild(vt);
    }

    // Label line 1 (%)
    const lt = document.createElementNS(ns, 'text');
    lt.setAttribute('x', String(x + barW / 2));
    lt.setAttribute('y', String(padT + chartH + 14));
    lt.setAttribute('text-anchor', 'middle');
    lt.setAttribute('font-size', '9');
    lt.setAttribute('fill', d.current ? '#1a4a3a' : '#6b6b6b');
    lt.setAttribute('font-weight', d.current ? '700' : '400');
    lt.textContent = d.label;
    svg.appendChild(lt);

    // Label line 2 (万円)
    const ls = document.createElementNS(ns, 'text');
    ls.setAttribute('x', String(x + barW / 2));
    ls.setAttribute('y', String(padT + chartH + 26));
    ls.setAttribute('text-anchor', 'middle');
    ls.setAttribute('font-size', '8');
    ls.setAttribute('fill', '#9b9b9b');
    ls.textContent = d.subLabel;
    svg.appendChild(ls);
  });
}

/* ─── Main Calculate ─── */
function calculate() {
  const price = getNum('price', D.price);
  const down  = getNum('down',  D.down);
  const borrow = Math.max(0, price - down);
  const rate  = getNum('rate',  D.rate);
  const years = getNum('years', D.years);
  const isEP  = (document.querySelector('input[name="repayType"]:checked') as HTMLInputElement | null)?.value !== 'equal-principal';
  const bonus = getNum('bonus', D.bonus);
  const fee   = getNum('fee',   D.fee);

  // Update borrow + % displays
  setText('borrowDisplay', fmt(borrow) + ' 万円');
  const downPct = price > 0 ? (down / price * 100) : 0;
  const pctEl = document.getElementById('downPctDisplay');
  if (pctEl) pctEl.textContent = downPct.toFixed(1);

  // Validate
  const errEl = document.getElementById('errorMsg');
  if (price <= 0 || rate < 0 || years < 1) {
    if (errEl) { errEl.textContent = '物件価格・年利・返済年数を正しく入力してください。'; errEl.hidden = false; }
    return;
  }
  if (errEl) errEl.hidden = true;

  // Current scenario
  let monthly = 0, totalInt = 0, totalPay = 0;
  if (borrow > 0) {
    const ep  = calcEP(borrow, rate, years);
    const epr = calcEPR(borrow, rate, years);
    monthly  = isEP ? ep.monthly  : epr.firstMonthly;
    totalInt = isEP ? ep.interest : epr.interest;
    totalPay = isEP ? ep.total    : epr.total;
  }
  const annualPay = monthly * 12 + bonus * 2;
  const withFee   = monthly + fee;

  setText('rMonthly',  fmt(monthly, 2) + ' 万円');
  setText('rBorrow',   fmt(borrow)  + ' 万円');
  setText('rTotal',    fmt(totalPay, 1) + ' 万円');
  setText('rInterest', fmt(totalInt, 1) + ' 万円');
  setText('rAnnual',   fmt(annualPay, 2) + ' 万円');
  setText('rWithFee',  fmt(withFee, 2) + ' 万円');

  const bonusRow = document.getElementById('bonusRow');
  if (bonusRow) bonusRow.hidden = bonus <= 0;
  setText('rBonusMonthly', fmt(monthly + bonus, 2) + ' 万円');

  // 4 fixed scenarios
  const scenarios = SCENARIO_PCTS.map(p => calcScenario(price, p, rate, years, isEP));
  const base = scenarios[0]; // 頭金0%

  // Diff box vs 頭金0%
  const diffBox = document.getElementById('diffBox');
  if (down > 0 && borrow < price) {
    if (diffBox) diffBox.hidden = false;
    const mDiff = base.monthly - monthly;
    const iDiff = base.totalInt - totalInt;
    setText('diffTitle', `頭金 ${fmt(down)} 万円（${downPct.toFixed(1)}%）を入れると…`);
    setText('diffMonthly',  mDiff >= 0 ? `月 ${fmtYen(mDiff * 10000)} 削減` : `月 ${fmtYen(-mDiff * 10000)} 増加`);
    setText('diffInterest', iDiff >= 0 ? `総利息 ${fmt(iDiff, 1)} 万円 削減` : `総利息 ${fmt(-iDiff, 1)} 万円 増加`);
  } else {
    if (diffBox) diffBox.hidden = true;
  }

  // Scenario table
  const tbody = document.getElementById('scenarioBody');
  if (tbody) {
    tbody.innerHTML = scenarios.map(s => {
      const isCurrent = Math.abs(downPct - s.pct) < 0.6;
      const mDiff = s.monthly - base.monthly;
      const diffStr = s.pct === 0
        ? '<span class="diff-zero">—</span>'
        : `<span class="diff-save">▼ ${fmtYen(-mDiff * 10000)}</span>`;
      return `<tr class="${isCurrent ? 'row-current' : ''}">
        <td>${fmt(Math.round(s.down))} 万円</td>
        <td>${s.pct}%</td>
        <td>${fmt(Math.round(s.borrow))} 万円</td>
        <td>${fmt(s.monthly, 2)} 万円</td>
        <td>${fmt(s.totalInt, 1)} 万円</td>
        <td>${diffStr}</td>
      </tr>`;
    }).join('');
  }

  // Charts
  const monthlyData = scenarios.map(s => ({
    label:      `頭金${s.pct}%`,
    subLabel:   `${fmt(Math.round(s.down))}万円`,
    value:      s.monthly,
    valueLabel: `${fmt(s.monthly, 1)}万`,
    current:    Math.abs(downPct - s.pct) < 0.6,
  }));
  drawBarChart('chartMonthly', monthlyData);

  const interestData = scenarios.map(s => ({
    label:      `頭金${s.pct}%`,
    subLabel:   `${fmt(Math.round(s.down))}万円`,
    value:      s.totalInt,
    valueLabel: `${fmt(s.totalInt, 0)}万`,
    current:    Math.abs(downPct - s.pct) < 0.6,
  }));
  drawBarChart('chartInterest', interestData);
}

/* ─── Slider sync ─── */
function syncSliderToNum(slider: HTMLInputElement) {
  const targetId = slider.dataset.target;
  if (!targetId) return;
  const numEl = document.getElementById(targetId) as HTMLInputElement | null;
  if (!numEl) return;
  numEl.value = slider.value;
  updateFill(slider);
  updateDisplay(targetId, slider.value);
}

function syncNumToSlider(numEl: HTMLInputElement) {
  const slider = document.querySelector<HTMLInputElement>(`input.range-slider[data-target="${numEl.id}"]`);
  if (!slider) return;
  const mn = parseFloat(slider.min) || 0, mx = parseFloat(slider.max) || 100, step = parseFloat(slider.step) || 1;
  let v = parseFloat(numEl.value);
  if (isNaN(v) || v < mn) v = mn;
  if (v > mx) v = mx;
  v = Math.round(v / step) * step;
  numEl.value = String(v); slider.value = String(v);
  updateFill(slider);
  updateDisplay(numEl.id, numEl.value);
}

function updateDownMax() {
  const price = getNum('price', D.price);
  const downSlider = document.querySelector<HTMLInputElement>('input.range-slider[data-target="down"]');
  const downNum    = document.getElementById('down') as HTMLInputElement | null;
  if (!downSlider || !downNum) return;
  downSlider.max = String(price); downNum.max = String(price);
  const curDown = getNum('down', 0);
  if (curDown > price) {
    downSlider.value = String(price); downNum.value = String(price);
    updateDisplay('down', String(price));
  }
  updateFill(downSlider);
}

/* ─── Init ─── */
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll<HTMLInputElement>('input.range-slider').forEach(slider => {
    updateFill(slider);
    slider.addEventListener('input', () => {
      syncSliderToNum(slider);
      if (slider.dataset.target === 'price') updateDownMax();
      hideSampleBadge();
      calculate();
    });
  });

  document.querySelectorAll<HTMLInputElement>('input.field-input').forEach(numEl => {
    numEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['-', 'e', 'E', '+'].includes(e.key)) e.preventDefault();
    });
    numEl.addEventListener('change', () => {
      syncNumToSlider(numEl);
      if (numEl.id === 'price') updateDownMax();
      hideSampleBadge();
      calculate();
    });
  });

  document.querySelectorAll<HTMLInputElement>('input[name="repayType"]').forEach(radio => {
    radio.addEventListener('change', () => { hideSampleBadge(); calculate(); });
  });

  calculate();
});
</script>
