.field-label { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
.field-label label { font-size: 0.875rem; font-weight: 600; color: var(--c-text); }
.field-label-text { font-size: 0.875rem; font-weight: 600; color: var(--c-text); margin-bottom: 8px; }
.field-display { font-size: 0.875rem; font-weight: 700; color: var(--c-primary); white-space: nowrap; }
.field-hint { font-size: 0.72rem; color: var(--c-text-muted); margin-top: 3px; line-height: 1.5; }
.divider { border: none; border-top: 1px solid var(--c-border); margin: 18px 0 14px; }

/* ── Range slider ── */
.range-slider {
  width: 100%; height: 20px;
  -webkit-appearance: none; appearance: none;
  background: linear-gradient(to right, var(--c-primary) var(--pct, 0%), var(--c-border) var(--pct, 0%));
  border-radius: 2px; outline: none; cursor: pointer; padding: 0; margin: 0 0 6px; display: block;
}
.range-slider::-webkit-slider-thumb {
  -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%;
  background: var(--c-primary); box-shadow: 0 1px 4px rgba(0,0,0,0.25); transition: transform 0.1s, background 0.1s;
}
.range-slider::-webkit-slider-thumb:hover,
.range-slider:active::-webkit-slider-thumb { background: var(--c-primary-hover); transform: scale(1.15); }
.range-slider::-moz-range-thumb {
  width: 22px; height: 22px; border-radius: 50%; background: var(--c-primary); border: none;
  box-shadow: 0 1px 4px rgba(0,0,0,0.25);
}

