---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '不動産投資キャッシュフローシミュレーター',
    url: 'https://estate.kuras-plus.com/calculators/cash-flow',
    description: '物件価格・家賃・ローン条件を入力して年次キャッシュフロー推移を無料シミュレーション。黒字転換年・自己資金回収年を自動計算。',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://estate.kuras-plus.com' },
      { '@type': 'ListItem', position: 2, name: '不動産投資キャッシュフローシミュレーター', item: 'https://estate.kuras-plus.com/calculators/cash-flow' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '不動産投資のキャッシュフローとは何ですか？',
        acceptedAnswer: { '@type': 'Answer', text: '家賃収入からローン返済・管理費・修繕費・税金などすべての費用を差し引いた「実際の手残り」です。利回りとは異なり、ローン返済の有無や初期費用も加味した実態に近い収益性を示します。' },
      },
      {
        '@type': 'Question',
        name: '利回りが高いのに手残りが少ないのはなぜですか？',
        acceptedAnswer: { '@type': 'Answer', text: '利回りはローン返済を考慮しない指標です。借入比率が高いとローン返済額が大きくなり、表面利回りが高くても手残りが少なくなります。管理費・修繕費・空室損失・税金も手残りを圧迫します。' },
      },
      {
        '@type': 'Question',
        name: '何年で自己資金を回収できるかはどう見ればよいですか？',
        acceptedAnswer: { '@type': 'Answer', text: '当ツールの「自己資金回収年」は、累計キャッシュフローが「頭金＋初期費用」を上回る年を自動計算します。目安として10〜15年以内での回収を目標とするケースが多いです。' },
      },
      {
        '@type': 'Question',
        name: '家賃下落率や空室率はどのくらい見込むべきですか？',
        acceptedAnswer: { '@type': 'Answer', text: '地域や物件種別によりますが、家賃下落率は年0.5〜1%、空室率は5〜10%が目安です。悲観ケースとして家賃下落2%・空室率15%程度でシミュレーションすることを推奨します。' },
      },
      {
        '@type': 'Question',
        name: '売却を含めたキャッシュフローはどう考えればよいですか？',
        acceptedAnswer: { '@type': 'Answer', text: '売却時の手取り（売却価格 − 諸費用 − 残債）をシミュレーション最終年のCFに加算して評価します。出口戦略まで含めた総合判断が重要です。' },
      },
      {
        '@type': 'Question',
        name: 'キャッシュフローが赤字でも投資する意味はありますか？',
        acceptedAnswer: { '@type': 'Answer', text: '節税効果や資産価値の上昇が見込める場合は赤字でも投資意義があるケースもあります。ただし手元資金が毎年減少するため余裕資金がないと危険です。当ツールはCF面の試算のみで、税効果・資産評価は含まれません。' },
      },
    ],
  },
];
---

<BaseLayout
  title="不動産投資キャッシュフローシミュレーター | 年次収支・手残りを無料試算"
  description="物件価格・家賃・ローン・費用を入力するだけで年ごとのキャッシュフロー推移を無料シミュレーション。黒字転換年・自己資金回収年も自動計算。家賃下落・空室リスクの悲観ケース比較も可能。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/cash-flow" />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>不動産投資キャッシュフローシミュレーター</span>
      </nav>
      <p class="hero-eyebrow">Cash Flow Simulator</p>
      <h1 class="hero-title">不動産投資<br />キャッシュフローシミュレーター</h1>
      <p class="hero-desc">
        物件価格・家賃・ローン・費用を入力するだけで、年ごとの手残り推移・黒字転換年・自己資金回収年を自動計算。
        ベースケースと悲観ケースの比較でリスクも把握できます。
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <div class="container mt-32" id="cf-wrap">
    <div class="cf-layout">

      <!-- ── 入力フォーム ── -->
      <div id="cf-inputs">

        <!-- 物件・収入条件 -->
        <section class="card" aria-label="物件・収入条件">
          <h2 class="card-heading">物件・収入条件</h2>

          <div class="field-grid">
            <div class="field">
              <label class="field-label" for="propertyPrice">物件価格 <span class="field-unit">万円</span></label>
              <input class="field-input" type="number" id="propertyPrice" value="3000" min="0" step="100" />
            </div>
            <div class="field">
              <label class="field-label" for="monthlyRent">月額家賃 <span class="field-unit">万円/月</span></label>
              <input class="field-input" type="number" id="monthlyRent" value="12" min="0" step="0.1" />
            </div>
            <div class="field">
              <label class="field-label" for="rentDeclineRate">家賃下落率 <span class="field-unit">%/年</span></label>
              <input class="field-input" type="number" id="rentDeclineRate" value="1" min="0" max="20" step="0.1" />
              <p class="field-hint">年率で家賃が下落する想定。0%なら下落なし。</p>
            </div>
            <div class="field">
              <label class="field-label" for="vacancyRate">空室率 <span class="field-unit">%</span></label>
              <input class="field-input" type="number" id="vacancyRate" value="5" min="0" max="100" step="1" />
              <p class="field-hint">年間を通じた空室割合の想定（5〜10%が目安）。</p>
            </div>
            <div class="field">
              <label class="field-label" for="otherIncome">年間その他収入 <span class="field-unit">万円/年</span></label>
              <input class="field-input" type="number" id="otherIncome" value="0" min="0" step="1" />
              <p class="field-hint">駐車場収入など（任意）。</p>
            </div>
          </div>
        </section>

        <!-- 費用条件 -->
        <section class="card mt-16" aria-label="費用条件">
          <h2 class="card-heading">費用条件</h2>
          <p class="card-hint">年間の保有コストを入力してください（万円/年）。</p>

          <div class="field-grid">
            <div class="field">
              <label class="field-label" for="mgmtFee">管理費 <span class="field-unit">万円/年</span></label>
              <input class="field-input" type="number" id="mgmtFee" value="5" min="0" step="1" />
            </div>
            <div class="field">
              <label class="field-label" for="repairFee">修繕費 <span class="field-unit">万円/年</span></label>
              <input class="field-input" type="number" id="repairFee" value="5" min="0" step="1" />
            </div>
            <div class="field">
              <label class="field-label" for="propertyTaxInput">固定資産税 <span class="field-unit">万円/年</span></label>
              <input class="field-input" type="number" id="propertyTaxInput" value="10" min="0" step="1" />
            </div>
            <div class="field">
              <label class="field-label" for="otherExpenses">その他費用 <span class="field-unit">万円/年</span></label>
              <input class="field-input" type="number" id="otherExpenses" value="2" min="0" step="1" />
            </div>
            <div class="field field-full">
              <label class="field-label" for="expenseInflation">費用上昇率 <span class="field-unit">%/年</span></label>
              <input class="field-input" type="number" id="expenseInflation" value="1" min="0" max="20" step="0.1" />
              <p class="field-hint">インフレ等による費用増加率の想定。0%なら固定。</p>
            </div>
          </div>
        </section>

        <!-- ローン条件 -->
        <section class="card mt-16" aria-label="ローン条件">
          <h2 class="card-heading">ローン条件</h2>

          <div class="field-grid">
            <div class="field">
              <label class="field-label" for="downPayment">頭金 <span class="field-unit">万円</span></label>
              <input class="field-input" type="number" id="downPayment" value="600" min="0" step="100" />
            </div>
            <div class="field">
              <label class="field-label" for="loanAmount">借入額 <span class="field-unit">万円</span></label>
              <input class="field-input" type="number" id="loanAmount" value="0" min="0" step="100" />
              <p class="field-hint" id="loanHint">0のとき「物件価格−頭金」を自動設定。</p>
            </div>
            <div class="field">
              <label class="field-label" for="interestRate">金利 <span class="field-unit">%/年</span></label>
              <input class="field-input" type="number" id="interestRate" value="1.5" min="0" max="20" step="0.01" />
            </div>
            <div class="field">
              <label class="field-label" for="loanYears">返済年数 <span class="field-unit">年</span></label>
              <input class="field-input" type="number" id="loanYears" value="30" min="1" max="50" step="1" />
            </div>
            <div class="field field-full">
              <label class="field-label" for="repaymentMethod">返済方式</label>
              <select class="field-input" id="repaymentMethod">
                <option value="equal">元利均等返済（毎月返済額が一定）</option>
                <option value="principal">元金均等返済（当初負担大・総返済少）</option>
              </select>
            </div>
          </div>
          <div class="loan-info-box" id="loanInfoBox">
            <span id="loanAmountDisplay">借入額: 2,400万円</span>
            <span id="monthlyPayDisplay">月返済: —</span>
          </div>
        </section>

        <!-- 初期費用 -->
        <details class="card mt-16" open>
          <summary class="card-heading card-summary">初期費用（合計が投資回収計算に使われます）</summary>
          <div class="field-grid" style="margin-top:14px;">
            <div class="field">
              <label class="field-label" for="acqTax">不動産取得税 <span class="field-unit">万円</span></label>
              <input class="field-input" type="number" id="acqTax" value="60" min="0" step="1" />
            </div>
            <div class="field">
              <label class="field-label" for="regFee">登記費用 <span class="field-unit">万円</span></label>
              <input class="field-input" type="number" id="regFee" value="30" min="0" step="1" />
            </div>
            <div class="field">
              <label class="field-label" for="agentFee">仲介手数料 <span class="field-unit">万円</span></label>
              <input class="field-input" type="number" id="agentFee" value="90" min="0" step="1" />
            </div>
            <div class="field">
              <label class="field-label" for="otherInitial">その他初期費用 <span class="field-unit">万円</span></label>
              <input class="field-input" type="number" id="otherInitial" value="30" min="0" step="1" />
            </div>
          </div>
          <div class="total-box">
            初期費用合計: <strong id="initCostTotal">210 万円</strong>
          </div>
        </details>

        <!-- シミュレーション設定 -->
        <section class="card mt-16" aria-label="シミュレーション設定">
          <h2 class="card-heading">シミュレーション設定</h2>

          <div class="field">
            <label class="field-label" for="simYears">シミュレーション年数 <span class="field-unit">年</span></label>
            <div class="sim-years-row">
              <button type="button" class="year-btn" data-year="5">5年</button>
              <button type="button" class="year-btn" data-year="10">10年</button>
              <button type="button" class="year-btn active" data-year="20">20年</button>
              <button type="button" class="year-btn" data-year="30">30年</button>
              <input class="field-input sim-years-input" type="number" id="simYears" value="20" min="1" max="50" step="1" />
            </div>
          </div>

          <div class="field mt-16">
            <label class="checkbox-row">
              <input type="checkbox" id="withSale" />
              <span>売却を考慮する</span>
            </label>
          </div>

          <div id="sale-section" hidden>
            <div class="field-grid mt-16">
              <div class="field">
                <label class="field-label" for="salePrice">売却価格 <span class="field-unit">万円</span></label>
                <input class="field-input" type="number" id="salePrice" value="2500" min="0" step="100" />
              </div>
              <div class="field">
                <label class="field-label" for="saleCosts">売却時諸費用 <span class="field-unit">万円</span></label>
                <input class="field-input" type="number" id="saleCosts" value="100" min="0" step="10" />
                <p class="field-hint">仲介手数料・登記費用など。</p>
              </div>
            </div>
          </div>
        </section>
      </div><!-- /cf-inputs -->

      <!-- ── 結果サマリー ── -->
      <div class="cf-results">
        <div id="result-empty" class="result-empty">
          <div class="result-empty-icon">📊</div>
          <p>左の条件を入力すると<br />リアルタイムで結果を表示します</p>
        </div>

        <div id="result-content" hidden>

          <!-- 1年目サマリー -->
          <section class="result-card" aria-label="1年目サマリー">
            <h2 class="result-title">1年目サマリー</h2>
            <div class="summary-grid">
              <div class="summary-item">
                <span class="summary-label">年間家賃収入</span>
                <span class="summary-val" id="y1Rent">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">空室考慮後収入</span>
                <span class="summary-val" id="y1EffIncome">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">年間費用合計</span>
                <span class="summary-val" id="y1Expenses">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">年間ローン返済</span>
                <span class="summary-val" id="y1LoanPay">—</span>
              </div>
            </div>
            <div class="y1cf-box">
              <span class="y1cf-label">1年目 年間手残り</span>
              <span class="y1cf-val" id="y1CF">—</span>
            </div>
          </section>

          <!-- 累計サマリー -->
          <section class="result-card mt-16" aria-label="累計サマリー">
            <h2 class="result-title">累計サマリー（<span id="simYearsLabel">20</span>年間）</h2>
            <div class="summary-grid">
              <div class="summary-item">
                <span class="summary-label">累計家賃収入</span>
                <span class="summary-val" id="cumRent">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">累計費用</span>
                <span class="summary-val" id="cumExp">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">累計ローン返済</span>
                <span class="summary-val" id="cumLoan">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">累計手残り</span>
                <span class="summary-val" id="cumCF">—</span>
              </div>
            </div>
            <div class="net-box">
              <span class="net-label">初期費用込み累計損益</span>
              <span class="net-val" id="netIncome">—</span>
            </div>
          </section>

          <!-- 重要指標 -->
          <div class="metrics-row mt-16">
            <div class="metric-card">
              <div class="metric-label">黒字転換年</div>
              <div class="metric-val" id="breakEvenYear">—</div>
              <div class="metric-sub">初期費用回収時点</div>
            </div>
            <div class="metric-card">
              <div class="metric-label">自己資金回収年</div>
              <div class="metric-val" id="selfFundingYear">—</div>
              <div class="metric-sub">頭金＋初期費用を回収</div>
            </div>
          </div>

          <!-- 売却結果 -->
          <section class="result-card mt-16" id="sale-result" hidden aria-label="売却込み損益">
            <h2 class="result-title">売却込み最終損益</h2>
            <div class="summary-grid">
              <div class="summary-item">
                <span class="summary-label">売却時手取り額</span>
                <span class="summary-val" id="saleProceeds">—</span>
              </div>
              <div class="summary-item">
                <span class="summary-label">（売却価格 − 諸費用 − 残債）</span>
                <span class="summary-val"></span>
              </div>
            </div>
            <div class="net-box">
              <span class="net-label">最終累計損益（売却込み）</span>
              <span class="net-val" id="finalNetIncome">—</span>
            </div>
            <p class="result-disclaimer" style="margin-top:8px;">
              ※ 売却益・損失にかかる税金は概算に含まれていません。
            </p>
          </section>

        </div><!-- /result-content -->
      </div><!-- /cf-results -->
    </div><!-- /cf-layout -->

    <!-- ── グラフ ── -->
    <section class="result-card mt-32" aria-label="累計損益推移グラフ">
      <h2 class="result-title">累計損益推移（初期費用込み）</h2>
      <p class="result-sub">黒字転換年を境に損益がプラスに転じます。悲観ケース（赤点線）でもシミュレーション。</p>
      <div class="chart-wrap">
        <svg id="cf-chart" viewBox="0 0 560 200" aria-label="累計損益推移グラフ" role="img" style="width:100%;height:auto;display:block;"></svg>
      </div>
    </section>

    <!-- ── シナリオ比較 ── -->
    <section class="result-card mt-16" aria-label="シナリオ比較">
      <h2 class="result-title">シナリオ比較</h2>
      <p class="result-sub">悲観ケース：家賃下落率 +1%、空室率 +5%、費用上昇率 +1%</p>
      <div class="scenario-grid" id="result-content-scenario">
        <div class="scenario-card scenario-base">
          <div class="scenario-badge">ベースケース</div>
          <div class="scenario-items">
            <div class="scenario-row"><span>黒字転換年</span><strong id="baseBreakEven">—</strong></div>
            <div class="scenario-row"><span>1年目手残り</span><strong id="baseY1CF">—</strong></div>
            <div class="scenario-row"><span>累計損益</span><strong id="baseNetIncome">—</strong></div>
          </div>
        </div>
        <div class="scenario-card scenario-pess">
          <div class="scenario-badge">悲観ケース</div>
          <div class="scenario-items">
            <div class="scenario-row"><span>黒字転換年</span><strong id="pessBreakEven">—</strong></div>
            <div class="scenario-row"><span>1年目手残り</span><strong id="pessY1CF">—</strong></div>
            <div class="scenario-row"><span>累計損益</span><strong id="pessNetIncome">—</strong></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 年次推移テーブル ── -->
    <section class="result-card mt-16" aria-label="年次推移テーブル">
      <h2 class="result-title">年次推移（ベースケース）</h2>
      <p class="result-sub">各年の詳細データです。手残りがマイナスの年は赤字表示。</p>
      <div class="table-wrap">
        <table class="cf-table">
          <thead>
            <tr>
              <th>年</th>
              <th>月額家賃<br /><small>万円</small></th>
              <th>年間家賃収入<br /><small>万円</small></th>
              <th>空室後収入<br /><small>万円</small></th>
              <th>年間費用<br /><small>万円</small></th>
              <th>ローン返済<br /><small>万円/年</small></th>
              <th>年間手残り<br /><small>万円</small></th>
              <th>累計損益<br /><small>万円・初期費込</small></th>
            </tr>
          </thead>
          <tbody id="cf-tbody">
            <tr><td colspan="8" class="table-empty">左の条件を入力すると表示されます</td></tr>
          </tbody>
        </table>
      </div>
      <p class="result-disclaimer mt-8">
        ※ 計算結果は概算です。税金・売却損益課税・保険料などは含まれていません。実際の投資判断は専門家にご相談ください。
      </p>
    </section>

    <!-- ── 説明セクション ── -->
    <section class="explain-section mt-48">
      <h2 class="section-title">不動産投資キャッシュフローシミュレーターとは</h2>
      <p class="explain-body">
        本ツールは、不動産投資における「実際の手残り（キャッシュフロー）」の年次推移を無料でシミュレーションするツールです。
        物件価格・家賃・ローン返済・諸費用を入力することで、何年後に黒字転換するか・自己資金を何年で回収できるかを可視化します。
      </p>
