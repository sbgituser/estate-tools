.next-tool-inner { display: flex; align-items: center; gap: 12px; }
.next-tool-icon { font-size: 1.8rem; flex-shrink: 0; }
.next-tool-title { font-size: 0.88rem; font-weight: 700; color: var(--c-primary); margin-bottom: 3px; }
