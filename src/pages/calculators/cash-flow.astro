<script>
// ================================================
// 不動産投資キャッシュフローシミュレーター
// ================================================

// --- Formatters ---
function fmt(v: number, d = 1): string {
  return v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d });
}
function fmtSign(v: number, d = 1): string {
  const s = fmt(Math.abs(v), d);
  return v >= 0 ? `+${s}` : `−${s}`;
}

// --- DOM Helpers ---
function getNum(id: string, fallback = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fallback;
  const v = parseFloat(el.value);
  return isNaN(v) ? fallback : v;
}
function getCheck(id: string): boolean {
  return (document.getElementById(id) as HTMLInputElement | null)?.checked ?? false;
}
function getVal(id: string): string {
  return (document.getElementById(id) as HTMLInputElement | null)?.value ?? '';
}
function setText(id: string, text: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = text;
}
function setHtml(id: string, html: string) {
  const el = document.getElementById(id);
  if (el) el.innerHTML = html;
}
function setClass(id: string, ...classes: string[]) {
  const el = document.getElementById(id);
  if (el) el.className = classes.join(' ');
}

// --- Loan Calculations ---
function calcMonthlyPaymentEqual(principal: number, annualRate: number, years: number): number {
  if (principal <= 0 || years <= 0) return 0;
  if (annualRate <= 0) return principal / (years * 12);
  const r = annualRate / 100 / 12;
  const n = years * 12;
  return principal * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);
}

function calcRemainingDebtEqual(principal: number, annualRate: number, years: number, afterYear: number): number {
  if (principal <= 0 || years <= 0 || afterYear >= years) return 0;
  if (annualRate <= 0) return principal * (1 - afterYear / years);
  const r = annualRate / 100 / 12;
  const n = years * 12;
  const k = afterYear * 12;
  return principal * (Math.pow(1 + r, n) - Math.pow(1 + r, k)) / (Math.pow(1 + r, n) - 1);
}

interface SimParams {
  propertyPrice: number;
  monthlyRent: number;
  rentDeclineRate: number;
  vacancyRate: number;
  otherIncome: number;
  mgmtFee: number;
  repairFee: number;
  propertyTax: number;
  otherExpenses: number;
  expenseInflation: number;
  downPayment: number;
  loanAmount: number;
  interestRate: number;
  loanYears: number;
  repaymentMethod: string;
  initialCostsTotal: number;
  simYears: number;
  withSale: boolean;
  salePrice: number;
  saleCosts: number;
}

interface YearRow {
  year: number;
  monthlyRent: number;
  annualRent: number;
  effectiveIncome: number;
  expenses: number;
  loanPayment: number;
  annualCF: number;
  cumulativeCF: number;
  netIncome: number;
  remainingDebt: number;
}

interface SimResult {
  rows: YearRow[];
  totalRent: number;
  totalExp: number;
  totalLoan: number;
  totalCF: number;
  netIncome: number;
  breakEvenYear: number | null;
  selfFundingYear: number | null;
  saleProceeds: number | null;
  finalNetIncome: number;
  y1: YearRow | null;
}

// --- Main Simulation ---
function simulate(p: SimParams): SimResult {
  const monthlyPayment = calcMonthlyPaymentEqual(p.loanAmount, p.interestRate, p.loanYears);
  const totalMonths = p.loanYears * 12;
  const monthlyRate = p.interestRate / 100 / 12;
  const monthlyPrincipal = p.loanAmount > 0 && p.loanYears > 0 ? p.loanAmount / totalMonths : 0;

  function getAnnualLoan(year: number): number {
    if (p.loanAmount <= 0 || p.loanYears <= 0 || year > p.loanYears) return 0;
    if (p.repaymentMethod === 'principal') {
      let annual = 0;
      for (let m = 0; m < 12; m++) {
        const mi = (year - 1) * 12 + m;
        if (mi >= totalMonths) break;
        annual += monthlyPrincipal + (p.loanAmount - monthlyPrincipal * mi) * monthlyRate;
      }
      return annual;
    }
    return monthlyPayment * 12;
  }

  function getRemaining(afterYear: number): number {
    if (p.loanAmount <= 0 || p.loanYears <= 0 || afterYear >= p.loanYears) return 0;
    if (p.repaymentMethod === 'principal') {
      return Math.max(0, p.loanAmount - monthlyPrincipal * afterYear * 12);
    }
    return calcRemainingDebtEqual(p.loanAmount, p.interestRate, p.loanYears, afterYear);
  }

  const rows: YearRow[] = [];
  let cumCF = 0;
  for (let y = 1; y <= p.simYears; y++) {
    const rentFactor = Math.pow(1 - p.rentDeclineRate / 100, y - 1);
    const curRent = p.monthlyRent * rentFactor;
    const annualRent = curRent * 12;
    const effectiveIncome = annualRent * (1 - p.vacancyRate / 100) + p.otherIncome;
    const expFactor = Math.pow(1 + p.expenseInflation / 100, y - 1);
    const expenses = (p.mgmtFee + p.repairFee + p.propertyTax + p.otherExpenses) * expFactor;
    const loanPayment = getAnnualLoan(y);
    const annualCF = effectiveIncome - expenses - loanPayment;
    cumCF += annualCF;
    const netIncome = cumCF - p.initialCostsTotal;
    rows.push({ year: y, monthlyRent: curRent, annualRent, effectiveIncome, expenses, loanPayment, annualCF, cumulativeCF: cumCF, netIncome, remainingDebt: getRemaining(y) });
  }

  const totalRent = rows.reduce((s, r) => s + r.annualRent, 0);
  const totalExp = rows.reduce((s, r) => s + r.expenses, 0);
  const totalLoan = rows.reduce((s, r) => s + r.loanPayment, 0);
  const netIncome = cumCF - p.initialCostsTotal;

  let breakEvenYear: number | null = null;
  for (const r of rows) { if (r.netIncome >= 0) { breakEvenYear = r.year; break; } }

  const selfTarget = p.downPayment + p.initialCostsTotal;
  let selfFundingYear: number | null = null;
  for (const r of rows) { if (r.cumulativeCF >= selfTarget) { selfFundingYear = r.year; break; } }

  let saleProceeds: number | null = null;
  let finalNetIncome = netIncome;
  if (p.withSale && p.salePrice > 0 && rows.length > 0) {
    saleProceeds = p.salePrice - p.saleCosts - rows[rows.length - 1].remainingDebt;
    finalNetIncome = netIncome + saleProceeds;
  }

  return { rows, totalRent, totalExp, totalLoan, totalCF: cumCF, netIncome, breakEvenYear, selfFundingYear, saleProceeds, finalNetIncome, y1: rows[0] ?? null };
}

function pessimisticParams(p: SimParams): SimParams {
  return { ...p, rentDeclineRate: p.rentDeclineRate + 1, vacancyRate: Math.min(p.vacancyRate + 5, 50), expenseInflation: p.expenseInflation + 1 };
}

// --- SVG Chart ---
function drawChart(svgEl: SVGElement, base: SimResult, pess: SimResult) {
  const W = 560, H = 200, PL = 55, PR = 20, PT = 20, PB = 30;
  const CW = W - PL - PR, CH = H - PT - PB;
  const n = base.rows.length;
  if (n === 0) return;

  const allV = [...base.rows.map(r => r.netIncome), ...pess.rows.map(r => r.netIncome), 0];
  const minV = Math.min(...allV), maxV = Math.max(...allV);
  const span = (maxV - minV) || 1;
  const lo = minV - span * 0.08, hi = maxV + span * 0.08;
  const rng = hi - lo;

  const xS = (i: number) => PL + (n <= 1 ? CW / 2 : (i / (n - 1)) * CW);
  const yS = (v: number) => PT + CH - ((v - lo) / rng * CH);
  const zy = yS(0);

  let parts = '';

  // Grid lines
  for (let t = 0; t <= 4; t++) {
    const v = lo + rng * t / 4;
    const y = yS(v).toFixed(1);
    parts += `<line x1="${PL}" y1="${y}" x2="${W - PR}" y2="${y}" stroke="#e5e7eb" stroke-width="0.5"/>`;
    const label = v === 0 ? '0' : (Math.round(Math.abs(v)) >= 10000 ? Math.round(v / 100) / 10 + '千' : Math.round(v) + '万');
    parts += `<text x="${PL - 3}" y="${(parseFloat(y) + 3).toFixed(1)}" font-size="9" fill="#9ca3af" text-anchor="end">${label}</text>`;
  }

  // Zero line
  parts += `<line x1="${PL}" y1="${zy.toFixed(1)}" x2="${W - PR}" y2="${zy.toFixed(1)}" stroke="#6b7280" stroke-width="1.5" stroke-dasharray="4 2"/>`;

  // Shaded positive area for base
  const basePts = base.rows.map((r, i) => `${xS(i).toFixed(1)},${yS(r.netIncome).toFixed(1)}`).join(' ');
  const areaPath = `M${xS(0).toFixed(1)},${zy.toFixed(1)} ` + base.rows.map((r, i) => `L${xS(i).toFixed(1)},${yS(r.netIncome).toFixed(1)}`).join(' ') + ` L${xS(n-1).toFixed(1)},${zy.toFixed(1)} Z`;
  parts += `<path d="${areaPath}" fill="#1a4a3a" fill-opacity="0.05"/>`;

  // Pessimistic line
  if (pess.rows.length > 1) {
    const pessPath = pess.rows.map((r, i) => `${i === 0 ? 'M' : 'L'}${xS(i).toFixed(1)},${yS(r.netIncome).toFixed(1)}`).join(' ');
    parts += `<path d="${pessPath}" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5 3"/>`;
  }

  // Base line
  const basePath = base.rows.map((r, i) => `${i === 0 ? 'M' : 'L'}${xS(i).toFixed(1)},${yS(r.netIncome).toFixed(1)}`).join(' ');
  parts += `<path d="${basePath}" fill="none" stroke="#1a4a3a" stroke-width="2"/>`;

  // Break-even marker
  if (base.breakEvenYear && base.breakEvenYear <= n) {
    const bx = xS(base.breakEvenYear - 1).toFixed(1);
    parts += `<line x1="${bx}" y1="${PT}" x2="${bx}" y2="${PT + CH}" stroke="#c9943a" stroke-width="1.5" stroke-dasharray="3 2" opacity="0.8"/>`;
    parts += `<circle cx="${bx}" cy="${zy.toFixed(1)}" r="4" fill="#c9943a" stroke="white" stroke-width="1.5"/>`;
    const tx = Math.min(parseFloat(bx) + 5, W - PR - 40);
    parts += `<text x="${tx.toFixed(1)}" y="${(zy - 6).toFixed(1)}" font-size="9" fill="#c9943a">黒字転換</text>`;
  }

  // X axis labels
  const step = Math.max(1, Math.ceil(n / 6));
  const labeled = new Set<number>();
  for (let i = 0; i < n; i += step) {
    labeled.add(i);
    parts += `<text x="${xS(i).toFixed(1)}" y="${H - 2}" font-size="9" fill="#9ca3af" text-anchor="middle">${base.rows[i].year}年</text>`;
  }
  if (!labeled.has(n - 1)) {
    parts += `<text x="${xS(n - 1).toFixed(1)}" y="${H - 2}" font-size="9" fill="#9ca3af" text-anchor="middle">${base.rows[n - 1].year}年</text>`;
  }

  // Legend
  parts += `<line x1="${PL}" y1="${H - 14}" x2="${PL + 14}" y2="${H - 14}" stroke="#1a4a3a" stroke-width="2"/>`;
  parts += `<text x="${PL + 17}" y="${H - 10}" font-size="9" fill="#374151">ベース</text>`;
  parts += `<line x1="${PL + 60}" y1="${H - 14}" x2="${PL + 74}" y2="${H - 14}" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5 3"/>`;
  parts += `<text x="${PL + 77}" y="${H - 10}" font-size="9" fill="#374151">悲観</text>`;
  parts += `<circle cx="${PL + 122}" cy="${H - 14}" r="3.5" fill="#c9943a"/>`;
  parts += `<text x="${PL + 128}" y="${H - 10}" font-size="9" fill="#374151">黒字転換</text>`;

  svgEl.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svgEl.innerHTML = parts;
}

// --- Table ---
function buildTable(rows: YearRow[]) {
  const tbody = document.getElementById('cf-tbody');
  if (!tbody) return;
  tbody.innerHTML = rows.map(r => {
    const cfCls = r.annualCF >= 0 ? 'cf-pos' : 'cf-neg';
    const netCls = r.netIncome >= 0 ? 'cf-pos' : 'cf-neg';
    return `<tr>
      <td>${r.year}</td>
      <td>${fmt(r.monthlyRent, 1)}</td>
      <td>${fmt(r.annualRent, 1)}</td>
      <td>${fmt(r.effectiveIncome, 1)}</td>
      <td>${fmt(r.expenses, 1)}</td>
      <td>${fmt(r.loanPayment, 1)}</td>
      <td class="${cfCls}">${fmtSign(r.annualCF)}</td>
      <td class="${netCls}">${fmtSign(r.netIncome, 0)}</td>
    </tr>`;
  }).join('');
}

// --- Read params ---
function readParams(): SimParams {
  const propertyPrice = getNum('propertyPrice', 3000);
  const downPayment = getNum('downPayment', 600);
  const loanManual = getNum('loanAmount', 0);
  const loanAmount = loanManual > 0 ? loanManual : Math.max(0, propertyPrice - downPayment);
  const initialCostsTotal = getNum('acqTax', 0) + getNum('regFee', 0) + getNum('agentFee', 0) + getNum('otherInitial', 0);

  return {
    propertyPrice,
    monthlyRent: getNum('monthlyRent', 12),
    rentDeclineRate: getNum('rentDeclineRate', 1),
    vacancyRate: getNum('vacancyRate', 5),
    otherIncome: getNum('otherIncome', 0),
    mgmtFee: getNum('mgmtFee', 5),
    repairFee: getNum('repairFee', 5),
    propertyTax: getNum('propertyTaxInput', 10),
    otherExpenses: getNum('otherExpenses', 2),
    expenseInflation: getNum('expenseInflation', 1),
    downPayment,
    loanAmount,
    interestRate: getNum('interestRate', 1.5),
    loanYears: getNum('loanYears', 30),
    repaymentMethod: getVal('repaymentMethod') || 'equal',
    initialCostsTotal,
    simYears: Math.min(50, Math.max(1, getNum('simYears', 20))),
    withSale: getCheck('withSale'),
    salePrice: getNum('salePrice', 2500),
    saleCosts: getNum('saleCosts', 100),
  };
}

// --- Update UI ---
function update() {
  const p = readParams();

  if (p.propertyPrice <= 0 || p.monthlyRent <= 0) {
    const empty = document.getElementById('result-empty');
    const content = document.getElementById('result-content');
    if (empty) empty.hidden = false;
    if (content) content.hidden = true;
    return;
  }

  const empty2 = document.getElementById('result-empty');
  const content2 = document.getElementById('result-content');
  if (empty2) empty2.hidden = true;
  if (content2) content2.hidden = false;

  const loanManual = getNum('loanAmount', 0);
  const effectiveLoan = loanManual > 0 ? loanManual : Math.max(0, p.propertyPrice - p.downPayment);
  const monthly = calcMonthlyPaymentEqual(effectiveLoan, p.interestRate, p.loanYears);
  setText('loanAmountDisplay', `借入額: ${fmt(effectiveLoan, 0)}万円`);
  setText('monthlyPayDisplay', p.repaymentMethod === 'equal' ? `月返済: ${fmt(monthly, 1)}万円` : '月返済: 変動（元金均等）');

  const initTotal = p.initialCostsTotal;
  setText('initCostTotal', `${fmt(initTotal, 0)} 万円`);
  setText('simYearsLabel', String(p.simYears));

  // Sale section visibility
  const saleSection = document.getElementById('sale-section');
  if (saleSection) saleSection.hidden = !p.withSale;

  const base = simulate(p);
  const pess = simulate(pessimisticParams(p));

  // Year 1 summary
  if (base.y1) {
    const y = base.y1;
    setText('y1Rent', fmt(y.annualRent, 1) + '万円');
    setText('y1EffIncome', fmt(y.effectiveIncome, 1) + '万円');
    setText('y1Expenses', fmt(y.expenses, 1) + '万円');
    setText('y1LoanPay', fmt(y.loanPayment, 1) + '万円');
    const cfEl = document.getElementById('y1CF');
    if (cfEl) {
      cfEl.textContent = fmtSign(y.annualCF) + '万円';
      cfEl.className = 'y1cf-val ' + (y.annualCF >= 0 ? 'green' : 'red');
    }
  }

  // Cumulative
  setText('cumRent', fmt(base.totalRent, 0) + '万円');
  setText('cumExp', fmt(base.totalExp, 0) + '万円');
  setText('cumLoan', fmt(base.totalLoan, 0) + '万円');
  setText('cumCF', fmtSign(base.totalCF, 0) + '万円');
  const netEl = document.getElementById('netIncome');
  if (netEl) {
    netEl.textContent = fmtSign(base.netIncome, 0) + '万円';
    netEl.className = 'net-val ' + (base.netIncome >= 0 ? 'green' : 'red');
  }

  // Key metrics
  setText('breakEvenYear', base.breakEvenYear ? base.breakEvenYear + '年目' : `${p.simYears}年以内に未達`);
  setText('selfFundingYear', base.selfFundingYear ? base.selfFundingYear + '年目' : `${p.simYears}年以内に未達`);

  // Sale result
  const saleResult = document.getElementById('sale-result');
  if (p.withSale && base.saleProceeds !== null && saleResult) {
    saleResult.hidden = false;
    setText('saleProceeds', fmt(base.saleProceeds, 0) + '万円');
    const finalEl = document.getElementById('finalNetIncome');
    if (finalEl) {
      finalEl.textContent = fmtSign(base.finalNetIncome, 0) + '万円';
      finalEl.className = 'net-val ' + (base.finalNetIncome >= 0 ? 'green' : 'red');
    }
  } else if (saleResult) {
    saleResult.hidden = true;
  }

  // Scenario comparison
  setText('baseBreakEven', base.breakEvenYear ? base.breakEvenYear + '年目' : '未達');
  const baseY1CFEl = document.getElementById('baseY1CF');
  if (baseY1CFEl) {
    baseY1CFEl.textContent = base.y1 ? fmtSign(base.y1.annualCF) + '万円' : '—';
    baseY1CFEl.className = base.y1 && base.y1.annualCF >= 0 ? 'green' : 'red';
  }
  const baseNetEl = document.getElementById('baseNetIncome');
  if (baseNetEl) {
    baseNetEl.textContent = fmtSign(base.netIncome, 0) + '万円';
    baseNetEl.className = base.netIncome >= 0 ? 'green' : 'red';
  }
  setText('pessBreakEven', pess.breakEvenYear ? pess.breakEvenYear + '年目' : '未達');
  const pessY1El = document.getElementById('pessY1CF');
  if (pessY1El) {
    pessY1El.textContent = pess.y1 ? fmtSign(pess.y1.annualCF) + '万円' : '—';
    pessY1El.className = pess.y1 && pess.y1.annualCF >= 0 ? 'green' : 'red';
  }
  const pessNetEl = document.getElementById('pessNetIncome');
  if (pessNetEl) {
    pessNetEl.textContent = fmtSign(pess.netIncome, 0) + '万円';
    pessNetEl.className = pess.netIncome >= 0 ? 'green' : 'red';
  }

  // Chart
  const svgEl = document.getElementById('cf-chart') as SVGElement | null;
  if (svgEl) drawChart(svgEl, base, pess);

  // Table
  buildTable(base.rows);
}

// --- Sim year buttons ---
document.querySelectorAll('.year-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const year = (btn as HTMLElement).dataset.year;
    const input = document.getElementById('simYears') as HTMLInputElement | null;
    if (input && year) {
      input.value = year;
      document.querySelectorAll('.year-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      update();
    }
  });
});

// --- Loan hint ---
function updateLoanHint() {
  const pp = getNum('propertyPrice', 0);
  const dp = getNum('downPayment', 0);
  const hint = document.getElementById('loanHint');
  if (hint && pp > 0) {
    hint.textContent = `物件価格 − 頭金 = ${fmt(Math.max(0, pp - dp), 0)}万円（0のとき自動設定）`;
  }
}

// --- Wire up events ---
const cfInputs = document.getElementById('cf-inputs');
if (cfInputs) {
  cfInputs.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('input', update);
    el.addEventListener('change', update);
  });
}
['propertyPrice', 'downPayment'].forEach(id => {
  document.getElementById(id)?.addEventListener('input', updateLoanHint);
});

// --- Init ---
update();
updateLoanHint();
</script>
