---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';

const relatedArticles = [
  { href: '/articles/how-much-down-payment', tag: '頭金', title: '不動産投資の頭金はいくら必要？｜物件価格別の目安', desc: '物件価格帯別の頭金シミュレーションと準備の考え方' },
  { href: '/articles/real-estate-investment-basics', tag: '基礎知識', title: '不動産投資の基礎知識｜利回り・ROI・CFで何を見ればよいか', desc: '投資判断に必要な3指標の違いと使い方を初心者向けに解説' },
  { href: '/articles/cashflow-basics', tag: 'CF', title: '不動産投資のキャッシュフローとは｜計算方法と目安を解説', desc: 'ローン返済後の実態収支「手残り」の考え方を分かりやすく解説' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '住宅ローン返済シミュレーター',
    url: 'https://estate.kuras-plus.com/calculators/mortgage',
    description: '借入額・金利・返済年数を入力するだけで毎月返済額・総返済額・返済負担率を即計算。元利均等・元金均等の比較も可能な無料ツール。',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: '住宅ローン返済シミュレーター｜毎月返済額・総返済額を無料計算',
    url: 'https://estate.kuras-plus.com/calculators/mortgage',
    description: '借入額・金利・返済年数を入力するだけで毎月の返済額・総返済額・返済負担率を即計算。元利均等と元金均等の比較、返済スケジュール表示にも対応した無料住宅ローンシミュレーターです。',
    author: { '@type': 'Organization', name: '不動産ツールズ | kuras-plus' },
    publisher: {
      '@type': 'Organization',
      name: '不動産ツールズ | kuras-plus',
      url: 'https://estate.kuras-plus.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://estate.kuras-plus.com' },
      { '@type': 'ListItem', position: 2, name: '住宅ローン返済シミュレーター', item: 'https://estate.kuras-plus.com/calculators/mortgage' },
    ],
  },
];
---

<BaseLayout
  title="住宅ローン返済シミュレーター | 毎月返済額・総返済額を無料計算"
  description="借入額・金利・返済年数を入力するだけで毎月の返済額・総返済額・返済負担率を即計算。元利均等と元金均等の比較、返済スケジュール表示にも対応した無料住宅ローンシミュレーターです。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/mortgage" />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>住宅ローン返済シミュレーター</span>
      </nav>
      <p class="hero-eyebrow">Mortgage Simulator</p>
      <h1 class="hero-title">住宅ローン返済シミュレーター</h1>
      <p class="hero-desc">
        借入額・金利・返済年数を入力するだけで、<br />
        毎月の返済額・総返済額・返済負担率を即時算出します。
      </p>
    </div>
  </section>

  <!-- Article Body -->
  <div class="article-outer">
    <div class="container article-container">

      <!-- Summary Box -->
      <div class="summary-box">
        <p class="summary-title">このページで分かること</p>
        <ul class="summary-list">
          <li>住宅ローンの月々返済額と総返済額の計算方法</li>
          <li>元利均等返済と元金均等返済の違い</li>
          <li>返済期間・金利による支払い総額の変化</li>
          <li>返済負担率（年収に対する返済割合）の目安</li>
        </ul>
      </div>

      <!-- Section 1: 返済方式の基本 -->
      <section class="article-section" id="repayment-methods">
        <h2 class="article-h2">住宅ローン返済の基本 — 元利均等と元金均等の違い</h2>
        <p class="prose">
          住宅ローンの返済方式は主に「元利均等返済」と「元金均等返済」の2つです。
          どちらを選ぶかで、毎月の返済額・総返済額・総利息が大きく変わります。
        </p>

        <div class="formula-wrap">
          <div class="formula-card">
            <div class="formula-type">元利均等返済</div>
            <div class="formula-eq">毎月返済額 = 借入額 × 月利 × (1+月利)^n ÷ {(1+月利)^n − 1}</div>
            <p class="formula-note">毎月の返済額が一定で家計管理しやすい。返済初期は利息の割合が高い。</p>
          </div>
          <div class="formula-card formula-card--main">
            <div class="formula-type">元金均等返済</div>
            <div class="formula-eq">毎月返済額 = 借入額÷返済月数 + 残高×月利</div>
            <p class="formula-note">元金が毎月一定額減少し総利息は少なくなるが、返済初期の負担が大きい。</p>
          </div>
        </div>

        <div class="point-box">
          <p class="point-label">返済方式を選ぶときのポイント</p>
          <ul class="point-list">
            <li><strong>元利均等</strong>：毎月の支出が一定で、家計管理がしやすい。サラリーマンなど給与が安定している方向け</li>
            <li><strong>元金均等</strong>：総利息が少なく済む。返済初期に余裕があり、生涯収入が見込める方向け</li>
            <li>どちらを選ぶべきかは、現在と将来の収支状況で判断することが重要</li>
          </ul>
        </div>
      </section>

      <!-- Section 2: 返済負担率の目安 -->
      <section class="article-section" id="repayment-ratio">
        <h2 class="article-h2">返済負担率の目安と安全水準</h2>
        <p class="prose">
          返済負担率とは、年収に対する年間ローン返済額の割合のことです。
          金融機関の審査基準とは別に、実際の生活に無理が生じない水準を理解することが重要です。
        </p>

        <div class="table-wrap">
          <table class="benchmark-table">
            <thead>
              <tr>
                <th>返済負担率</th>
                <th>判定</th>
                <th>説明</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>20%以下</strong></td>
                <td class="cell-yes">余裕あり</td>
                <td>教育費・貯蓄・予備費など、他の支出に余裕が持てる水準</td>
              </tr>
              <tr>
                <td><strong>20〜25%</strong></td>
                <td class="cell-yes">適正範囲</td>
                <td>生活に無理がなく、ローン返済を継続できる目安</td>
              </tr>
              <tr>
                <td><strong>25〜30%</strong></td>
                <td class="cell-ok">やや負担大</td>
                <td>生活費を圧迫する可能性。将来の金利上昇時に要注意</td>
              </tr>
              <tr>
                <td><strong>30%超</strong></td>
                <td class="cell-no">要注意</td>
                <td>金融機関が審査基準としている水準。生活に支障が出やすい</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="note-box">
          <p><strong>重要：</strong>返済負担率は<strong>手取り年収</strong>をベースに計算してください。税引前の年収ではなく、実際に手元に残る金額で判断することが無理のない資金計画につながります。</p>
        </div>
      </section>

      <!-- CTA Banner -->
      <div class="cta-banner">
        <p class="cta-text">返済方式と負担率の目安が分かったところで、実際の条件で試算してみましょう。</p>
        <a href="#calculator" class="cta-btn">↓ シミュレーターで今すぐ試算する（無料）</a>
      </div>

      <!-- Section 3: Calculator -->
      <section class="tool-section" id="calculator">
        <h2 class="article-h2">🧮 住宅ローン返済シミュレーター（無料）</h2>
        <p class="tool-section-desc">
          借入額・金利・返済年数を入力するだけで、毎月返済額・総返済額・返済負担率を即計算します。
          元利均等・元金均等の比較も可能です。登録不要・完全無料でご利用いただけます。
        </p>

        <div class="calc-layout">

          <!-- ── Inputs ── -->
      <section class="card" aria-label="入力フォーム">
        <h2 class="card-heading">ローン条件を入力</h2>

        <p class="group-label">物件・借入情報</p>

        <!-- 物件価格 -->
        <div class="field-group">
          <div class="field-label">
            <label for="price">物件価格</label>
            <span class="field-display"><span id="priceDisplay">4,000</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="priceSlider"
            data-target="price" value="4000" min="100" max="20000" step="100" />
          <input class="field-input" type="number" id="price"
            value="4000" min="100" max="20000" step="100" inputmode="numeric"
            data-shared="shared-property-price" />
        </div>

        <!-- 頭金 -->
        <div class="field-group">
          <div class="field-label">
            <label for="down">頭金</label>
            <span class="field-display"><span id="downDisplay">800</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="downSlider"
            data-target="down" value="800" min="0" max="4000" step="50" />
          <input class="field-input" type="number" id="down"
            value="800" min="0" max="4000" step="50" inputmode="numeric"
            data-shared="shared-down-payment" />
          <p class="field-hint">物件価格の10〜20%が一般的。0円の場合はフルローンとして計算します。</p>
        </div>

        <!-- 借入額（自動計算） -->
        <div class="borrow-display">
          <span class="borrow-label">借入額（自動計算）</span>
          <span class="borrow-value" id="borrowDisplay">3,200 万円</span>
        </div>

        <hr class="divider" />
        <p class="group-label">返済条件</p>

        <!-- 年利 -->
        <div class="field-group">
          <div class="field-label">
            <label for="rate">年利（金利）</label>
            <span class="field-display"><span id="rateDisplay">1.5</span> %</span>
          </div>
          <input class="range-slider" type="range" id="rateSlider"
            data-target="rate" value="1.5" min="0" max="10" step="0.05" />
          <input class="field-input" type="number" id="rate"
            value="1.5" min="0" max="10" step="0.05" inputmode="decimal"
            data-shared="shared-loan-rate" />
          <p class="field-hint">変動金利：0.3〜1%台 / 固定10年：1〜2%台 / フラット35：1.8〜2.5%台（目安）</p>
        </div>

        <!-- 返済年数 -->
        <div class="field-group">
          <div class="field-label">
            <label for="years">返済年数</label>
            <span class="field-display"><span id="yearsDisplay">35</span> 年</span>
          </div>
          <input class="range-slider" type="range" id="yearsSlider"
            data-target="years" value="35" min="1" max="50" step="1" />
          <input class="field-input" type="number" id="years"
            value="35" min="1" max="50" step="1" inputmode="numeric"
            data-shared="shared-loan-years" />
        </div>

        <!-- 返済方式 -->
        <div class="field-group">
          <div class="field-label-text">返済方式</div>
          <div class="repay-toggle">
            <label class="repay-option">
              <input type="radio" name="repayType" value="equal-payment" checked />
              <span>元利均等返済</span>
            </label>
            <label class="repay-option">
              <input type="radio" name="repayType" value="equal-principal" />
              <span>元金均等返済</span>
            </label>
          </div>
          <p class="field-hint">元利均等：毎月同額で返済。元金均等：当初高く徐々に減少。</p>
        </div>

        <hr class="divider" />
        <p class="group-label">任意設定</p>

        <!-- ボーナス返済 -->
        <div class="field-group">
          <div class="field-label">
            <label for="bonus">ボーナス加算額（年2回）</label>
            <span class="field-display"><span id="bonusDisplay">0</span> 万円/回</span>
          </div>
          <input class="range-slider" type="range" id="bonusSlider"
            data-target="bonus" value="0" min="0" max="50" step="1" />
          <input class="field-input" type="number" id="bonus"
            value="0" min="0" max="50" step="1" inputmode="numeric" />
          <p class="field-hint">ボーナス月に上乗せする金額。0の場合はボーナス返済なし。</p>
        </div>

        <!-- 管理費・修繕積立金 -->
        <div class="field-group">
          <div class="field-label">
            <label for="fee">管理費・修繕積立金（月額）</label>
            <span class="field-display"><span id="feeDisplay">2</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="feeSlider"
            data-target="fee" value="2" min="0" max="20" step="0.5" />
          <input class="field-input" type="number" id="fee"
            value="2" min="0" max="20" step="0.5" inputmode="decimal" />
          <p class="field-hint">マンション購入の場合に入力。戸建てなら0でもOK。</p>
        </div>

        <!-- 年収 -->
        <div class="field-group">
          <div class="field-label-text">年収（返済負担率の表示に使用・任意）</div>
          <div class="income-row">
            <input class="field-input income-input" type="number" id="income"
              placeholder="例: 600" min="0" max="10000" step="50" inputmode="numeric" />
            <span class="income-unit">万円</span>
          </div>
          <p class="field-hint">入力すると「年収に占めるローン返済の割合」を表示します。</p>
        </div>
      </section>

      <!-- ── Results ── -->
      <section class="card results-card" aria-label="計算結果" aria-live="polite">
        <h2 class="card-heading">計算結果</h2>

        <div id="sampleBadge" class="sample-badge">
          <span>📋</span> サンプル値による計算例 — 値を変更すると即時更新されます
        </div>

        <div id="errorMsg" class="error-msg" hidden></div>

        <!-- Hero metrics -->
        <div class="hero-metrics">
          <div class="metric-box primary-box">
            <div class="metric-label">毎月返済額</div>
            <div class="metric-value" id="rMonthly">—</div>
          </div>
          <div class="metric-box">
            <div class="metric-label">総返済額</div>
            <div class="metric-value sm" id="rTotal">—</div>
          </div>
        </div>

        <!-- Sub metrics -->
        <div class="sub-metrics">
          <div class="sub-metric">
            <div class="sub-label">総利息</div>
            <div class="sub-value" id="rInterest">—</div>
          </div>
          <div class="sub-metric">
            <div class="sub-label">年間返済額</div>
            <div class="sub-value" id="rAnnual">—</div>
          </div>
          <div class="sub-metric">
            <div class="sub-label">借入額</div>
            <div class="sub-value" id="rBorrow">—</div>
          </div>
          <div class="sub-metric">
            <div class="sub-label">管理費込み月支払</div>
            <div class="sub-value" id="rWithFee">—</div>
          </div>
        </div>

        <!-- Bonus row -->
        <div id="bonusRow" class="info-row" hidden>
          <span class="info-row-label">ボーナス月返済額</span>
          <span class="info-row-value" id="rBonusMonthly">—</span>
        </div>

        <!-- Ratio row -->
        <div id="ratioRow" hidden>
          <div class="metric-box ratio-box" id="rRatioBox">
            <div class="metric-label">返済負担率（年収比）</div>
            <div class="metric-value sm" id="rRatio">—</div>
            <div class="metric-note" id="rRatioNote"></div>
          </div>
        </div>

        <!-- Comparison -->
        <p class="section-label mt-16">返済方式の比較</p>
        <table class="compare-table">
          <thead>
            <tr>
              <th></th>
              <th>元利均等</th>
              <th>元金均等</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="row-head">毎月返済額</td>
              <td id="cEPMonthly">—</td>
              <td class="range-cell"><span id="cEPRFirst">—</span><br /><small>〜 <span id="cEPRLast">—</span></small></td>
            </tr>
            <tr>
              <td class="row-head">総返済額</td>
              <td id="cEPTotal">—</td>
              <td id="cEPRTotal">—</td>
            </tr>
            <tr>
              <td class="row-head">総利息</td>
              <td id="cEPInterest">—</td>
              <td id="cEPRInterest">—</td>
            </tr>
          </tbody>
        </table>
        <p class="compare-note" id="cDiff"></p>

        <!-- Schedule -->
        <p class="section-label mt-16">返済スケジュール（年次・単位：万円）</p>
        <div class="schedule-wrap">
          <table class="schedule-table">
            <thead>
              <tr>
                <th>年</th>
                <th>返済額</th>
                <th>元金</th>
                <th>利息</th>
                <th>残高</th>
              </tr>
            </thead>
            <tbody id="scheduleBody"></tbody>
          </table>
        </div>

        <p class="result-disclaimer">
          ※ 元利均等・元金均等ともに概算です。ボーナス返済は年2回の加算として計算。
          団体信用生命保険料・税金・繰上返済は含まれていません。
        </p>
      </section>
    </div>
      </section>

      <!-- Section 4: 見落としがちなポイント -->
      <section class="article-section" id="important-points">
        <h2 class="article-h2">住宅ローンで見落としがちな4つのポイント</h2>
        <p class="prose">
          ローン返済額の計算だけでなく、以下のポイントを総合的に検討することが重要です。
        </p>

        <div class="reason-list">
          <div class="reason-item">
            <div class="reason-num">01</div>
            <div class="reason-body">
              <h3 class="reason-title">金利タイプ選びで総額が大きく変わる</h3>
              <p class="reason-desc">
                変動金利・固定10年・フラット35など、金利タイプの選択で総返済額が数百万円単位で変わります。
                現在は低金利が続いていますが、将来の金利上昇リスクも考慮した上で選択することが重要です。
                3年以上の長期保有を予定している場合、固定金利の安心感も検討値です。
              </p>
            </div>
          </div>
          <div class="reason-item">
            <div class="reason-num">02</div>
            <div class="reason-body">
              <h3 class="reason-title">繰り上げ返済の効果は早期ほど大きい</h3>
              <p class="reason-desc">
                余剰資金で繰り上げ返済を行うと、返済期間短縮と利息削減の両方の効果が得られます。
                ただし、繰り上げ返済のタイミングが早いほど効果が大きいため、
                税制優遇（住宅ローン減税）が終わる13年目以降の実行を計画することが一般的です。
              </p>
            </div>
          </div>
          <div class="reason-item">
            <div class="reason-num">03</div>
            <div class="reason-body">
              <h3 class="reason-title">返済負担率は手取りベースで考える</h3>
              <p class="reason-desc">
                返済負担率は<strong>税引後の手取り年収</strong>をベースに計算してください。
                年収600万円でも、手取りは450万円程度です。
                見かけの年収で判断すると、実生活で支払い負担が重くのしかかります。
              </p>
            </div>
          </div>
          <div class="reason-item">
            <div class="reason-num">04</div>
            <div class="reason-body">
              <h3 class="reason-title">諸費用（税金・手数料）を忘れない</h3>
              <p class="reason-desc">
                物件価格以外に、仲介手数料・登記費用・ローン事務手数料・火災保険料など、
                物件価格の5〜10%程度の諸費用がかかります。
                資金計画には物件価格だけでなく、これらの隠れコストを必ず含めましょう。
                詳しくは<a href="/calculators/fixed-asset-tax">固定資産税シミュレーター</a>で税額を確認することをお勧めします。
              </p>
            </div>
          </div>
        </div>
      </section>

    <!-- ── Related tools ── -->
    <section class="related-section mt-48">
