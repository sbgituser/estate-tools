</BaseLayout>

<style>
/* ── Layout ── */
.calc-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  align-items: start;
}
@media (max-width: 768px) {
  .calc-layout { grid-template-columns: 1fr; }
}

/* ── Card ── */
.card {
  background: var(--c-bg-card);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-lg);
  padding: 28px;
  box-shadow: var(--shadow-sm);
}
.card-heading {
  font-size: 1rem;
  font-weight: 700;
  color: var(--c-primary);
  margin-bottom: 20px;
}

/* ── Field group ── */
.group-label {
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--c-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 12px;
}
.field-group { margin-bottom: 16px; }
.field-label {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 4px;
}
.field-label label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--c-text);
}
.field-label-text {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 8px;
}
.field-display {
  font-size: 0.875rem;
  font-weight: 700;
  color: var(--c-primary);
  white-space: nowrap;
}
.field-hint { font-size: 0.72rem; color: var(--c-text-muted); margin-top: 3px; line-height: 1.5; }
.divider { border: none; border-top: 1px solid var(--c-border); margin: 18px 0 14px; }

/* ── Range slider ── */
.range-slider {
  width: 100%;
  height: 20px;
  -webkit-appearance: none;
  appearance: none;
  background: linear-gradient(
    to right,
    var(--c-primary) var(--pct, 0%),
    var(--c-border)  var(--pct, 0%)
  );
  border-radius: 2px;
  outline: none;
  cursor: pointer;
  padding: 0;
  margin: 0 0 6px;
  display: block;
}
.range-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 22px; height: 22px;
  border-radius: 50%;
  background: var(--c-primary);
  box-shadow: 0 1px 4px rgba(0,0,0,0.25);
  transition: transform 0.1s, background 0.1s;
}
.range-slider::-webkit-slider-thumb:hover,
.range-slider:active::-webkit-slider-thumb { background: var(--c-primary-hover); transform: scale(1.15); }
.range-slider::-moz-range-thumb {
  width: 22px; height: 22px;
  border-radius: 50%;
  background: var(--c-primary);
  border: none;
  box-shadow: 0 1px 4px rgba(0,0,0,0.25);
}

/* ── Number input ── */
.field-input {
  width: 100%;
  padding: 7px 10px;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  font-size: 0.875rem;
  font-family: var(--font);
  color: var(--c-text);
  background: var(--c-bg);
  transition: border-color 0.15s;
  -moz-appearance: textfield;
}
.field-input::-webkit-outer-spin-button,
.field-input::-webkit-inner-spin-button { -webkit-appearance: none; }
.field-input:focus {
  outline: none;
  border-color: var(--c-primary);
  box-shadow: 0 0 0 2px rgba(26,74,58,0.1);
}

/* ── Borrow display ── */
.borrow-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(26,74,58,0.06);
  border: 1px solid rgba(26,74,58,0.18);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  margin-bottom: 4px;
}
.borrow-label { font-size: 0.8rem; color: var(--c-text-muted); font-weight: 600; }
.borrow-value { font-size: 1rem; font-weight: 700; color: var(--c-primary); }

/* ── Repay toggle ── */
.repay-toggle {
  display: flex;
  gap: 8px;
}
.repay-option {
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  padding: 8px 14px;
  border: 1px solid var(--c-border);
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--c-text-muted);
  transition: border-color 0.15s, background 0.15s, color 0.15s;
  flex: 1;
  justify-content: center;
}
.repay-option:has(input:checked) {
  border-color: var(--c-primary);
  background: rgba(26,74,58,0.06);
  color: var(--c-primary);
}
.repay-option input { display: none; }

/* ── Income row ── */
.income-row { display: flex; align-items: center; gap: 8px; }
.income-input { flex: 1; }
.income-unit { font-size: 0.82rem; color: var(--c-text-muted); white-space: nowrap; }

/* ── Sample badge ── */
.sample-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(201,148,58,0.10);
