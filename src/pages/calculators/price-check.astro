<script define:vars={{ citiesForClient }}>
// ══════════════════════════════════════════════════════
// 地域データ（cities.json から注入）+ フォールバック相場データ
// ══════════════════════════════════════════════════════

/** @type {Record<string, {avg_price_man: number, avg_sqm_price: number, avg_area_m2: number}>} */
const MARKET_DATA = {
  // フォールバック: cities.json に avg_price_man がない場合の参考値
  // （国土交通省・不動産情報ライブラリ 2023年成約データ参考）
  shibuya:  { avg_price_man: 7500,  avg_sqm_price: 130, avg_area_m2: 58 },
  minato:   { avg_price_man: 9800,  avg_sqm_price: 155, avg_area_m2: 63 },
  setagaya: { avg_price_man: 5200,  avg_sqm_price: 87,  avg_area_m2: 60 },
  meguro:   { avg_price_man: 6800,  avg_sqm_price: 112, avg_area_m2: 61 },
  shinjuku: { avg_price_man: 5800,  avg_sqm_price: 95,  avg_area_m2: 61 },
};

// cities.json から注入されたデータで上書き
citiesForClient.forEach((c) => {
  if (c.avg_price_man) {
    MARKET_DATA[c.slug] = {
      avg_price_man: c.avg_price_man,
      avg_sqm_price: c.avg_sqm_price ?? Math.round(c.avg_price_man * 10000 / (c.avg_area_m2 ?? 60)),
      avg_area_m2:   c.avg_area_m2  ?? 60,
    };
  }
});

// ══════════════════════════════════════════════════════
// 判定閾値（定数化 — 調整はここだけ）
// ══════════════════════════════════════════════════════
const THRESHOLDS = {
  BARGAIN:   -0.15,  // -15% 以下 → 割安
  CHEAP:     -0.05,  // -15%超 〜 -5% 以下 → やや割安
  FAIR_HIGH:  0.05,  // -5%超 〜 +5% 未満 → 相場通り
  PRICEY:     0.15,  // +5%〜 +15% 未満 → やや割高
  // +15% 以上 → 割高
};

const VERDICT_CONFIG = {
  bargain:   { label: '割安',     icon: '🟢', color: '#2d7a4f', bg: '#edf7f1' },
  cheap:     { label: 'やや割安', icon: '🔵', color: '#1a6a8a', bg: '#eaf4f8' },
  fair:      { label: '相場通り', icon: '⚪', color: '#555',    bg: '#f5f5f5' },
  pricey:    { label: 'やや割高', icon: '🟡', color: '#b8760f', bg: '#fdf6e3' },
  expensive: { label: '割高',     icon: '🔴', color: '#c0392b', bg: '#fdecea' },
};

// 築年数補正係数（参考値 — RC造中古マンション想定）
function ageAdjustCoef(age) {
  if (age <= 5)  return 1.0;
  if (age <= 10) return 0.95;
  if (age <= 15) return 0.90;
  if (age <= 20) return 0.83;
  if (age <= 25) return 0.76;
  if (age <= 30) return 0.68;
  return 0.60;
}

// ══════════════════════════════════════════════════════
// DOM 参照
// ══════════════════════════════════════════════════════
const citySelect      = document.getElementById('city');
const priceInput      = document.getElementById('price');
const areaInput       = document.getElementById('area');
const ageInput        = document.getElementById('age');
const stationInput    = document.getElementById('stationMin');
const floorInput      = document.getElementById('floor');
const directionInput  = document.getElementById('direction');
const errorMsg        = document.getElementById('errorMsg');

const verdictBanner   = document.getElementById('verdictBanner');
const verdictIcon     = document.getElementById('verdictIcon');
const verdictLabel    = document.getElementById('verdictLabel');
const verdictSub      = document.getElementById('verdictSub');

const compareBarWrap  = document.getElementById('compareBarWrap');
const compareNeedle   = document.getElementById('compareNeedle');
const compareBarPct   = document.getElementById('compareBarPct');

const resultGrid      = document.getElementById('resultGrid');
const inputPriceDisp  = document.getElementById('inputPriceDisp');
const avgPriceDisp    = document.getElementById('avgPriceDisp');
const diffDisp        = document.getElementById('diffDisp');
const ratioDisp       = document.getElementById('ratioDisp');
const sqmInputDisp    = document.getElementById('sqmInputDisp');
const sqmAvgDisp      = document.getElementById('sqmAvgDisp');

const ageNote         = document.getElementById('ageNote');
const ageNoteText     = document.getElementById('ageNoteText');
const paymentImpact   = document.getElementById('paymentImpact');
const impactBody      = document.getElementById('impactBody');
const verdictComment  = document.getElementById('verdictComment');
const commentBody     = document.getElementById('commentBody');
const commentNotes    = document.getElementById('commentNotes');
const noDataMsg       = document.getElementById('noDataMsg');

// ══════════════════════════════════════════════════════
// 市区町村セレクトを初期化
// ══════════════════════════════════════════════════════
function initCitySelect() {
  citiesForClient.forEach((c) => {
    const opt = document.createElement('option');
    opt.value = c.slug;
    opt.textContent = `${c.name}（${c.prefecture}）`;
    citySelect.appendChild(opt);
  });
}

// ══════════════════════════════════════════════════════
// フォーマットヘルパー
// ══════════════════════════════════════════════════════
function fmt(man) {
  if (man >= 10000) return `${(man / 10000).toFixed(2)}億円`;
  return `${man.toLocaleString('ja-JP')}万円`;
}
function fmtDiff(diff) {
  const sign = diff >= 0 ? '+' : '';
  return `${sign}${diff.toLocaleString('ja-JP')}万円`;
}

// ══════════════════════════════════════════════════════
// 判定ロジック
// ══════════════════════════════════════════════════════
function getVerdictKey(ratio) {
  if (ratio <= THRESHOLDS.BARGAIN)   return 'bargain';
  if (ratio <= THRESHOLDS.CHEAP)     return 'cheap';
  if (ratio <  THRESHOLDS.FAIR_HIGH) return 'fair';
  if (ratio <  THRESHOLDS.PRICEY)    return 'pricey';
  return 'expensive';
}

// ㎡単価と総額の比率を加重平均（面積が小さいほど㎡単価を重視）
function blendRatio(totalRatio, sqmRatio, area) {
  const sqmWeight = area < 40 ? 0.7 : area < 70 ? 0.5 : 0.4;
  return sqmRatio * sqmWeight + totalRatio * (1 - sqmWeight);
}

// 返済額への影響（元利均等・金利1.5%・35年想定）
function monthlyPayment(priceMan) {
  const principal = priceMan * 10000 * 0.9; // 頭金10%想定
  const rate = 0.015 / 12;
  const n = 35 * 12;
  return Math.round(principal * rate * Math.pow(1 + rate, n) / (Math.pow(1 + rate, n) - 1));
}

// ══════════════════════════════════════════════════════
// コメント生成
// ══════════════════════════════════════════════════════
function buildComment(verdictKey, ratio, diff, area, age, station, floor, direction, cityName) {
  const pct = Math.abs(Math.round(ratio * 100));
  const sign = ratio >= 0 ? '高め' : '低め';

  const main = {
    bargain:   `${cityName}の地域平均より約${pct}%割安な水準です。価格が安い理由を必ず確認してください。`,
    cheap:     `${cityName}の地域平均よりやや割安な水準です。掘り出し物の可能性がある一方、個別リスクも確認を。`,
    fair:      `${cityName}の地域平均とほぼ同水準です。相場通りの適正価格と考えられます。`,
    pricey:    `${cityName}の地域平均よりやや割高な水準です。価格に見合う理由（立地・状態・設備等）を確認しましょう。`,
    expensive: `${cityName}の地域平均より約${pct}%割高な水準です。購入する場合は価格上乗せの理由を十分確認してください。`,
  }[verdictKey];

  const notes = [];
  if (station) {
    if (station <= 5)       notes.push(`駅徒歩${station}分は好立地。価格に立地プレミアムが上乗せされている可能性があります。`);
    else if (station >= 15) notes.push(`駅徒歩${station}分は遠め。流動性（売りやすさ）に注意が必要です。`);
  }
  if (floor) {
    if (floor >= 10) notes.push(`${floor}階以上の高層は眺望・日照が良好で、低層比で5〜15%程度高い傾向があります。`);
    else if (floor <= 2) notes.push(`低層階は価格が低い傾向がありますが、日照・防犯の観点も確認してください。`);
  }
  if (direction) {
    if (direction === '南' || direction === '東南') notes.push(`${direction}向きは日当たりが良く人気があり、価格に反映されやすい方角です。`);
    else if (direction === '北') notes.push(`北向きは日当たりが少ないため価格が低め。冬の結露・採光に注意。`);
  }
  if (age >= 25) notes.push(`築${age}年超の物件は大規模修繕の時期・修繕積立金の充足状況を必ず確認してください。`);
  else if (age >= 15) notes.push(`築${age}年の物件は、今後の大規模修繕計画を確認することをおすすめします。`);

  notes.push('このツールは地域平均との概算比較です。実際の価格は個別状態・管理状況・成約事例で異なります。');

  return { main, notes };
}

// ══════════════════════════════════════════════════════
// UI 更新
// ══════════════════════════════════════════════════════
function showError(msg) {
  errorMsg.textContent = msg;
  errorMsg.hidden = false;
}
function clearError() {
  errorMsg.textContent = '';
  errorMsg.hidden = true;
}

function resetResult() {
  compareBarWrap.hidden = true;
  resultGrid.hidden     = true;
  ageNote.hidden        = true;
  paymentImpact.hidden  = true;
  verdictComment.hidden = true;
  noDataMsg.hidden      = true;
  verdictBanner.style.background   = '';
  verdictBanner.style.borderColor  = '';
  verdictIcon.textContent  = '🔍';
  verdictLabel.textContent = '左の入力欄に情報を入力してください';
  verdictSub.textContent   = '物件価格・面積・地域を入力すると結果が表示されます';
  verdictLabel.style.color = '';
}

function updateNeedle(ratio) {
  // 比較バー: -30%〜+30% を 0〜100% にマッピング
  const clamp = Math.max(-0.30, Math.min(0.30, ratio));
  const pct   = ((clamp + 0.30) / 0.60) * 100;
  compareNeedle.style.left = `${pct}%`;
  const sign = ratio >= 0 ? '+' : '';
  compareBarPct.textContent = `相場比 ${sign}${Math.round(ratio * 100)}%`;
  compareBarWrap.hidden = false;
}

function calculate() {
  clearError();
  resetResult();

  const slug    = citySelect.value;
  const price   = parseFloat(priceInput.value);
  const area    = parseFloat(areaInput.value);
  const age     = parseFloat(ageInput.value) || 0;
  const station = parseFloat(stationInput.value) || null;
  const floor   = parseFloat(floorInput.value) || null;
  const dir     = directionInput.value || null;

  // バリデーション
  if (!price || price <= 0) { showError('入力価格を入力してください。'); return; }
  if (!area  || area  <= 0) { showError('専有面積を入力してください。'); return; }
  if (price < 100)          { showError('物件価格が小さすぎます。万円単位で入力してください。'); return; }
  if (area  < 10)           { showError('面積が小さすぎます。㎡単位で入力してください。'); return; }

  const market = MARKET_DATA[slug];
  if (!market) {
    noDataMsg.hidden = false;
    return;
  }

  const cityName   = citiesForClient.find(c => c.slug === slug)?.name ?? slug;
  const avgPrice   = market.avg_price_man;    // 万円
  const avgSqm     = market.avg_sqm_price;    // 万円/㎡
  const inputSqm   = price / area;            // 万円/㎡

  // 比率計算
  const totalRatio = (price - avgPrice) / avgPrice;
  const sqmRatio   = (inputSqm - avgSqm)   / avgSqm;
  const blended    = blendRatio(totalRatio, sqmRatio, area);

  const verdictKey = getVerdictKey(blended);
  const cfg        = VERDICT_CONFIG[verdictKey];

  // ── 判定バナー
  verdictBanner.style.background  = cfg.bg;
  verdictBanner.style.borderColor = cfg.color;
  verdictIcon.textContent  = cfg.icon;
  verdictLabel.textContent = cfg.label;
  verdictLabel.style.color = cfg.color;
  verdictSub.textContent   = `地域平均（${cityName}）との比較結果`;

  // ── 比較バー
  updateNeedle(blended);

  // ── 数値カード
  const diff = Math.round(price - avgPrice);
  inputPriceDisp.textContent = fmt(price);
  avgPriceDisp.textContent   = fmt(avgPrice);
  diffDisp.textContent       = fmtDiff(diff);
  diffDisp.style.color       = diff > 0 ? '#c0392b' : diff < 0 ? '#2d7a4f' : '#555';
  ratioDisp.textContent      = `${blended >= 0 ? '+' : ''}${Math.round(blended * 100)}%`;
  ratioDisp.style.color      = cfg.color;
  sqmInputDisp.textContent   = `${inputSqm.toFixed(1)}万円/㎡`;
  sqmAvgDisp.textContent     = `${avgSqm.toFixed(1)}万円/㎡`;
  resultGrid.hidden = false;

  // ── 築年数補正コメント
  if (age > 0) {
    const coef = ageAdjustCoef(age);
    const adjustedPrice = Math.round(avgPrice * coef);
    const adjustedRatio = (price - adjustedPrice) / adjustedPrice;
    const adjSign = adjustedRatio >= 0 ? '+' : '';
    ageNoteText.textContent =
      `築${age}年補正後の概算相場は約${fmt(adjustedPrice)}（補正係数×${coef}）。補正後比較では${adjSign}${Math.round(adjustedRatio * 100)}%です（参考値）。`;
    ageNote.hidden = false;
  }

  // ── 返済額への影響
  if (Math.abs(diff) >= 100) {
    const myPayment  = monthlyPayment(price);
    const avgPayment = monthlyPayment(avgPrice);
    const payDiff    = myPayment - avgPayment;
    const sign       = payDiff >= 0 ? '+' : '';
    impactBody.textContent =
      `入力価格でローンを組む場合、地域平均価格と比べて月々の返済額が約${sign}${Math.abs(payDiff).toLocaleString()}円異なります（金利1.5%・35年・頭金10%の場合）。`;
    paymentImpact.hidden = false;
  }

  // ── 判定コメント
  const { main, notes } = buildComment(verdictKey, blended, diff, area, age, station, floor, dir, cityName);
  commentBody.textContent = main;
  commentNotes.innerHTML  = notes.map(n => `<li>${n}</li>`).join('');
  verdictComment.hidden   = false;
}

// ══════════════════════════════════════════════════════
// イベントリスナー
// ══════════════════════════════════════════════════════
document.addEventListener('DOMContentLoaded', () => {
  initCitySelect();

  // 初期値セット
  priceInput.value = '4500';
  areaInput.value  = '55';
  ageInput.value   = '15';

  // 初回計算
  calculate();

  // リアルタイム再計算
  [citySelect, priceInput, areaInput, ageInput, stationInput, floorInput, directionInput].forEach((el) => {
    el?.addEventListener('input',  calculate);
    el?.addEventListener('change', calculate);
  });
});
</script>

