---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import citiesData from '../../data/cities.json';

// Build a serializable subset for the client script
const citiesForClient = citiesData.map((c) => ({
  slug:          c.slug,
  name:          c.name,
  prefecture:    c.prefecture,
  avg_price_man: (c as any).avg_price_man ?? null,
  avg_sqm_price: (c as any).avg_sqm_price ?? null,
  avg_area_m2:   (c as any).avg_area_m2  ?? null,
}));

const faqItems = [
  {
    q: '不動産価格が適正かどうかはどうやって判断しますか？',
    a: '主に「相場（エリア平均との比較）」「利回り（投資用の場合）」「将来性（エリアの人口・開発動向）」の3軸で総合判断します。1つだけで判断すると見誤るリスクが高いため、このツールで相場比較をしたあと、利回り・ROI・CFの順に確認していくことをお勧めします。',
  },
  {
    q: '不動産の相場はどこで調べられますか？',
    a: '国土交通省の「不動産情報ライブラリ」（成約事例データ）が最も信頼性の高い公的情報源です。また、大手不動産ポータルサイト（SUUMO・at home等）の売出事例や、複数の不動産会社への査定依頼も有効です。このツールはそれらのデータを参考にした地域平均との概算比較を提供しています。',
  },
  {
    q: '利回りだけで物件を判断していいですか？',
    a: '利回りだけでの判断はリスクがあります。例えば地方の高利回り物件でも、空室率が高く実際の収益が低い場合や、修繕費が膨大にかかる場合があります。まず価格の妥当性を確認し、次に表面利回り→実質利回り→ROI→CFの順で確認することで、より正確な投資判断ができます。',
  },
  {
    q: '相場より安い物件はお得ですか？',
    a: '必ずしもそうではありません。相場より安い物件には修繕積立金の不足・建物の瑕疵・法的問題（再建築不可等）・事故物件・管理組合の機能不全など、価格に反映されていないリスクが潜んでいることがあります。「安い理由」を必ず確認し、ホームインスペクション（建物調査）も検討してください。',
  },
  {
    q: '市区町村平均だけで価格判断してよいですか？',
    a: '市区町村平均はあくまで参考値です。同じ区内でも駅距離・路線・築年数・管理状態によって数百万〜数千万円の差が生じます。このツールの判定は「相場との大まかな比較」として活用し、個別物件の判断には周辺成約事例の確認と専門家への相談を合わせて行ってください。',
  },
  {
    q: '価格チェックの後、何を確認すればよいですか？',
    a: '価格が妥当と確認できたら、次は①利回り計算で物件の収益力を確認、②ROI計算で自己資金効率を確認、③CFシミュレーターでローン返済後の手残りを確認、という順番が現実的です。また、修繕費シミュレーターで長期コストも見込んでおくと安心です。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '不動産価格妥当性チェッカー',
    url: 'https://estate.kuras-plus.com/calculators/price-check',
    description: '物件価格が地域相場に対して割安か割高かを即判定。中古マンションの㎡単価・価格差を分かりやすく表示。',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: '不動産価格は高い？安い？｜相場と比較できるチェックツール',
    url: 'https://estate.kuras-plus.com/calculators/price-check',
    description: '不動産価格が適正かをチェック。相場・利回り・将来性から判断する方法と、すぐ試せるシミュレーター付き。',
    author: { '@type': 'Organization', name: '不動産ツールズ | kuras-plus' },
    publisher: { '@type': 'Organization', name: '不動産ツールズ | kuras-plus', url: 'https://estate.kuras-plus.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム',               item: 'https://estate.kuras-plus.com' },
      { '@type': 'ListItem', position: 2, name: '価格妥当性チェッカー', item: 'https://estate.kuras-plus.com/calculators/price-check' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
];

const relatedTools = [
  { href: '/calculators/yield',               icon: '📊', title: '不動産利回り計算ツール',           desc: '価格確認後に収益性を利回りで確認' },
  { href: '/calculators/roi',                 icon: '💹', title: 'ROI計算ツール',                    desc: '自己資金ベースの投資効率を確認' },
  { href: '/calculators/cash-flow',           icon: '💰', title: 'CFシミュレーター',                 desc: 'ローン返済後の年間手残りを試算' },
  { href: '/calculators/rent-vacancy-impact', icon: '📉', title: '家賃下落・空室率影響シミュレーター', desc: '想定収益が崩れた場合の耐性確認' },
  { href: '/calculators/repair-cost',         icon: '🔧', title: '修繕費シミュレーター',             desc: '長期修繕コストをROIに織り込む' },
  { href: '/calculators/mortgage',            icon: '🏦', title: '住宅ローン返済シミュレーター',      desc: '価格差が月々の返済額に与える影響' },
];

const relatedArticles = [
  { href: '/articles/gross-vs-net-yield',    tag: '利回り解説', title: '表面利回りと実質利回りの違い｜計算式と投資判断への使い方',  desc: '利回りの種類と投資判断での使い分けを解説' },
  { href: '/articles/roi-vs-yield',          tag: 'ROI解説',   title: 'ROIと利回りの違い｜不動産投資2つの収益指標を徹底比較',     desc: '自己資金ベースの収益率と物件収益力の違い' },
  { href: '/articles/cashflow-basics',       tag: 'CF解説',    title: '不動産投資のキャッシュフローとは｜計算方法と目安を解説',   desc: 'ローン返済後の手残りの計算方法と確認手順' },
  { href: '/articles/how-much-down-payment', tag: '頭金',      title: '頭金はいくら必要か｜不動産投資の自己資金の目安と考え方',   desc: '頭金の目安とROI・CFへの影響を解説' },
];
---

<BaseLayout
  title="不動産価格は高い？安い？｜相場と比較できるチェックツール"
  description="不動産価格が適正かをチェック。相場・利回り・将来性から判断する方法と、すぐ試せるシミュレーター付き。中古マンションの㎡単価・価格差を即表示。"
  canonical="https://estate.kuras-plus.com/calculators/price-check"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/price-check" />

  <!-- ── Hero ── -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>価格妥当性チェッカー</span>
      </nav>
      <p class="hero-eyebrow">Price Check · 解説＋チェックツール</p>
      <h1 class="hero-title">不動産価格は高い？安い？</h1>
      <p class="hero-desc">
        相場と比較できるチェックツール付き。<br />
        価格判断の3つの基準と実践的な確認手順を解説します。
      </p>
    </div>
  </section>

  <!-- ── Pre-tool article ── -->
  <div class="article-outer">
    <div class="article-container">

      <!-- Summary + Quick Points + CTA -->
      <div class="lead-block">
        <div class="lead-points">
          <p class="lead-title">このページで分かること</p>
          <ul class="lead-list">
            <li>物件価格が地域相場に対して割安・相場通り・割高のどれかを即確認</li>
            <li>価格妥当性を判断する3つの基準（相場・利回り・将来性）</li>
            <li>高値掴みを避けるためのよくある失敗パターン</li>
            <li>価格確認後に進むべき投資判断ステップ</li>
          </ul>
        </div>
        <div class="lead-checklist">
          <p class="lc-title">価格判断の3ポイント</p>
          <div class="lc-items">
            <div class="lc-item">
              <span class="lc-num">01</span>
              <div>
                <strong>㎡単価で比べる</strong>
                <p>総額ではなく面積あたりの価格で比較する</p>
              </div>
            </div>
            <div class="lc-item">
              <span class="lc-num">02</span>
              <div>
                <strong>利回りも確認する</strong>
                <p>相場内でも利回りが低い物件は投資メリットが薄い</p>
              </div>
            </div>
            <div class="lc-item">
              <span class="lc-num">03</span>
              <div>
                <strong>安さの理由を確認する</strong>
                <p>相場より安い物件には必ず理由がある</p>
              </div>
            </div>
          </div>
        </div>
        <a href="#checker" class="lead-cta">まず価格をチェックする ↓</a>
      </div>

      <!-- H2: なぜ難しいか -->
      <section class="art-section">
        <h2 class="art-h2">不動産価格の判断はなぜ難しいか</h2>
        <p class="art-prose">
          不動産の価格は、同じ市区町村でも「どの駅か」「築何年か」「何階か」「管理状態はどうか」によって
          大きく変わります。ネットで調べた相場が必ずしも目の前の物件に当てはまるとは限りません。
        </p>
        <div class="why-grid">
          <div class="why-card">
            <div class="why-icon">📍</div>
            <h3 class="why-title">エリア内でも価格差が大きい</h3>
            <p class="why-desc">同じ区内でも駅徒歩5分と15分では数百万〜1,000万円以上の差が出ることがあります。市区町村平均は「おおよその水準」に過ぎません。</p>
          </div>
          <div class="why-card">
            <div class="why-icon">🏚️</div>
            <h3 class="why-title">築年数の影響が非線形</h3>
            <p class="why-desc">築年数による価格下落は一定ではありません。人気エリアでは築30年でも高値が続く一方、郊外では築15年から急落するケースもあります。</p>
          </div>
          <div class="why-card">
            <div class="why-icon">🔍</div>
            <h3 class="why-title">見えないリスクが価格に含まれる</h3>
            <p class="why-desc">修繕積立金の不足、管理組合の問題、建物の瑕疵など、目で見えないリスクが価格に反映されている場合があります。</p>
          </div>
        </div>
      </section>

      <!-- H2: 3つの基準 -->
      <section class="art-section">
        <h2 class="art-h2">価格妥当性を判断する3つの基準</h2>
        <p class="art-prose">
          「価格が高いか安いか」は1つの視点だけでは判断できません。
          以下の3軸で総合的に見ることが重要です。
        </p>
        <div class="criteria-list">
          <div class="criteria-item">
            <div class="criteria-badge criteria-badge--1">基準 1</div>
            <div class="criteria-body">
              <h3 class="criteria-title">相場（エリア）との比較</h3>
              <p class="criteria-desc">
                地域平均の㎡単価・成約事例と比較して、価格水準が適正かを確認します。
                このチェックツールがカバーしているのがこの「相場比較」です。
                ただし相場内でも個別物件の条件によって価値は変わります。
              </p>
            </div>
          </div>
          <div class="criteria-item">
            <div class="criteria-badge criteria-badge--2">基準 2</div>
            <div class="criteria-body">
              <h3 class="criteria-title">利回り（投資収益性）</h3>
              <p class="criteria-desc">
                投資目的の場合、価格が相場内であっても利回りが低ければ投資メリットが薄くなります。
                逆に相場より少し高くても利回りが高い物件には価値があります。
                <a href="/calculators/yield">利回り計算ツール</a>で確認してください。
              </p>
            </div>
          </div>
          <div class="criteria-item">
            <div class="criteria-badge criteria-badge--3">基準 3</div>
            <div class="criteria-body">
              <h3 class="criteria-title">将来性（エリアの成長性）</h3>
              <p class="criteria-desc">
                現在の相場が同じでも、人口増加エリア・再開発計画があるエリアは将来的な資産価値の維持・上昇が期待できます。
                逆に人口減少エリアでは現在が割安でも長期的には価値が下がるリスクがあります。
              </p>
            </div>
          </div>
        </div>

        <!-- CTA Banner -->
        <div class="cta-banner">
          <div class="cta-banner-text">
            <p>まず相場との比較から始めましょう。</p>
            <p class="cta-sub">物件価格・面積・エリアを入力するだけで相場比較が即座に確認できます。</p>
          </div>
          <a href="#checker" class="cta-banner-btn">価格をチェックする ↓</a>
        </div>
      </section>

    </div>
  </div>

  <!-- ── Calculator ── -->
  <div class="container tool-section" id="checker">
    <h2 class="section-title tool-heading">🔍 価格妥当性チェッカー</h2>
    <p class="tool-desc">物件価格・専有面積・エリアを入力すると、地域相場との比較をリアルタイムで表示します。</p>

    <div class="calc-layout">

      <!-- ── Inputs ── -->
      <section class="card" aria-label="入力フォーム">
        <h2 class="card-heading">物件情報を入力</h2>

        <!-- 物件種別 -->
        <div class="field-group">
          <label class="field-label" for="propertyType">物件種別</label>
          <select class="field-select" id="propertyType">
            <option value="mansion">中古マンション</option>
            <option value="house" disabled>戸建て（近日対応予定）</option>
            <option value="land"  disabled>土地（近日対応予定）</option>
          </select>
        </div>

        <!-- 都道府県 -->
        <div class="field-group">
          <label class="field-label" for="prefecture">都道府県</label>
          <select class="field-select" id="prefecture">
            <option value="東京都">東京都</option>
          </select>
          <p class="field-hint">※ 現在は東京都内の主要区に対応。順次拡充予定。</p>
        </div>

        <!-- 市区町村 -->
        <div class="field-group">
          <label class="field-label" for="city">市区町村</label>
          <select class="field-select" id="city">
            <!-- JS で動的生成 -->
          </select>
        </div>

        <hr class="divider" />

        <!-- 物件価格 -->
        <div class="field-group">
          <label class="field-label" for="price">
            入力価格
            <span class="field-unit">万円</span>
          </label>
          <input class="field-input" type="number" id="price"
            placeholder="4500" min="100" max="99999" step="50" inputmode="numeric" />
        </div>

        <!-- 専有面積 -->
        <div class="field-group">
          <label class="field-label" for="area">
            専有面積
            <span class="field-unit">㎡</span>
          </label>
          <input class="field-input" type="number" id="area"
            placeholder="55" min="10" max="500" step="0.5" inputmode="decimal" />
        </div>

        <!-- 築年数 -->
        <div class="field-group">
          <label class="field-label" for="age">
            築年数
            <span class="field-unit">年</span>
          </label>
          <input class="field-input" type="number" id="age"
            placeholder="15" min="0" max="60" step="1" inputmode="numeric" />
          <p class="field-hint">築年数補正は参考表示として反映します。</p>
        </div>

        <hr class="divider" />

        <!-- 任意項目 -->
        <details class="optional-block">
          <summary class="optional-summary">任意項目（駅距離・階数・方角）</summary>
          <div class="optional-body">
            <div class="field-group">
              <label class="field-label" for="stationMin">
                最寄駅徒歩
                <span class="field-unit">分</span>
              </label>
              <input class="field-input" type="number" id="stationMin"
                placeholder="7" min="1" max="60" step="1" inputmode="numeric" />
            </div>
            <div class="field-group">
              <label class="field-label" for="floor">
                階数
                <span class="field-unit">階</span>
              </label>
              <input class="field-input" type="number" id="floor"
                placeholder="5" min="1" max="60" step="1" inputmode="numeric" />
            </div>
            <div class="field-group">
              <label class="field-label" for="direction">方角</label>
              <select class="field-select" id="direction">
                <option value="">選択なし</option>
                <option value="南">南向き</option>
                <option value="東南">東南向き</option>
                <option value="東">東向き</option>
                <option value="西南">西南向き</option>
                <option value="西">西向き</option>
                <option value="北東">北東向き</option>
                <option value="北西">北西向き</option>
                <option value="北">北向き</option>
              </select>
            </div>
            <p class="optional-note">※ これらの情報は判定の参考コメントに反映されます（判定スコア自体は変わりません）。</p>
          </div>
        </details>

        <!-- エラー表示 -->
        <p class="error-msg" id="errorMsg" hidden></p>
      </section>

      <!-- ── Results ── -->
      <section class="card result-section" id="resultSection" aria-label="判定結果" aria-live="polite">
        <!-- 判定ラベル -->
        <div class="verdict-banner" id="verdictBanner">
          <span class="verdict-icon" id="verdictIcon">🔍</span>
          <div>
            <p class="verdict-label" id="verdictLabel">左の入力欄に情報を入力してください</p>
            <p class="verdict-sub"  id="verdictSub">物件価格・面積・地域を入力すると結果が表示されます</p>
          </div>
        </div>

        <!-- 比較バー -->
        <div class="compare-bar-wrap" id="compareBarWrap" hidden>
          <div class="compare-bar-label">
            <span>割安</span><span>相場通り</span><span>割高</span>
          </div>
          <div class="compare-bar-track">
            <div class="compare-bar-zones">
              <div class="zone zone-bargain"  title="割安"></div>
              <div class="zone zone-cheap"    title="やや割安"></div>
              <div class="zone zone-fair"     title="相場通り"></div>
              <div class="zone zone-pricey"   title="やや割高"></div>
              <div class="zone zone-expensive"title="割高"></div>
            </div>
            <div class="compare-bar-needle" id="compareNeedle"></div>
          </div>
          <p class="compare-bar-pct" id="compareBarPct"></p>
        </div>

        <!-- 数値カード -->
        <div class="result-grid" id="resultGrid" hidden>
          <div class="result-card">
            <p class="result-card-label">入力価格</p>
            <p class="result-card-value primary" id="inputPriceDisp">—</p>
          </div>
          <div class="result-card">
            <p class="result-card-label">地域平均価格</p>
            <p class="result-card-value" id="avgPriceDisp">—</p>
          </div>
          <div class="result-card">
            <p class="result-card-label">価格差額</p>
            <p class="result-card-value" id="diffDisp">—</p>
          </div>
          <div class="result-card">
            <p class="result-card-label">相場比</p>
            <p class="result-card-value" id="ratioDisp">—</p>
          </div>
          <div class="result-card">
            <p class="result-card-label">入力㎡単価</p>
            <p class="result-card-value" id="sqmInputDisp">—</p>
          </div>
          <div class="result-card">
            <p class="result-card-label">地域平均㎡単価</p>
            <p class="result-card-value" id="sqmAvgDisp">—</p>
          </div>
        </div>

        <!-- 築年数補正コメント -->
        <div class="age-note" id="ageNote" hidden>
          <span class="age-note-icon">📅</span>
          <span id="ageNoteText"></span>
