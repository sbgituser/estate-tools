<script>
/* ─── Helpers ─────────────────────────────────────────── */

function fmt(val: number, dec = 0): string {
  return val.toLocaleString('ja-JP', {
    minimumFractionDigits: dec,
    maximumFractionDigits: dec,
  });
}

function fmtPM(val: number, dec = 0): string {
  return (val >= 0 ? '+' : '') + fmt(val, dec);
}

function getNum(id: string, fallback = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fallback;
  const v = parseFloat(el.value);
  return isNaN(v) ? fallback : v;
}

function setText(id: string, text: string): void {
  const el = document.getElementById(id);
  if (el) el.textContent = text;
}

function clamp(val: number, min: number, max: number): number {
  return Math.max(min, Math.min(max, val));
}

function updateFill(slider: HTMLInputElement): void {
  const min = parseFloat(slider.min) || 0;
  const max = parseFloat(slider.max) || 100;
  const val = parseFloat(slider.value) || 0;
  const pct = clamp((val - min) / (max - min) * 100, 0, 100);
  slider.style.setProperty('--pct', `${pct}%`);
}

function updateDisplay(id: string, val: string): void {
  const el = document.getElementById(`${id}Display`);
  if (el) el.textContent = Number(val).toLocaleString('ja-JP');
}

/* ─── Loan calc ─────────────────────────────────────────── */

/** 元利均等返済での残債（万円） */
function calcRemainingDebt(
  principal: number,
  annualRatePct: number,
  totalYears: number,
  elapsedYears: number
): number {
  if (principal <= 0) return 0;
  if (annualRatePct === 0) {
    const remainYears = Math.max(0, totalYears - elapsedYears);
    return principal * (remainYears / totalYears);
  }
  const r = annualRatePct / 100 / 12;
  const n = totalYears * 12;
  const k = Math.min(elapsedYears * 12, n);
  const debt = principal
    * (Math.pow(1 + r, n) - Math.pow(1 + r, k))
    / (Math.pow(1 + r, n) - 1);
  return Math.max(0, debt);
}

/** 仲介手数料の法定上限概算（消費税込み） */
function calcAutoAgentFee(sellPrice: number): number {
  return Math.round((sellPrice * 0.03 + 6) * 1.1);
}

/* ─── 残債取得 ──────────────────────────────────────────── */

function getDebtValue(): number {
  const mode = (document.querySelector('input[name="debtMode"]:checked') as HTMLInputElement)?.value ?? 'direct';
  if (mode === 'direct') {
    return getNum('debtDirect', 1800);
  }
  const loanAmount   = getNum('loanAmount',   2400);
  const loanRate     = getNum('loanRate',       1.5);
  const loanYears    = getNum('loanYears',       35);
  const elapsedYears = getNum('elapsedYears',    10);
  const debt = calcRemainingDebt(loanAmount, loanRate, loanYears, elapsedYears);
  setText('estimatedDebt', fmt(Math.round(debt)) + ' 万円');
  return Math.round(debt);
}

/* ─── メイン計算 ────────────────────────────────────────── */

function calculate(): void {
  const buyPrice    = getNum('buyPrice',    3000);
  const buyExpenses = getNum('buyExpenses',  120);
  const equity      = getNum('equity',       600);
  const sellPrice   = getNum('sellPrice',   3200);
  const agentFee    = getNum('agentFee',     112);
  const sellOther   = getNum('sellOther',     20);
  const debt        = getDebtValue();

  const doTax      = (document.getElementById('doTax')      as HTMLInputElement)?.checked ?? false;
  const isShort    = (document.querySelector('input[name="holdPeriod"]:checked') as HTMLInputElement)?.value === 'short';
  const residential = (document.getElementById('residential') as HTMLInputElement)?.checked ?? false;

  // バリデーション
  const errEl = document.getElementById('errorMsg');
  if (buyPrice <= 0 || sellPrice <= 0) {
    if (errEl) {
      errEl.textContent = '購入価格と想定売却価格は1以上の値を入力してください。';
      errEl.hidden = false;
    }
    return;
  }
  if (errEl) errEl.hidden = true;

  const sellCosts    = agentFee + sellOther;
  const netProceeds  = sellPrice - sellCosts - debt;
  const totalEquity  = equity + buyExpenses;
  const simplePL     = sellPrice - buyPrice - buyExpenses - sellCosts;
  const finalPL      = netProceeds - totalEquity;
  const breakEven    = Math.ceil((buyPrice + buyExpenses + sellCosts + debt) / 10) * 10;

  // 税計算
  let taxableGain = 0;
  let taxAmount   = 0;
  let afterTaxNet = netProceeds;

  if (doTax) {
    const acqCost   = buyPrice + buyExpenses;
    const deduction = residential ? 3000 : 0;
    taxableGain = Math.max(0, sellPrice - acqCost - sellCosts - deduction);
    const taxRate = isShort ? 0.3963 : 0.20315;
    taxAmount   = taxableGain * taxRate;
    afterTaxNet = netProceeds - taxAmount;
  }

  const displayNet = doTax ? afterTaxNet : netProceeds;

  // ── ヒーロー ──
  const heroResult = document.getElementById('heroResult');
  setText('heroLabel', doTax ? '税引後の手取り額' : '売却後の手取り額');
  setText('heroValue', fmt(Math.round(displayNet)) + ' 万円');
  if (heroResult) {
    heroResult.classList.remove('positive', 'negative');
    heroResult.classList.add(displayNet >= 0 ? 'positive' : 'negative');
  }
  const statusText = debt > sellPrice - sellCosts
    ? '売却代金だけではローンを完済できません（オーバーローン）'
    : netProceeds === 0
      ? '手残りはちょうどゼロです'
      : netProceeds > 0
        ? 'ローン完済後に手残りがあります'
        : '';
  setText('heroStatus', statusText);

  // ── 損益バンド ──
  const profitBand = document.getElementById('profitBand');
  const profitNet  = doTax ? afterTaxNet - totalEquity : finalPL;
  setText('profitValue', fmtPM(Math.round(profitNet)) + ' 万円');
  setText('profitNote',
    profitNet >= 0
      ? `自己資金 ${fmt(totalEquity)} 万円を全額回収し ${fmt(Math.round(profitNet))} 万円のプラス`
      : `自己資金 ${fmt(totalEquity)} 万円のうち ${fmt(Math.round(-profitNet))} 万円が未回収`
  );
  if (profitBand) {
    profitBand.classList.remove('gain', 'loss');
    profitBand.classList.add(profitNet >= 0 ? 'gain' : 'loss');
  }

  // ── フロー ──
  setText('fSellPrice',   '+' + fmt(sellPrice) + ' 万円');
  setText('fSellCosts',   '−' + fmt(sellCosts) + ' 万円');
  setText('fDebt',        '−' + fmt(Math.round(debt)) + ' 万円');
  setText('fNetProceeds', fmt(Math.round(netProceeds)) + ' 万円');

  const fNetEl = document.getElementById('fNetProceeds');
  if (fNetEl) {
    fNetEl.className = 'flow-amt bold' + (netProceeds < 0 ? ' red' : netProceeds > 0 ? ' green' : '');
  }

  const taxFlowRow    = document.getElementById('taxFlowRow');
  const afterTaxFlowRow = document.getElementById('afterTaxFlowRow');
  if (taxFlowRow)    taxFlowRow.style.display    = doTax ? '' : 'none';
  if (afterTaxFlowRow) afterTaxFlowRow.style.display = doTax ? '' : 'none';
  if (doTax) {
    setText('fTax',      '−' + fmt(Math.round(taxAmount))   + ' 万円');
    setText('fAfterTax', fmt(Math.round(afterTaxNet)) + ' 万円');
    const fAtEl = document.getElementById('fAfterTax');
    if (fAtEl) fAtEl.className = 'flow-amt bold' + (afterTaxNet < 0 ? ' red' : afterTaxNet > 0 ? ' green' : '');
  }

  // ── テーブル ──
  setText('rSellPrice',   fmt(sellPrice) + ' 万円');
  setText('rAgentFee',    fmt(agentFee)  + ' 万円');
  setText('rSellOther',   fmt(sellOther) + ' 万円');
  setText('rSellCosts',   fmt(sellCosts) + ' 万円');
  setText('rDebt',        fmt(Math.round(debt)) + ' 万円');
  setText('rBuyPrice',    fmt(buyPrice)   + ' 万円');
  setText('rBuyExpenses', fmt(buyExpenses) + ' 万円');
  setText('rTotalInvest', fmt(buyPrice + buyExpenses) + ' 万円');
  setText('rSimplePL',    fmtPM(Math.round(simplePL)) + ' 万円');
  setText('rNetProceeds', fmt(Math.round(netProceeds)) + ' 万円');
  setText('rTotalEquity', fmt(totalEquity) + ' 万円');
  setText('rFinalPL',     fmtPM(Math.round(finalPL)) + ' 万円');

  const simplePLEl = document.getElementById('rSimplePL');
  if (simplePLEl) simplePLEl.style.color = simplePL >= 0 ? 'var(--c-success)' : 'var(--c-danger)';

  const finalPLEl = document.getElementById('rFinalPL');
  if (finalPLEl) finalPLEl.style.color = finalPL >= 0 ? 'var(--c-success)' : 'var(--c-danger)';

  // 税行の表示切り替え
  const taxRows = ['rTaxGainRow', 'rTaxAmtRow', 'rAfterTaxRow'];
  taxRows.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = doTax ? '' : 'none';
  });
  if (doTax) {
    setText('rTaxableGain', fmt(Math.round(taxableGain)) + ' 万円');
    setText('rTaxAmount',   fmt(Math.round(taxAmount))   + ' 万円');
    setText('rAfterTax',    fmt(Math.round(afterTaxNet)) + ' 万円');
  }

  // ── 損益分岐 ──
  setText('breakevenValue', fmt(breakEven) + ' 万円');
  const diffFromBE = sellPrice - breakEven;
  setText('breakevenNote',
    diffFromBE >= 0
      ? `現在の売却価格は損益分岐点より ${fmt(Math.round(diffFromBE))} 万円高い`
      : `損益分岐点まであと ${fmt(Math.round(-diffFromBE))} 万円必要`
  );
  const beBox = document.getElementById('breakevenBox');
  if (beBox) {
    beBox.classList.remove('above', 'below');
    beBox.classList.add(diffFromBE >= 0 ? 'above' : 'below');
  }

  // ── 仲介手数料ヒント更新 ──
  const autoFee = calcAutoAgentFee(sellPrice);
  setText('agentFeeAuto', fmt(autoFee));

  // ── シナリオ比較・早見表 ──
  buildScenarioGrid(sellPrice, sellCosts, debt, buyPrice, buyExpenses, equity, totalEquity, doTax, isShort, residential);
  buildLookupTable(sellPrice, sellCosts, debt, totalEquity, doTax, isShort, buyPrice, buyExpenses, residential);
}

/* ─── シナリオ比較 ──────────────────────────────────────── */

function buildScenarioGrid(
  baseSellPrice: number,
  sellCosts: number,
  debt: number,
  buyPrice: number,
  buyExpenses: number,
  equity: number,
  totalEquity: number,
  doTax: boolean,
  isShort: boolean,
  residential: boolean
): void {
  const scenarios = [
    { label: '楽観', pct: +5,  cls: 'optimistic' },
    { label: 'ベース', pct: 0, cls: 'base' },
    { label: '悲観',  pct: -10, cls: 'pessimistic' },
  ];

  const grid = document.getElementById('scenarioGrid');
  if (!grid) return;

  grid.innerHTML = scenarios.map(s => {
    const sp  = Math.round(baseSellPrice * (1 + s.pct / 100));
    const net = sp - sellCosts - debt;
    const finalPL = net - totalEquity;

    let taxAmt    = 0;
    let afterNet  = net;
    if (doTax && net > 0) {
      const acq = buyPrice + buyExpenses;
      const ded = residential ? 3000 : 0;
      const tg  = Math.max(0, sp - acq - sellCosts - ded);
      taxAmt   = tg * (isShort ? 0.3963 : 0.20315);
      afterNet = net - taxAmt;
    }

    const pctLabel = s.pct === 0 ? '基準価格' : s.pct > 0 ? `+${s.pct}%` : `${s.pct}%`;
    const verdictClass = finalPL > 0 ? 'positive' : finalPL < 0 ? 'negative' : 'zero';
    const verdictText  = finalPL > 0 ? '黒字売却' : finalPL < 0 ? '赤字売却' : '収支ゼロ';

    return `
      <div class="scenario-card ${s.cls}">
        <div class="sc-label">${s.label}</div>
        <div class="sc-pct">${pctLabel}</div>
        <div class="sc-price">${fmt(sp)} 万円</div>
        <div class="sc-details">
          <div class="sc-row">
            <span>売却後手取り</span>
            <span class="${net < 0 ? 'negative' : net > 0 ? 'positive' : ''}">${fmt(Math.round(net))} 万円</span>
          </div>
          ${doTax ? `
          <div class="sc-row">
            <span>概算税額</span>
            <span class="negative">−${fmt(Math.round(taxAmt))} 万円</span>
          </div>
          <div class="sc-row">
            <span>税引後手取り</span>
            <span class="${afterNet < 0 ? 'negative' : afterNet > 0 ? 'positive' : ''}">${fmt(Math.round(afterNet))} 万円</span>
          </div>
          ` : ''}
          <div class="sc-row">
            <span>最終損益</span>
            <span class="${verdictClass}">${fmtPM(Math.round(finalPL))} 万円</span>
          </div>
        </div>
        <div class="sc-verdict ${verdictClass}">${verdictText}</div>
      </div>
    `;
  }).join('');
}

/* ─── 早見表 ────────────────────────────────────────────── */

function buildLookupTable(
  baseSellPrice: number,
  sellCosts: number,
  debt: number,
  totalEquity: number,
  doTax: boolean,
  isShort: boolean,
  buyPrice: number,
  buyExpenses: number,
  residential: boolean
): void {
  const tbody = document.getElementById('lookupTableBody');
  if (!tbody) return;

  const ratios = [-20, -15, -10, -5, 0, +5, +10];

  tbody.innerHTML = ratios.map(r => {
    const sp  = Math.round(baseSellPrice * (1 + r / 100));
    const net = sp - sellCosts - debt;
    const finalPL = net - totalEquity;

    let displayNet = net;
    if (doTax && net > 0) {
      const acq = buyPrice + buyExpenses;
      const ded = residential ? 3000 : 0;
      const tg  = Math.max(0, sp - acq - sellCosts - ded);
      displayNet = net - tg * (isShort ? 0.3963 : 0.20315);
    }

    const isBase  = r === 0;
    const verdict = net < 0
      ? { cls: 'verdict-ng',  text: '不可' }
      : finalPL >= 0
        ? { cls: 'verdict-ok',  text: '黒字' }
        : { cls: 'verdict-bad', text: '赤字' };

    const priceBadge = isBase
      ? ' <span class="base-badge">基準</span>'
      : r > 0
        ? ` <span class="pct-badge up">+${r}%</span>`
        : ` <span class="pct-badge dn">${r}%</span>`;

    const netTd     = `<td class="${net < 0 ? 'red' : ''}">${fmt(Math.round(displayNet))} 万円</td>`;
    const finalPLTd = `<td class="${finalPL >= 0 ? 'green' : 'red'}">${fmtPM(Math.round(finalPL))} 万円</td>`;

    return `<tr class="${isBase ? 'base-row' : ''}">
      <td>${fmt(sp)} 万円${priceBadge}</td>
      <td>${fmt(sellCosts)} 万円</td>
      <td>${fmt(Math.round(debt))} 万円</td>
      ${netTd}
      ${finalPLTd}
      <td><span class="verdict ${verdict.cls}">${verdict.text}</span></td>
    </tr>`;
  }).join('');
}

/* ─── UI: 残債モード切替 ────────────────────────────────── */

function updateDebtSection(): void {
  const mode = (document.querySelector('input[name="debtMode"]:checked') as HTMLInputElement)?.value ?? 'direct';
  const directSection = document.getElementById('debtDirectSection');
  const calcSection   = document.getElementById('debtCalcSection');
  if (directSection) directSection.style.display = mode === 'direct' ? '' : 'none';
  if (calcSection)   calcSection.style.display   = mode === 'calc'   ? '' : 'none';
}

/* ─── UI: 税オプション切替 ──────────────────────────────── */

function updateTaxOptions(): void {
  const doTax    = (document.getElementById('doTax') as HTMLInputElement)?.checked ?? false;
  const taxOpts  = document.getElementById('taxOptions');
  if (taxOpts) taxOpts.style.display = doTax ? '' : 'none';
}

/* ─── サンプルバッジ非表示 ──────────────────────────────── */

function hideSampleBadge(): void {
  const badge = document.getElementById('sampleBadge');
  if (badge) badge.hidden = true;
}

/* ─── スライダー ↔ 数値入力の同期 ──────────────────────── */

function syncSliderToNum(slider: HTMLInputElement): void {
  const targetId = slider.dataset.target;
  if (!targetId) return;
  const numEl = document.getElementById(targetId) as HTMLInputElement | null;
  if (!numEl) return;
  numEl.value = slider.value;
  updateFill(slider);
  updateDisplay(targetId, slider.value);
}

function syncNumToSlider(numEl: HTMLInputElement): void {
  const slider = document.querySelector<HTMLInputElement>(
    `input.range-slider[data-target="${numEl.id}"]`
  );
  if (!slider) return;
  const min  = parseFloat(slider.min)  || 0;
  const max  = parseFloat(slider.max)  || 100;
  const step = parseFloat(slider.step) || 1;
  let val = parseFloat(numEl.value);
  if (isNaN(val) || val < min) val = min;
  if (val > max) val = max;
  val = Math.round(val / step) * step;
  numEl.value  = String(val);
  slider.value = String(val);
  updateFill(slider);
  updateDisplay(numEl.id, numEl.value);
}

/* ─── 初期化 ─────────────────────────────────────────────── */

document.addEventListener('DOMContentLoaded', () => {

  // スライダー初期塗り & イベント
  document.querySelectorAll<HTMLInputElement>('input.range-slider').forEach(slider => {
    updateFill(slider);
    slider.addEventListener('input', () => {
      syncSliderToNum(slider);
      hideSampleBadge();
      calculate();
    });
  });

  // 数値入力 → スライダー同期
  document.querySelectorAll<HTMLInputElement>('input.field-input').forEach(numEl => {
    numEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['-', 'e', 'E', '+'].includes(e.key)) e.preventDefault();
    });
    numEl.addEventListener('change', () => {
      syncNumToSlider(numEl);
      hideSampleBadge();
      calculate();
    });
  });

  // 残債モード切替
  document.querySelectorAll<HTMLInputElement>('input[name="debtMode"]').forEach(radio => {
    radio.addEventListener('change', () => {
      updateDebtSection();
      hideSampleBadge();
      calculate();
    });
  });

  // 税チェック
  document.getElementById('doTax')?.addEventListener('change', () => {
    updateTaxOptions();
    hideSampleBadge();
    calculate();
  });

  // 保有期間・居住用特例 変更
  document.querySelectorAll<HTMLInputElement>('input[name="holdPeriod"]').forEach(r => {
    r.addEventListener('change', () => { hideSampleBadge(); calculate(); });
  });
  document.getElementById('residential')?.addEventListener('change', () => {
    hideSampleBadge();
    calculate();
  });

  // 初期計算
  updateDebtSection();
  calculate();
});
</script>
