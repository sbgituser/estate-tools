---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '不動産売却益シミュレーター',
    url: 'https://estate.kuras-plus.com/calculators/sale-profit',
    description: '売却価格・仲介手数料・ローン残債を入力するだけで手元に残る金額を無料でシミュレーション。損益分岐売却価格・シナリオ比較・価格別早見表も確認できます。',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://estate.kuras-plus.com' },
      { '@type': 'ListItem', position: 2, name: '不動産売却益シミュレーター', item: 'https://estate.kuras-plus.com/calculators/sale-profit' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: '不動産を売ると手元にいくら残りますか？',
        acceptedAnswer: { '@type': 'Answer', text: '手元に残る金額は「売却価格 − 仲介手数料などの諸費用 − ローン残債」が基本です。税金が発生する場合はさらに差し引かれます。当ツールで概算をご確認ください。' },
      },
      {
        '@type': 'Question',
        name: '売却価格がそのまま利益になるわけではないのですか？',
        acceptedAnswer: { '@type': 'Answer', text: 'なりません。売却価格から仲介手数料・諸費用・ローン残債・譲渡所得税を差し引いた金額が実際の手取りです。売却価格の10〜20%以上が差し引かれるケースも珍しくありません。' },
      },
      {
        '@type': 'Question',
        name: 'ローン残債があると売却益はどうなりますか？',
        acceptedAnswer: { '@type': 'Answer', text: '売却代金はまずローン残債の返済に充てられます。残債が多いと手取りが大きく減り、残債が売却価格を上回る「オーバーローン」になると、不足分を自己資金で補填する必要があります。' },
      },
      {
        '@type': 'Question',
        name: '不動産売却時にはどんな費用がかかりますか？',
        acceptedAnswer: { '@type': 'Answer', text: '主な費用は①仲介手数料（売却価格×3%＋6万円×消費税が上限目安）②印紙税③抵当権抹消登記費用などです。仲介手数料だけで数十〜100万円以上になることも多く、事前把握が重要です。' },
      },
      {
        '@type': 'Question',
        name: '不動産売却益の計算では税金も考えるべきですか？',
        acceptedAnswer: { '@type': 'Answer', text: '保有期間や利益額によっては譲渡所得税が発生します。5年超保有の長期譲渡は税率約20.3%、5年以下の短期譲渡は税率約39.6%（所得税＋復興特別所得税＋住民税の合計概算）が目安です。居住用財産の3,000万円特別控除など特例もあるため、正確な税額は税理士にご確認ください。' },
      },
      {
        '@type': 'Question',
        name: '損しないためにはいくら以上で売ればよいですか？',
        acceptedAnswer: { '@type': 'Answer', text: '損益分岐売却価格は「購入価格＋購入時諸費用＋売却時諸費用の見込み＋ローン残債」の合計です。当ツールでは「損益分岐売却価格」として自動計算・表示しています。' },
      },
    ],
  },
];
---

<BaseLayout
  title="不動産売却益シミュレーター | 手取り・損益分岐を無料試算"
  description="売却価格・仲介手数料・ローン残債を入力するだけで手元に残る金額を無料シミュレーション。損益分岐売却価格・シナリオ比較・価格別早見表で出口戦略をサポート。登録不要・完全無料。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/sale-profit" />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>売却益シミュレーター</span>
      </nav>
      <p class="hero-eyebrow">Sale Profit Simulator</p>
      <h1 class="hero-title">不動産売却益<br />シミュレーター</h1>
      <p class="hero-desc">
        売却価格・諸費用・ローン残債を入力するだけで<br />
        手元に残る金額・損益分岐売却価格を即時試算します。
      </p>
    </div>
  </section>

  <div class="container mt-48" style="padding-bottom: 80px;">

    <!-- ── Main calculator layout ── -->
    <div class="calc-layout">

      <!-- ── Inputs ── -->
      <section class="card" aria-label="入力フォーム">
        <h2 class="card-heading">売却条件を入力</h2>

        <!-- === 購入時情報 === -->
        <p class="group-label">購入時情報</p>

        <div class="field-group">
          <div class="field-label">
            <label for="buyPrice">購入価格</label>
            <span class="field-display"><span id="buyPriceDisplay">3,000</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="buyPriceSlider"
            data-target="buyPrice" value="3000" min="100" max="30000" step="100" />
          <input class="field-input" type="number" id="buyPrice"
            value="3000" min="100" max="30000" step="100" inputmode="numeric" />
        </div>

        <div class="field-group">
          <div class="field-label">
            <label for="buyExpenses">購入時諸費用</label>
            <span class="field-display"><span id="buyExpensesDisplay">120</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="buyExpensesSlider"
            data-target="buyExpenses" value="120" min="0" max="1000" step="10" />
          <input class="field-input" type="number" id="buyExpenses"
            value="120" min="0" max="1000" step="10" inputmode="numeric" />
          <p class="field-hint">仲介手数料・登記費用・印紙税・火災保険など。購入価格の3〜5%が目安。</p>
        </div>

        <div class="field-group">
          <div class="field-label">
            <label for="equity">自己資金（頭金）</label>
            <span class="field-display"><span id="equityDisplay">600</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="equitySlider"
            data-target="equity" value="600" min="0" max="10000" step="50" />
          <input class="field-input" type="number" id="equity"
            value="600" min="0" max="10000" step="50" inputmode="numeric" />
          <p class="field-hint">購入時に自分で用意した金額（頭金のみ。諸費用は別項目）。最終損益の基準になります。</p>
        </div>

        <hr class="divider" />

        <!-- === 売却時情報 === -->
        <p class="group-label">売却時情報</p>

        <div class="field-group">
          <div class="field-label">
            <label for="sellPrice">想定売却価格</label>
            <span class="field-display"><span id="sellPriceDisplay">3,200</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="sellPriceSlider"
            data-target="sellPrice" value="3200" min="100" max="30000" step="100" />
          <input class="field-input" type="number" id="sellPrice"
            value="3200" min="100" max="30000" step="100" inputmode="numeric" />
        </div>

        <div class="field-group">
          <div class="field-label">
            <label for="agentFee">仲介手数料</label>
            <span class="field-display"><span id="agentFeeDisplay">112</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="agentFeeSlider"
            data-target="agentFee" value="112" min="0" max="500" step="1" />
          <input class="field-input" type="number" id="agentFee"
            value="112" min="0" max="500" step="1" inputmode="numeric" />
          <p class="field-hint">
            法定上限: 売却価格×3%＋6万円×消費税。売却価格 3,200万円の場合、上限目安は
            <strong id="agentFeeAuto">112</strong> 万円。
          </p>
        </div>

        <div class="field-group">
          <div class="field-label">
            <label for="sellOther">売却時その他費用</label>
            <span class="field-display"><span id="sellOtherDisplay">20</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="sellOtherSlider"
            data-target="sellOther" value="20" min="0" max="200" step="5" />
          <input class="field-input" type="number" id="sellOther"
            value="20" min="0" max="200" step="5" inputmode="numeric" />
          <p class="field-hint">印紙税・抵当権抹消登記費用・測量費・その他手続き費用など。</p>
        </div>

        <hr class="divider" />

        <!-- === ローン残債 === -->
        <p class="group-label">ローン残債</p>

        <div class="debt-mode-toggle" role="group" aria-label="残債入力方法">
          <label class="mode-btn">
            <input type="radio" name="debtMode" value="direct" checked />
            <span>直接入力</span>
          </label>
          <label class="mode-btn">
            <input type="radio" name="debtMode" value="calc" />
            <span>借入条件から概算</span>
          </label>
        </div>

        <!-- 直接入力モード -->
        <div id="debtDirectSection">
          <div class="field-group">
            <div class="field-label">
              <label for="debtDirect">現在のローン残債</label>
              <span class="field-display"><span id="debtDirectDisplay">1,800</span> 万円</span>
            </div>
            <input class="range-slider" type="range" id="debtDirectSlider"
              data-target="debtDirect" value="1800" min="0" max="20000" step="50" />
            <input class="field-input" type="number" id="debtDirect"
              value="1800" min="0" max="20000" step="50" inputmode="numeric" />
            <p class="field-hint">金融機関の残高証明書またはネットバンキングで確認できます。ローンがない場合は0を入力。</p>
          </div>
        </div>

        <!-- 概算計算モード -->
        <div id="debtCalcSection" style="display:none;">
          <div class="field-group">
            <div class="field-label">
              <label for="loanAmount">借入額</label>
              <span class="field-display"><span id="loanAmountDisplay">2,400</span> 万円</span>
            </div>
            <input class="range-slider" type="range" id="loanAmountSlider"
              data-target="loanAmount" value="2400" min="0" max="20000" step="100" />
            <input class="field-input" type="number" id="loanAmount"
              value="2400" min="0" max="20000" step="100" inputmode="numeric" />
          </div>
          <div class="field-group">
            <div class="field-label">
              <label for="loanRate">金利（年利）</label>
              <span class="field-display"><span id="loanRateDisplay">1.5</span> %</span>
            </div>
            <input class="range-slider" type="range" id="loanRateSlider"
              data-target="loanRate" value="1.5" min="0" max="10" step="0.1" />
            <input class="field-input" type="number" id="loanRate"
              value="1.5" min="0" max="10" step="0.1" inputmode="decimal" />
          </div>
          <div class="field-group">
            <div class="field-label">
              <label for="loanYears">返済年数</label>
              <span class="field-display"><span id="loanYearsDisplay">35</span> 年</span>
            </div>
            <input class="range-slider" type="range" id="loanYearsSlider"
              data-target="loanYears" value="35" min="1" max="50" step="1" />
            <input class="field-input" type="number" id="loanYears"
              value="35" min="1" max="50" step="1" inputmode="numeric" />
          </div>
          <div class="field-group">
            <div class="field-label">
              <label for="elapsedYears">返済経過年数</label>
              <span class="field-display"><span id="elapsedYearsDisplay">10</span> 年</span>
            </div>
            <input class="range-slider" type="range" id="elapsedYearsSlider"
              data-target="elapsedYears" value="10" min="0" max="49" step="1" />
            <input class="field-input" type="number" id="elapsedYears"
              value="10" min="0" max="49" step="1" inputmode="numeric" />
          </div>
          <div class="estimated-debt-box">
            元利均等返済での概算残債: <strong id="estimatedDebt">—</strong>
          </div>
        </div>

        <!-- === 税金設定（任意） === -->
        <details class="details-block" id="taxDetails">
          <summary>譲渡所得税の概算設定（任意）</summary>
          <div class="details-content">
            <p class="details-desc">
              不動産売却の利益に対して譲渡所得税が発生する場合があります。
              ここでは参考として概算税額を計算できます。
              <strong>正確な税額は必ず税理士にご確認ください。</strong>
            </p>
            <div class="check-field">
              <input type="checkbox" id="doTax" />
              <label for="doTax">譲渡所得税の概算を計算する</label>
            </div>
            <div id="taxOptions" style="display:none; margin-top: 14px;">
              <p class="details-sub">保有期間の区分</p>
              <div class="radio-group">
                <label>
                  <input type="radio" name="holdPeriod" value="long" checked />
                  5年超（長期譲渡） — 税率 約20.3%
                </label>
                <label>
                  <input type="radio" name="holdPeriod" value="short" />
                  5年以下（短期譲渡） — 税率 約39.6%
                </label>
              </div>
              <div class="check-field" style="margin-top: 10px;">
                <input type="checkbox" id="residential" />
                <label for="residential">居住用財産の3,000万円特別控除を適用する</label>
              </div>
              <p class="field-hint" style="margin-top: 6px;">
                ※ マイホームの売却で一定条件を満たすと、譲渡所得から最大3,000万円を控除できます。
                投資用物件は通常適用外です。
              </p>
            </div>
          </div>
        </details>

        <div id="errorMsg" class="error-msg" hidden></div>
      </section>

      <!-- ── Results ── -->
      <section class="card results-card" aria-label="計算結果" aria-live="polite">
        <h2 class="card-heading">計算結果</h2>

        <div id="sampleBadge" class="sample-badge">
          <span>📋</span> サンプル値による計算例 — 値を変更すると即時更新されます
        </div>

        <!-- ヒーロー: 手取り -->
        <div class="hero-result" id="heroResult">
          <div class="hero-label" id="heroLabel">売却後の手取り額</div>
          <div class="hero-value" id="heroValue">—</div>
          <div class="hero-status" id="heroStatus"></div>
        </div>

        <!-- 自己資金との比較 -->
        <div class="profit-band" id="profitBand">
          <div class="profit-label">自己資金（頭金＋購入諸費用）との比較</div>
          <div class="profit-value" id="profitValue">—</div>
          <div class="profit-note" id="profitNote"></div>
        </div>

        <!-- 手取りフロー -->
        <div class="flow-section">
          <div class="flow-row">
            <span class="flow-icon icon-plus">＋</span>
            <span class="flow-name">売却価格</span>
            <span class="flow-amt" id="fSellPrice">—</span>
          </div>
          <div class="flow-row">
            <span class="flow-icon icon-minus">－</span>
            <span class="flow-name">売却時諸費用</span>
            <span class="flow-amt red" id="fSellCosts">—</span>
          </div>
          <div class="flow-row">
            <span class="flow-icon icon-minus">－</span>
            <span class="flow-name">ローン残債</span>
            <span class="flow-amt red" id="fDebt">—</span>
          </div>
          <div class="flow-divider"></div>
          <div class="flow-row flow-result">
            <span class="flow-icon icon-eq">＝</span>
            <span class="flow-name"><strong>売却後の手取り</strong></span>
            <span class="flow-amt bold" id="fNetProceeds">—</span>
          </div>
          <div class="flow-row" id="taxFlowRow" style="display:none;">
            <span class="flow-icon icon-minus">－</span>
            <span class="flow-name">概算譲渡所得税</span>
            <span class="flow-amt red" id="fTax">—</span>
          </div>
          <div class="flow-row flow-result" id="afterTaxFlowRow" style="display:none;">
            <span class="flow-icon icon-eq">＝</span>
            <span class="flow-name"><strong>税引後手取り</strong></span>
            <span class="flow-amt bold" id="fAfterTax">—</span>
          </div>
        </div>

        <!-- 詳細テーブル -->
        <table class="result-table">
          <tbody>
            <tr class="table-section"><td colspan="2">売却時</td></tr>
            <tr>
              <th>想定売却価格</th>
              <td id="rSellPrice">—</td>
            </tr>
            <tr>
              <th>仲介手数料</th>
              <td id="rAgentFee">—</td>
            </tr>
            <tr>
              <th>その他売却費用</th>
              <td id="rSellOther">—</td>
            </tr>
            <tr class="table-subtotal">
              <th>売却時諸費用合計</th>
              <td id="rSellCosts">—</td>
            </tr>
            <tr>
              <th>ローン残債</th>
              <td id="rDebt">—</td>
            </tr>
            <tr class="table-section"><td colspan="2">購入時</td></tr>
            <tr>
              <th>購入価格</th>
              <td id="rBuyPrice">—</td>
            </tr>
            <tr>
              <th>購入時諸費用</th>
              <td id="rBuyExpenses">—</td>
            </tr>
            <tr class="table-subtotal">
              <th>購入時総投資額</th>
              <td id="rTotalInvest">—</td>
            </tr>
            <tr class="table-section"><td colspan="2">収支</td></tr>
            <tr>
              <th>単純売却差益</th>
              <td id="rSimplePL">—</td>
            </tr>
            <tr class="table-total">
              <th>売却後の手取り</th>
              <td id="rNetProceeds">—</td>
            </tr>
            <tr id="rTaxGainRow" style="display:none;" class="table-subtotal">
              <th>概算譲渡所得</th>
              <td id="rTaxableGain">—</td>
            </tr>
            <tr id="rTaxAmtRow" style="display:none;" class="table-subtotal">
              <th>概算譲渡所得税</th>
              <td id="rTaxAmount">—</td>
            </tr>
            <tr id="rAfterTaxRow" style="display:none;" class="table-total">
              <th>税引後手取り</th>
              <td id="rAfterTax">—</td>
            </tr>
            <tr class="table-section"><td colspan="2">自己資金との比較</td></tr>
            <tr>
              <th>投下自己資金合計</th>
              <td id="rTotalEquity">—</td>
            </tr>
            <tr class="table-roi">
              <th>最終損益</th>
              <td id="rFinalPL">—</td>
            </tr>
          </tbody>
        </table>

        <!-- 損益分岐価格 -->
        <div class="breakeven-box" id="breakevenBox">
          <div class="breakeven-label">損益分岐売却価格（概算）</div>
          <div class="breakeven-value" id="breakevenValue">—</div>
          <div class="breakeven-note" id="breakevenNote"></div>
        </div>

        <p class="result-disclaimer">
          ※ 概算シミュレーターです。実際の手取りは諸条件・税制・交渉状況により異なります。<br />
          ※ 税金計算は概算であり、正確な税額・特例の適用可否は税理士にご確認ください。
        </p>
      </section>

    </div><!-- /.calc-layout -->

    <!-- ── シナリオ比較 ── -->
    <section class="mt-48">
      <h2 class="section-title">売却価格シナリオ比較</h2>
      <p class="section-sub">売却価格が変わったとき、手取りと損益がどう変わるかを確認できます</p>
      <div class="scenario-grid" id="scenarioGrid">
        <!-- JS生成 -->
      </div>
    </section>

    <!-- ── 価格別早見表 ── -->
    <section class="mt-48">
      <h2 class="section-title">売却価格別 手取り早見表</h2>
      <p class="section-sub">現在の入力条件で、売却価格を±20%の範囲で確認できます</p>
      <div class="table-scroll">
        <table class="lookup-table">
          <thead>
            <tr>
              <th>売却価格</th>
              <th>売却諸費用</th>
              <th>ローン残債</th>
              <th>売却後手取り</th>
              <th>最終損益</th>
              <th>判定</th>
            </tr>
          </thead>
          <tbody id="lookupTableBody">
            <!-- JS生成 -->
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── 関連ツール ── -->
    <section class="related-section mt-48">
      <h2 class="section-title">関連ツール</h2>
