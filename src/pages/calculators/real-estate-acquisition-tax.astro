  background: var(--c-bg-card);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: 18px;
  text-decoration: none;
  color: var(--c-text);
  transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
