}
.invest-title { font-size: 0.72rem; font-weight: 700; color: var(--c-primary); margin-bottom: 6px; }
.invest-text { font-size: 0.78rem; color: var(--c-text-muted); line-height: 1.7; }

/* ── Result disclaimer ── */
.result-disclaimer { font-size: 0.72rem; color: var(--c-text-muted); line-height: 1.6; }

/* ── Related ── */
.related-section { max-width: 900px; }
