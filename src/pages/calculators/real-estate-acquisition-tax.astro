---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '不動産取得税シミュレーター',
  url: 'https://estate.kuras-plus.com/calculators/real-estate-acquisition-tax',
  description: '新築・中古住宅・土地の不動産取得税を固定資産税評価額から無料でシミュレーション。宅地評価土地の1/2特例・住宅用軽減措置に対応した概算計算ツール。',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'All',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '不動産取得税はどうやって計算しますか？',
      acceptedAnswer: { '@type': 'Answer', text: '不動産取得税は「固定資産税評価額 × 税率（土地・住宅3%、非住宅4%）」が基本です。宅地評価土地は課税標準が評価額の1/2になります。新築住宅（50〜240㎡）は建物評価額から1,200万円を控除した金額に3%をかけます。' },
    },
    {
      '@type': 'Question',
      name: '不動産取得税は物件価格ではなく何を基準に計算しますか？',
      acceptedAnswer: { '@type': 'Answer', text: '不動産取得税は「固定資産税評価額」を基準に計算します。売買価格や時価ではありません。土地は公示価格の約70%、建物は建設費の約50〜60%が評価額の目安です。' },
    },
    {
      '@type': 'Question',
      name: '新築住宅の不動産取得税は安くなりますか？',
      acceptedAnswer: { '@type': 'Answer', text: '居住用の新築住宅（延床面積50〜240㎡）は建物評価額から1,200万円が控除されます。建物評価額が1,200万円以下の場合、建物分の取得税は0円になります。' },
    },
    {
      '@type': 'Question',
      name: '中古住宅の不動産取得税にも軽減はありますか？',
      acceptedAnswer: { '@type': 'Answer', text: 'あります。新築年に応じた控除額が適用されます。1997年以降の物件は最大1,200万円控除。1981年以前は耐震基準適合証明書がないと控除が受けられない場合があります。' },
    },
    {
      '@type': 'Question',
      name: '土地だけ買った場合も不動産取得税はかかりますか？',
      acceptedAnswer: { '@type': 'Answer', text: 'はい、土地のみの取得でも取得税（税率3%）がかかります。宅地評価土地なら課税標準が評価額の1/2になります。その後一定期間内に住宅を新築または取得した場合、土地分の軽減を還付申請できることがあります。' },
    },
    {
      '@type': 'Question',
      name: '不動産取得税の軽減を受けるには申告が必要ですか？',
      acceptedAnswer: { '@type': 'Answer', text: '多くの場合、都道府県税事務所への申告が必要です。特に中古住宅控除や土地軽減の還付請求は自動適用されないため、取得後に期限内の申告が必要です。' },
    },
    {
      '@type': 'Question',
      name: '固定資産税評価額が分からない場合はどうすればよいですか？',
      acceptedAnswer: { '@type': 'Answer', text: '購入前なら売主または不動産仲介業者に固定資産評価証明書の確認を依頼してください。土地は路線価の約70%、建物は建設費の約50〜60%が目安です。購入後は毎年届く納税通知書または市区町村窓口で確認できます。' },
    },
  ],
};
---

<BaseLayout
  title="不動産取得税シミュレーター | 新築・中古・土地の取得税を無料計算"
  description="不動産取得税を固定資産税評価額から無料でシミュレーション。新築住宅の1,200万円控除・中古住宅の控除・宅地評価土地の1/2特例・土地軽減措置に対応した概算計算ツールです。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/real-estate-acquisition-tax" />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>不動産取得税シミュレーター</span>
      </nav>
      <p class="hero-eyebrow">Real Estate Acquisition Tax Simulator</p>
      <h1 class="hero-title">不動産取得税シミュレーター</h1>
      <p class="hero-desc">
        新築・中古住宅・土地の取得税を評価額から即計算。<br />
        軽減措置・宅地特例を考慮した購入時コストの目安を確認できます。
      </p>
    </div>
  </section>

  <!-- Calculator -->
  <div class="container mt-48" style="padding-bottom: 80px;">
    <div class="calc-layout">

      <!-- ── Inputs ── -->
      <section class="card" aria-label="入力フォーム">
        <h2 class="card-heading">取得条件を入力</h2>

        <p class="group-label">基本情報</p>

        <!-- 取得する不動産の種類 -->
        <div class="field-group">
          <div class="field-label-text">取得する不動産の種類</div>
          <div class="type-group-4">
            <label class="type-opt">
              <input type="radio" name="propType" value="new-house" checked />
              <span>🏠 新築住宅</span>
            </label>
            <label class="type-opt">
              <input type="radio" name="propType" value="used-house" />
              <span>🏘️ 中古住宅</span>
            </label>
            <label class="type-opt">
              <input type="radio" name="propType" value="land-only" />
              <span>🌱 土地のみ</span>
            </label>
            <label class="type-opt">
              <input type="radio" name="propType" value="non-housing" />
              <span>🏢 住宅以外</span>
            </label>
          </div>
          <p class="field-hint">「住宅以外」は店舗・事務所など非住宅用途の建物です。税率4%・軽減措置なし。</p>
        </div>

        <!-- 自己居住用か -->
        <div class="field-group" id="selfOccupyGroup">
          <div class="field-label-text">自己居住用ですか？</div>
          <div class="toggle-group">
            <label class="toggle-opt">
              <input type="radio" name="isSelfOccupy" value="yes" checked />
              <span>はい（居住用）</span>
            </label>
            <label class="toggle-opt">
              <input type="radio" name="isSelfOccupy" value="no" />
              <span>いいえ（投資用など）</span>
            </label>
          </div>
          <p class="field-hint">居住用住宅は新築・中古ともに軽減措置の対象となる場合があります。賃貸投資用物件は条件が異なります。</p>
        </div>

        <hr class="divider" />
        <p class="group-label">評価額</p>

        <!-- 土地の評価額 -->
        <div class="field-group" id="landAssessGroup">
          <div class="field-label">
            <label for="landAssess">土地の固定資産税評価額</label>
            <span class="field-display"><span id="landAssessDisplay">1,500</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="landAssessSlider"
            data-target="landAssess" value="1500" min="0" max="10000" step="100" />
          <input class="field-input" type="number" id="landAssess"
            value="1500" min="0" max="100000" step="100" inputmode="numeric" />
          <details class="assess-helper">
            <summary class="assess-helper-q">評価額の調べ方・目安を知りたい</summary>
            <div class="assess-helper-body">
              <p>固定資産税評価額は売買価格とは異なります。<strong>土地は路線価の約70%</strong>が目安です。</p>
              <p>購入前は売主・仲介業者に確認。購入後は納税通知書または固定資産評価証明書（市区町村窓口）で確認できます。</p>
            </div>
          </details>
        </div>

        <!-- 宅地評価土地か -->
        <div class="field-group" id="takuchiGroup">
          <div class="field-label-text">宅地評価土地（一般的な住宅地）ですか？</div>
          <div class="toggle-group">
            <label class="toggle-opt">
              <input type="radio" name="isTakuchi" value="yes" checked />
              <span>はい（宅地評価）</span>
            </label>
            <label class="toggle-opt">
              <input type="radio" name="isTakuchi" value="no" />
              <span>いいえ（農地など）</span>
            </label>
          </div>
          <p class="field-hint">一般的な住宅地・宅地は「宅地評価土地」に該当し、課税標準が評価額の<strong>1/2</strong>になります（2026年3月末まで）。</p>
        </div>

        <!-- 建物の評価額 -->
        <div class="field-group" id="buildingAssessGroup">
          <div class="field-label">
            <label for="buildingAssess">建物の固定資産税評価額</label>
            <span class="field-display"><span id="buildingAssessDisplay">800</span> 万円</span>
          </div>
          <input class="range-slider" type="range" id="buildingAssessSlider"
            data-target="buildingAssess" value="800" min="0" max="5000" step="50" />
          <input class="field-input" type="number" id="buildingAssess"
            value="800" min="0" max="100000" step="50" inputmode="numeric" />
          <details class="assess-helper">
            <summary class="assess-helper-q">建物評価額の目安を知りたい</summary>
            <div class="assess-helper-body">
              <p>建物の評価額は建設費用の<strong>約50〜60%</strong>が目安（新築時）。</p>
              <p>新築住宅なら1,200万円以下のことも多く、控除後の取得税が0円になるケースがあります。</p>
            </div>
          </details>
        </div>

        <!-- 住宅要件グループ -->
        <div id="housingReqGroup">
          <hr class="divider" />
          <p class="group-label">住宅・土地の要件</p>

          <!-- 延床面積 -->
          <div class="field-group">
            <div class="field-label">
              <label for="floorArea">延床面積</label>
              <span class="field-display"><span id="floorAreaDisplay">80</span> ㎡</span>
            </div>
            <input class="range-slider" type="range" id="floorAreaSlider"
              data-target="floorArea" value="80" min="10" max="500" step="5" />
            <input class="field-input" type="number" id="floorArea"
              value="80" min="1" max="9999" step="1" inputmode="numeric" />
            <p class="field-hint">新築住宅控除の要件は<strong>50〜240㎡</strong>です。この範囲外は控除が適用されません。</p>
          </div>

          <!-- 土地面積 -->
          <div class="field-group">
            <div class="field-label">
              <label for="landArea">土地面積</label>
              <span class="field-display"><span id="landAreaDisplay">100</span> ㎡</span>
            </div>
            <input class="range-slider" type="range" id="landAreaSlider"
              data-target="landArea" value="100" min="10" max="1000" step="5" />
            <input class="field-input" type="number" id="landArea"
              value="100" min="1" max="99999" step="1" inputmode="numeric" />
            <p class="field-hint">土地軽減額の計算に使用します（住宅用土地の軽減を適用する場合）。</p>
          </div>

          <!-- 住宅用土地の軽減 -->
          <div class="field-group" id="landReductionGroup">
            <div class="field-label-text">住宅用土地の軽減措置を適用しますか？</div>
            <div class="toggle-group">
              <label class="toggle-opt">
                <input type="radio" name="applyLandReduction" value="yes" checked />
                <span>適用する</span>
              </label>
              <label class="toggle-opt">
                <input type="radio" name="applyLandReduction" value="no" />
                <span>適用しない</span>
              </label>
            </div>
            <p class="field-hint">住宅と同時または一定期間内に取得した住宅用土地は、一定額の軽減が適用されます（45,000円または計算式の大きい方）。</p>
          </div>

          <!-- 取得タイミング -->
          <div class="field-group" id="landTimingGroup">
            <div class="field-label-text">土地と住宅の取得タイミング</div>
            <div class="type-group">
              <label class="type-opt">
                <input type="radio" name="landTiming" value="simultaneous" checked />
                <span>同時</span>
              </label>
              <label class="type-opt">
                <input type="radio" name="landTiming" value="land-first" />
                <span>土地先行</span>
              </label>
              <label class="type-opt">
                <input type="radio" name="landTiming" value="house-first" />
                <span>住宅先行</span>
              </label>
            </div>
            <p class="field-hint">土地先行の場合、住宅完成後に軽減分の還付申請が可能です（3年以内に新築が条件）。</p>
          </div>
        </div>

        <!-- 新築住宅控除グループ -->
        <div id="newHouseGroup">
          <hr class="divider" />
          <p class="group-label">新築住宅の控除</p>

          <div class="field-group">
            <div class="field-label-text">新築住宅の1,200万円控除を適用しますか？</div>
            <div class="toggle-group">
              <label class="toggle-opt">
                <input type="radio" name="applyNewDeduction" value="yes" checked />
                <span>適用する</span>
              </label>
              <label class="toggle-opt">
                <input type="radio" name="applyNewDeduction" value="no" />
                <span>適用しない</span>
              </label>
            </div>
            <p class="field-hint">居住用新築住宅（延床50〜240㎡）は、建物評価額から<strong>1,200万円が控除</strong>されます。評価額が1,200万円以下なら建物の取得税は0円。</p>
          </div>

          <div id="floorWarning" class="warning-msg" hidden>
            ⚠️ 延床面積が控除要件（50〜240㎡）の範囲外のため、1,200万円控除は適用できません。
          </div>
        </div>

        <!-- 中古住宅控除グループ -->
        <div id="usedHouseGroup" hidden>
          <hr class="divider" />
          <p class="group-label">中古住宅の控除</p>

          <div class="field-group">
            <div class="field-label-text">中古住宅の控除を適用しますか？</div>
            <div class="toggle-group">
              <label class="toggle-opt">
                <input type="radio" name="applyUsedDeduction" value="yes" checked />
                <span>適用を検討する</span>
              </label>
              <label class="toggle-opt">
                <input type="radio" name="applyUsedDeduction" value="no" />
                <span>適用しない</span>
              </label>
            </div>
          </div>

          <!-- 新築年 -->
          <div class="field-group" id="constructYearGroup">
            <div class="field-label-text">建物の新築年（西暦）</div>
            <select class="field-select" id="constructYear">
              <option value="2020">2020年以降</option>
              <option value="2010">2010〜2019年</option>
              <option value="2000">2000〜2009年</option>
              <option value="1997" selected>1997〜1999年</option>
              <option value="1990">1989〜1996年</option>
              <option value="1986">1985〜1988年</option>
              <option value="1982">1981〜1984年（新耐震基準後）</option>
              <option value="1977">1976〜1980年</option>
              <option value="1974">1973〜1975年</option>
              <option value="1965">1964〜1972年</option>
              <option value="1960">1963年以前（控除なし）</option>
            </select>
            <p class="field-hint">新築年が新しいほど控除額が大きくなります。1997年以降は最大1,200万円控除。</p>
          </div>

          <!-- 耐震基準 -->
          <div class="field-group">
            <div class="field-label-text">耐震基準適合証明書はありますか？</div>
            <div class="type-group">
              <label class="type-opt">
                <input type="radio" name="seismic" value="yes" />
                <span>✅ 適合あり</span>
              </label>
              <label class="type-opt">
                <input type="radio" name="seismic" value="no" />
                <span>❌ なし</span>
              </label>
              <label class="type-opt">
                <input type="radio" name="seismic" value="unknown" checked />
                <span>❓ 不明</span>
              </label>
            </div>
            <p class="field-hint">1981年以前の建物は耐震基準適合証明書がないと控除が受けられない場合があります。「不明」の場合は控除を適用しない計算をします。</p>
          </div>
        </div>

        <div id="errorMsg" class="error-msg" hidden></div>
      </section>

      <!-- ── Results ── -->
      <section class="card results-card" aria-label="試算結果" aria-live="polite">
        <h2 class="card-heading">試算結果（概算）</h2>

        <div id="sampleBadge" class="sample-badge">
          <span>📋</span> サンプル値による試算例 — 値を変更すると即時更新されます
        </div>

        <!-- Hero metrics -->
        <div class="hero-metrics">
          <div class="metric-box primary-box">
            <div class="metric-label">不動産取得税 合計（概算）</div>
            <div class="metric-value" id="rTotal">—</div>
          </div>
          <div class="metric-box">
            <div class="metric-label">軽減・控除による節税効果</div>
            <div class="metric-value sm" id="rSaving" style="color: var(--c-success);">—</div>
          </div>
        </div>

        <!-- Breakdown -->
        <div class="breakdown">

          <!-- Building -->
          <div class="breakdown-section" id="buildingBreakdown">
            <div class="breakdown-title" id="buildingBreakdownTitle">建物分（取得税 3%）</div>
            <div class="breakdown-row">
              <span class="breakdown-label">建物評価額</span>
              <span class="breakdown-value" id="rBuildingAssess">—</span>
            </div>
            <div class="breakdown-row" id="deductionRow">
              <span class="breakdown-label">控除額 <span class="label-note" id="rDeductionLabel"></span></span>
              <span class="breakdown-value" style="color: var(--c-success);" id="rBuildingDeduction">—</span>
            </div>
            <div class="breakdown-row">
              <span class="breakdown-label">課税標準（控除後）</span>
              <span class="breakdown-value" id="rBuildingTaxBase">—</span>
            </div>
            <div class="breakdown-row subtotal">
              <span class="breakdown-label">建物 取得税</span>
              <span class="breakdown-value" id="rBuildingTax">—</span>
            </div>
          </div>

          <!-- Land -->
          <div class="breakdown-section">
            <div class="breakdown-title">土地分（取得税 3%）</div>
            <div class="breakdown-row">
              <span class="breakdown-label">評価額</span>
              <span class="breakdown-value" id="rLandAssess">—</span>
            </div>
            <div class="breakdown-row">
              <span class="breakdown-label">課税標準 <span class="label-note" id="rLandBaseNote"></span></span>
              <span class="breakdown-value" id="rLandTaxBase">—</span>
            </div>
            <div class="breakdown-row" id="landReductionRow">
              <span class="breakdown-label">住宅用土地の軽減額</span>
              <span class="breakdown-value" style="color: var(--c-success);" id="rLandReduction">—</span>
            </div>
            <div class="breakdown-row subtotal">
              <span class="breakdown-label">土地 取得税</span>
              <span class="breakdown-value" id="rLandTax">—</span>
            </div>
          </div>

          <!-- Total comparison -->
          <div class="breakdown-section total-section">
            <div class="breakdown-row">
              <span class="breakdown-label">軽減・控除なしの場合（参考）</span>
              <span class="breakdown-value" style="color: var(--c-text-muted); font-size: 0.82rem;" id="rBeforeReduction">—</span>
            </div>
            <div class="breakdown-row subtotal">
              <span class="breakdown-label">不動産取得税 合計（概算）</span>
              <span class="breakdown-value" id="rTotalConfirm">—</span>
            </div>
          </div>
        </div>

        <!-- Applied measures -->
        <div class="measures-card">
          <div class="measures-title">✅ 適用した軽減・控除</div>
          <div id="measuresList" class="measures-list"></div>
        </div>

        <!-- Purchase cost note -->
        <div class="invest-note">
          <div class="invest-title">💡 購入時コストとしての位置づけ</div>
          <p id="rCostNote" class="invest-text"></p>
        </div>

        <p class="result-disclaimer">
          ※ 本試算はあくまで概算です。不動産取得税は都道府県税であり、実際の税額は固定資産税評価額・申告内容・都道府県の判断により異なります。
          軽減措置を受けるには申告が必要な場合があります。正確な税額は都道府県税事務所にお問い合わせください。
        </p>
      </section>
    </div>

    <!-- ── Related tools ── -->
    <section class="related-section mt-48">
      <h2 class="section-title">関連ツール</h2>
