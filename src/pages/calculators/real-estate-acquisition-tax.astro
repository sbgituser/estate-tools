  align-items: center;
  padding: 5px 0;
  border-bottom: 1px solid var(--c-border);
  font-size: 0.82rem;
}
.breakdown-row:last-child { border-bottom: none; }
.breakdown-label { color: var(--c-text-muted); }
.breakdown-value { font-weight: 700; color: var(--c-text); }
