}
.related-icon { font-size: 1.4rem; margin-bottom: 6px; }
.related-title { font-size: 0.9rem; font-weight: 700; color: var(--c-primary); margin-bottom: 4px; }
.related-desc { font-size: 0.78rem; color: var(--c-text-muted); line-height: 1.6; margin-bottom: 8px; }
.related-arrow { font-size: 0.78rem; color: var(--c-primary); font-weight: 600; }

/* ── Explanation ── */
.explain-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px;
  margin-top: 16px;
}
.explain-card {
  background: var(--c-bg-card);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  padding: 20px;
}
.explain-card h3 { font-size: 0.95rem; font-weight: 700; color: var(--c-primary); margin-bottom: 10px; }
.explain-card p, .explain-card ul { font-size: 0.82rem; color: var(--c-text-muted); line-height: 1.8; }
.explain-card ul { padding-left: 1.2em; }
.explain-card li { margin-bottom: 4px; }
.explain-card strong { color: var(--c-text); }

/* ── FAQ ── */
.faq-section { max-width: 760px; }
.faq-list { margin-top: 16px; display: flex; flex-direction: column; gap: 8px; }
.faq-item {
  background: var(--c-bg-card);
  border: 1px solid var(--c-border);
  border-radius: var(--radius-md);
  overflow: hidden;
}
.faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 18px;
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--c-primary);
  cursor: pointer;
  list-style: none;
  gap: 12px;
}
.faq-q::-webkit-details-marker { display: none; }
.faq-q::after { content: '＋'; font-size: 1.1rem; color: var(--c-primary); flex-shrink: 0; transition: transform 0.2s; }
.faq-item[open] .faq-q::after { transform: rotate(45deg); }
.faq-a {
  padding: 0 18px 16px;
  font-size: 0.82rem;
  color: var(--c-text-muted);
  line-height: 1.8;
}
.faq-a p + p { margin-top: 8px; }
</style>

<script>
/* ─────────────────────────────────────────────────
   TAX CONSTANTS — 税率・控除額の設定
   制度変更時はここを修正してください
───────────────────────────────────────────────── */
const TAX = {
  landRate:            0.03,   // 土地取得税率 3%
  housingRate:         0.03,   // 住宅建物取得税率 3%
  nonHousingRate:      0.04,   // 非住宅建物取得税率 4%
  takuchiHalfRatio:    0.5,    // 宅地評価土地 課税標準軽減率
  newDeductionMan:     1200,   // 新築住宅控除 万円
  newFloorMin:         50,     // 新築控除 床面積下限 ㎡
  newFloorMax:         240,    // 新築控除 床面積上限 ㎡
  landMinReductionYen: 45000,  // 土地軽減 最低額 円
  // 中古住宅控除テーブル（fromYear以降に建築 → deduction万円）
  usedDeductions: [
    { fromYear: 1997, deduction: 1200, label: '1997年以降' },
    { fromYear: 1989, deduction: 1000, label: '1989〜1996年' },
    { fromYear: 1985, deduction:  450, label: '1985〜1988年' },
    { fromYear: 1981, deduction:  420, label: '1981〜1984年（新耐震後）' },
    { fromYear: 1976, deduction:  350, label: '1976〜1980年' },
    { fromYear: 1973, deduction:  230, label: '1973〜1975年' },
    { fromYear: 1964, deduction:  150, label: '1964〜1972年' },
    { fromYear:    0, deduction:    0, label: '1963年以前' },
  ],
};

/* ─── Helpers ─── */
function fmt(v: number, d = 1): string {
  return v.toLocaleString('ja-JP', { minimumFractionDigits: d, maximumFractionDigits: d });
}
function getNum(id: string, fb = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fb;
  const v = parseFloat(el.value);
  return isNaN(v) ? fb : v;
}
function setText(id: string, t: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = t;
}
function setHtml(id: string, t: string) {
  const el = document.getElementById(id);
  if (el) el.innerHTML = t;
}
function clamp(v: number, a: number, b: number): number {
  return Math.max(a, Math.min(b, v));
}
function getRadio(name: string, fb: string): string {
  const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
  return el?.value ?? fb;
}
function getSelectVal(id: string): number {
  const el = document.getElementById(id) as HTMLSelectElement | null;
  return el ? parseInt(el.value, 10) : 0;
}
function updateFill(s: HTMLInputElement) {
  const mn = parseFloat(s.min) || 0, mx = parseFloat(s.max) || 100, v = parseFloat(s.value) || 0;
  s.style.setProperty('--pct', `${clamp((v - mn) / (mx - mn) * 100, 0, 100)}%`);
}
function updateDisplay(id: string, val: string) {
  const el = document.getElementById(`${id}Display`);
  if (el) el.textContent = Number(val).toLocaleString('ja-JP');
}
function hideSampleBadge() {
  const b = document.getElementById('sampleBadge');
  if (b) b.hidden = true;
}
function show(id: string, visible: boolean) {
  const el = document.getElementById(id);
  if (el) el.hidden = !visible;
}

/* ─── Get used housing deduction by construction year ─── */
function getUsedDeduction(year: number): { deduction: number; label: string } {
  for (const row of TAX.usedDeductions) {
    if (year >= row.fromYear) return row;
  }
  return { deduction: 0, label: '1963年以前' };
}

/* ─── Visibility update ─── */
function updateVisibility() {
  const pt = getRadio('propType', 'new-house');
  const isHousing    = pt === 'new-house' || pt === 'used-house';
  const isLandOnly   = pt === 'land-only';
  const isNonHousing = pt === 'non-housing';

  show('selfOccupyGroup',    isHousing);
  show('landAssessGroup',    true); // land always shown
  show('takuchiGroup',       true); // always shown
  show('buildingAssessGroup', !isLandOnly);
  show('housingReqGroup',    isHousing || isLandOnly);
  show('landReductionGroup', isHousing || isLandOnly);
  show('landTimingGroup',    isHousing);
  show('newHouseGroup',      pt === 'new-house');
  show('usedHouseGroup',     pt === 'used-house');
  show('buildingBreakdown',  !isLandOnly);

  // Floor area warning for new house
  if (pt === 'new-house') {
    const floor = getNum('floorArea', 80);
    const applyNew = getRadio('applyNewDeduction', 'yes') === 'yes';
    const outOfRange = floor < TAX.newFloorMin || floor > TAX.newFloorMax;
    show('floorWarning', applyNew && outOfRange);
  }

  // Used house: construct year group visibility
  if (pt === 'used-house') {
    const applyUsed = getRadio('applyUsedDeduction', 'yes') === 'yes';
    show('constructYearGroup', applyUsed);
  }
}

/* ─── Main calculation ─── */
function calculate() {
  const pt           = getRadio('propType', 'new-house');
  const isHousing    = pt === 'new-house' || pt === 'used-house';
  const isLandOnly   = pt === 'land-only';
  const hasBuilding  = !isLandOnly;
  const isSelfOccupy = isHousing && getRadio('isSelfOccupy', 'yes') === 'yes';
  const isTakuchi    = getRadio('isTakuchi', 'yes') === 'yes';

  const landAssess     = getNum('landAssess', 1500);
  const buildingAssess = hasBuilding ? getNum('buildingAssess', 800) : 0;
  const floorArea      = getNum('floorArea', 80);
  const landArea       = getNum('landArea', 100);

  // Validate
  const errEl = document.getElementById('errorMsg');
  if (landAssess < 0 || buildingAssess < 0) {
    if (errEl) { errEl.textContent = '評価額は0以上で入力してください。'; errEl.hidden = false; }
    return;
  }
  if (errEl) errEl.hidden = true;

  /* ── LAND TAX ── */
  // 課税標準: 宅地評価土地なら評価額×1/2
  const landTaxBase     = isTakuchi ? landAssess * TAX.takuchiHalfRatio : landAssess;
  const landBaseTaxMan  = landTaxBase * TAX.landRate;  // 軽減なし
  let   landTaxMan      = landBaseTaxMan;
  let   landReductionMan = 0;
  let   applyLandRed    = false;

  const doLandRed = getRadio('applyLandReduction', 'yes') === 'yes';
  if (doLandRed && (isHousing || isLandOnly) && landArea > 0 && floorArea > 0 && landAssess > 0) {
    // 軽減額 = max(45,000円, 土地1㎡単価 × 1/2 × min(床面積×2, 200) × 3%)
    const unitPriceYen     = (landAssess * 10000) / landArea;
    const effectiveFloor   = Math.min(floorArea * 2, 200);
    const A_yen            = unitPriceYen * TAX.takuchiHalfRatio * effectiveFloor * TAX.landRate;
    const reductionYen     = Math.max(TAX.landMinReductionYen, A_yen);
    const baseTaxYen       = landBaseTaxMan * 10000;
    const reducedYen       = Math.max(0, baseTaxYen - reductionYen);
    landReductionMan       = Math.min(reductionYen / 10000, landBaseTaxMan);
    landTaxMan             = reducedYen / 10000;
    applyLandRed           = true;
  }

  /* ── BUILDING TAX ── */
  const buildingRate     = (isHousing || isLandOnly) ? TAX.housingRate : TAX.nonHousingRate;
  const buildingBaseTaxMan = buildingAssess * buildingRate;
  let   buildingDeductionMan = 0;
  let   buildingTaxMan   = buildingBaseTaxMan;
  let   deductionLabel   = '';

  if (hasBuilding && buildingAssess > 0) {
    if (pt === 'new-house') {
      const applyNew  = isSelfOccupy && getRadio('applyNewDeduction', 'yes') === 'yes';
      const floorOk   = floorArea >= TAX.newFloorMin && floorArea <= TAX.newFloorMax;
      if (applyNew && floorOk) {
        buildingDeductionMan = TAX.newDeductionMan;
        deductionLabel       = '新築住宅 1,200万円控除';
      }
    } else if (pt === 'used-house') {
      const applyUsed  = getRadio('applyUsedDeduction', 'yes') === 'yes';
      const seismic    = getRadio('seismic', 'unknown');
      if (applyUsed) {
        const yr    = getSelectVal('constructYear');
        const row   = getUsedDeduction(yr);
        // 1981年以前で耐震不明・なしの場合は控除なし
        if (yr < 1981 && seismic !== 'yes') {
          buildingDeductionMan = 0;
          deductionLabel       = '耐震基準不適合のため控除なし（簡易判定）';
        } else {
          buildingDeductionMan = row.deduction;
          deductionLabel       = `中古住宅控除（${row.label}）`;
        }
      }
    }
    const taxableBuilding = Math.max(0, buildingAssess - buildingDeductionMan);
    buildingTaxMan        = taxableBuilding * buildingRate;
  }

  /* ── TOTALS ── */
  const totalBeforeMan   = landBaseTaxMan + buildingBaseTaxMan;
  const totalAfterMan    = landTaxMan + buildingTaxMan;
  const totalReductionMan = totalBeforeMan - totalAfterMan;

  /* ── DOM UPDATE ── */
  // Hero
  setText('rTotal',    fmt(totalAfterMan, 1) + ' 万円');
  setText('rSaving',   totalReductionMan > 0.05
    ? '▼ ' + fmt(totalReductionMan, 1) + ' 万円の節税'
    : '軽減・控除 なし');

  // Building breakdown
  setText('rBuildingAssess',    fmt(buildingAssess, 0) + ' 万円');
  setText('rBuildingDeduction', buildingDeductionMan > 0
    ? '▼ ' + fmt(buildingDeductionMan, 0) + ' 万円'
    : '0 万円（控除なし）');
  setText('rDeductionLabel',    deductionLabel);
  const taxBuilding = Math.max(0, buildingAssess - buildingDeductionMan);
  setText('rBuildingTaxBase',   fmt(taxBuilding, 0) + ' 万円');
  setText('rBuildingTax',       fmt(buildingTaxMan, 1) + ' 万円');
  setText('rBuildingBreakdownTitle' as any,
    `建物分（取得税 ${(buildingRate * 100).toFixed(0)}%）`);
  const titleEl = document.getElementById('buildingBreakdownTitle');
  if (titleEl) titleEl.textContent = `建物分（取得税 ${(buildingRate * 100).toFixed(0)}%）`;

  // Show/hide deduction row
  show('deductionRow', hasBuilding && isHousing);

  // Land breakdown
  setText('rLandAssess',   fmt(landAssess, 0) + ' 万円');
  setText('rLandTaxBase',  fmt(landTaxBase, 0) + ' 万円');
  setText('rLandBaseNote', isTakuchi ? '（宅地評価土地のため評価額×1/2）' : '');
  show('landReductionRow', applyLandRed);
  if (applyLandRed) {
    setText('rLandReduction', '▼ ' + fmt(landReductionMan, 2) + ' 万円');
  }
  setText('rLandTax',  fmt(landTaxMan, 1) + ' 万円');

  // Total
  setText('rBeforeReduction', fmt(totalBeforeMan, 1) + ' 万円');
  setText('rTotalConfirm',    fmt(totalAfterMan, 1) + ' 万円');

  /* ── Measures list ── */
  const measures: string[] = [];
  if (isTakuchi) {
    measures.push('宅地評価土地の1/2特例：土地の課税標準が評価額の1/2に軽減');
  }
  if (applyLandRed) {
    const reductionYen = landReductionMan * 10000;
    measures.push(`住宅用土地の軽減措置：${fmt(landReductionMan, 2)}万円 軽減（45,000円 or 計算式の大きい方）`);
  }
  if (buildingDeductionMan > 0) {
    measures.push(`建物控除：${deductionLabel}（${fmt(buildingDeductionMan, 0)}万円）`);
  }
  if (measures.length === 0) {
    measures.push('軽減・控除の適用なし（標準税率で計算）');
  }
  setHtml('measuresList', measures.map(m => `<div class="measure-item">✓ ${m}</div>`).join(''));

  /* ── Cost note ── */
  const costNote = `不動産取得税の概算は ${fmt(totalAfterMan, 1)} 万円（一度だけかかる購入時コスト）です。` +
    `仲介手数料・登記費用等の他の諸費用と合わせて初期費用に含めてください。` +
    `固定資産税シミュレーターで毎年の保有コストも試算し、住宅ローン返済シミュレーターと組み合わせることで総合的な購入計画が立てられます。`;
  setText('rCostNote', costNote);
}

/* ─── Slider sync ─── */
function syncSliderToNum(slider: HTMLInputElement) {
  const targetId = slider.dataset.target;
  if (!targetId) return;
  const numEl = document.getElementById(targetId) as HTMLInputElement | null;
  if (!numEl) return;
  numEl.value = slider.value;
  updateFill(slider);
  updateDisplay(targetId, slider.value);
}
function syncNumToSlider(numEl: HTMLInputElement) {
  const slider = document.querySelector<HTMLInputElement>(`input.range-slider[data-target="${numEl.id}"]`);
  if (!slider) return;
  const mn = parseFloat(slider.min) || 0, mx = parseFloat(slider.max) || 100, step = parseFloat(slider.step) || 1;
  let v = parseFloat(numEl.value);
  if (isNaN(v) || v < 0) v = 0;
  slider.value = String(Math.min(v, mx));
  updateFill(slider);
  updateDisplay(numEl.id, numEl.value);
}

/* ─── Init ─── */
document.addEventListener('DOMContentLoaded', () => {
  // Sliders
  document.querySelectorAll<HTMLInputElement>('input.range-slider').forEach(slider => {
    updateFill(slider);
    slider.addEventListener('input', () => {
      syncSliderToNum(slider);
      hideSampleBadge();
      updateVisibility();
      calculate();
    });
  });

  // Number inputs
  document.querySelectorAll<HTMLInputElement>('input.field-input').forEach(numEl => {
    numEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (['-', 'e', 'E', '+'].includes(e.key)) e.preventDefault();
    });
    numEl.addEventListener('change', () => {
      syncNumToSlider(numEl);
      hideSampleBadge();
      updateVisibility();
      calculate();
    });
  });

  // Radio buttons
  document.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', () => {
      hideSampleBadge();
      updateVisibility();
      calculate();
    });
  });

  // Select
  const constructYearEl = document.getElementById('constructYear');
  if (constructYearEl) {
    constructYearEl.addEventListener('change', () => {
      hideSampleBadge();
      calculate();
    });
  }

  updateVisibility();
  calculate();
});
</script>
