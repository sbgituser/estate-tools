<script>
function fmt(value: number, decimals = 0): string {
  return value.toLocaleString('ja-JP', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  });
}

function getNum(id: string, fallback = 0): number {
  const el = document.getElementById(id) as HTMLInputElement | null;
  if (!el) return fallback;
  const v = parseFloat(el.value);
  return isNaN(v) ? fallback : v;
}

function setText(id: string, text: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = text;
}

function classify(pct: number): 'good' | 'ok' | 'low' {
  if (pct >= 5) return 'good';
  if (pct >= 3) return 'ok';
  return 'low';
}

function noteText(pct: number): string {
  if (pct >= 8) return '高利回り';
  if (pct >= 5) return '良好';
  if (pct >= 3) return '標準的';
  return '低め';
}

function setYieldBox(boxId: string, valueId: string, barId: string, noteId: string, pct: number) {
  const box  = document.getElementById(boxId);
  const bar  = document.getElementById(barId) as HTMLElement | null;

  setText(valueId, pct.toFixed(2) + '%');
  setText(noteId, noteText(pct));

  const cls = classify(pct);
  if (box) {
    box.classList.remove('good', 'ok', 'low');
    box.classList.add(cls);
  }
  if (bar) {
    bar.style.width = Math.min(pct / 12 * 100, 100) + '%';
  }
}

document.getElementById('calcBtn')?.addEventListener('click', () => {
  const price    = getNum('price');
  const rent     = getNum('rent');
  const vacancy  = getNum('vacancy',  10);
  const mgmtRate = getNum('mgmt',      5);
  const repair   = getNum('repair',    0);
  const other    = getNum('other',     0);

  if (price <= 0 || rent <= 0) {
    alert('物件価格と月額家賃を入力してください。');
    return;
  }

  const annualRent     = rent * 12;
  const effectiveRent  = annualRent * (1 - vacancy / 100);
  const mgmtCost       = effectiveRent * (mgmtRate / 100);
  const totalCost      = mgmtCost + repair + other;
  const noi            = effectiveRent - totalCost;
  const grossYield     = (annualRent / price) * 100;
  const netYield       = (noi / price) * 100;

  const empty   = document.getElementById('resultEmpty');
  const content = document.getElementById('resultContent');
  if (empty)   empty.hidden = true;
  if (content) content.hidden = false;

  setYieldBox('grossBox', 'grossYield', 'grossBar', 'grossNote', grossYield);
  setYieldBox('netBox',   'netYield',   'netBar',   'netNote',   Math.max(netYield, 0));

  setText('rAnnualRent',   fmt(annualRent, 2)    + ' 万円');
  setText('rEffectiveRent',fmt(effectiveRent, 2) + ' 万円');
  setText('rMgmt',         fmt(mgmtCost, 2)      + ' 万円');
  setText('rRepair',       fmt(repair, 2)         + ' 万円');
  setText('rOther',        fmt(other, 2)          + ' 万円');
  setText('rTotalCost',    fmt(totalCost, 2)      + ' 万円');
  setText('rNOI',          fmt(noi, 2)            + ' 万円');
});
</script>
