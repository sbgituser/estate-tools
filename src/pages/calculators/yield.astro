---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';

const relatedTools = [
  {
    href: '/calculators/roi',
    icon: '💹',
    title: '不動産投資ROI計算ツール',
    desc: '頭金・ローン返済まで含めた自己資金ベースのROIを計算',
  },
  {
    href: '/calculators/cash-flow',
    icon: '💰',
    title: 'CFシミュレーター',
    desc: '年次CF推移・黒字転換年・自己資金回収年を試算',
  },
  {
    href: '/calculators/rent-vacancy-impact',
    icon: '📉',
    title: '家賃下落・空室率影響シミュレーター',
    desc: '感度分析マトリクスでリスクを2軸把握',
  },
  {
    href: '/calculators/repair-cost',
    icon: '🔧',
    title: '修繕費シミュレーター',
    desc: '10〜30年の長期修繕費を築年数・面積から自動推計',
  },
  {
    href: '/calculators/price-check',
    icon: '🔍',
    title: '不動産価格妥当性チェッカー',
    desc: '地域相場との比較で割安・割高を即判定',
  },
];

const relatedArticles = [
  {
    href: '/articles/real-estate-investment-basics',
    tag: '基礎知識',
    title: '不動産投資の基礎知識｜利回り・ROI・CFで何を見ればよいか',
    desc: '投資判断に必要な3指標の違いと使い方を初心者向けに解説',
  },
  {
    href: '/articles/gross-vs-net-yield',
    tag: '利回り',
    title: '表面利回りと実質利回りの違い｜計算式と投資判断への使い方',
    desc: '2種類の利回りを正確に理解し実態に近い収益性を把握する',
  },
  {
    href: '/articles/cashflow-basics',
    tag: 'CF',
    title: '不動産投資のキャッシュフローとは｜計算方法と目安を解説',
    desc: 'ローン返済後の実態収支「手残り」の考え方を分かりやすく解説',
  },
  {
    href: '/articles/vacancy-rate',
    tag: 'リスク',
    title: '空室率の目安と見込み方｜不動産投資リスク管理の基本',
    desc: 'エリア別の空室率目安とシミュレーション時の設定方法',
  },
  {
    href: '/articles/yield-calculation-guide',
    tag: '利回り計算',
    title: '不動産投資の利回り計算完全ガイド｜表面利回りと実質利回りの違い',
    desc: '計算式・具体例・よくある間違いを初心者向けに解説',
  },
  {
    href: '/articles/one-room-yield-benchmark',
    tag: '地域相場',
    title: 'ワンルーム投資の利回り目安｜東京・大阪・地方別の相場',
    desc: 'エリア別・築年数別の利回り相場と新築vs中古の違い',
  },
  {
    href: '/articles/initial-cost-simulation',
    tag: '初期費用',
    title: '不動産投資の初期費用シミュレーション｜利回りへの影響を解説',
    desc: '初期費用の内訳と実質利回りへの影響をシミュレーション例で紹介',
  },
];

const faqItems = [
  {
    q: '利回りは何パーセントあればよいですか？',
    a: '一般的な目安として、都市部（東京23区など）では表面利回り4〜6%・実質利回り3〜4%、地方では表面利回り8〜12%・実質利回り6〜8%程度が参考値です。ただし利回りの高さはリスクの高さを反映していることも多く、「何%あれば良い」と一概には言えません。ローン条件・空室リスク・修繕費まで含めて総合的に判断することが重要です。',
  },
  {
    q: '表面利回りと実質利回りはどちらを重視すべきですか？',
    a: '投資判断では実質利回りを重視してください。表面利回りは計算が簡単で物件比較に便利ですが、費用を考慮していないため実態より高く見えます。実質利回りは管理費・修繕費・空室損失などを差し引いた純収益ベースで計算するため、実際の収益力に近い数値です。表面利回りは「第一印象」、実質利回りは「実態確認」として使い分けましょう。',
  },
  {
    q: '新築と中古では利回りの見方は違いますか？',
    a: '異なります。新築は購入価格が高い分、利回りが低くなりやすい傾向があります（表面利回り3〜5%程度）。中古は購入価格が抑えられる分、表面上の利回りは高く見えますが、修繕費や空室リスクが高まる傾向があります。新築は修繕費が少ない一方で価値の下落が速く、中古は即時収益性が高い反面リスクも大きいため、バランスを見て判断することが重要です。',
  },
  {
    q: '利回り計算に含めるべき経費は何ですか？',
    a: '年間経費として①管理費（家賃収入の5〜10%）②修繕費（年10〜30万円程度）③固定資産税・都市計画税④空室損失（空室率×家賃収入）⑤保険料が主な項目です。また購入時には仲介手数料・不動産取得税・登記費用（物件価格の5〜10%程度）を分母に加算することで、より実態に近い実質利回りを計算できます。',
  },
  {
    q: '利回りだけで投資判断してよいですか？',
    a: '利回りだけでの判断は危険です。利回りはあくまで収益の目安に過ぎず、空室リスク・修繕費・立地の将来性・流動性（売却のしやすさ）・ローン条件なども総合的に確認する必要があります。特に高利回り物件は「なぜ高い利回りなのか」を深掘りすることが重要です。利回りシミュレーターを活用しながら複数の指標で判断しましょう。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: '不動産利回り計算ツール',
    url: 'https://estate.kuras-plus.com/calculators/yield',
    description: '物件価格・家賃・空室率・管理費などを入力して、表面利回りと実質利回りを無料で即計算。',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'All',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'JPY' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: '不動産利回りの計算方法｜表面・実質利回りをシミュレーターで確認',
    url: 'https://estate.kuras-plus.com/calculators/yield',
    description: '不動産利回りの計算式と目安を初心者向けに解説。無料シミュレーターで即試算。',
    author: { '@type': 'Organization', name: '不動産ツールズ | kuras-plus' },
    publisher: {
      '@type': 'Organization',
      name: '不動産ツールズ | kuras-plus',
      url: 'https://estate.kuras-plus.com',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://estate.kuras-plus.com' },
      { '@type': 'ListItem', position: 2, name: '不動産利回りの計算方法', item: 'https://estate.kuras-plus.com/calculators/yield' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="不動産利回りの計算方法｜表面・実質利回りをシミュレーターで確認"
  description="不動産利回りの計算式（表面・実質）を初心者向けに解説。無料シミュレーターで物件価格・家賃・費用から利回りを即計算。都市部・地方別の目安や、利回りだけで判断してはいけない理由も紹介。"
  jsonLd={jsonLd}
>
  <Header slot="header" currentPath="/calculators/yield" />

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        <span>›</span>
        <span>不動産利回りの計算方法</span>
      </nav>
      <p class="hero-eyebrow">Yield Calculator · 利回り入門</p>
      <h1 class="hero-title">不動産利回りの計算方法<br />表面・実質利回りをシミュレーターで確認</h1>
      <p class="hero-desc">
        利回りの計算式・目安・注意点を初心者向けに解説。<br />
        無料シミュレーターで自分の物件をすぐに試算できます。
      </p>
    </div>
  </section>

  <!-- Article Body -->
  <div class="article-outer">
    <div class="container article-container">

      <!-- このページで分かること -->
      <div class="summary-box">
        <p class="summary-label">📌 このページで分かること</p>
        <ul class="summary-list">
          <li>表面利回り・実質利回りの計算式と違い</li>
          <li>利回りの目安（エリア別の数値感）</li>
          <li>利回りだけで投資判断してはいけない理由</li>
          <li>無料シミュレーターで自分の物件を今すぐ試算</li>
        </ul>
      </div>

      <!-- ─── Section 1: 利回りとは ─── -->
      <section class="article-section" id="what-is-yield">
        <h2 class="article-h2">不動産利回りとは何か</h2>
        <p class="prose">
          「利回り」とは、投資した金額に対して1年間でどれだけの収益が得られるかを示す割合（%）です。
          不動産投資では「<strong>物件価格に対する年間家賃収入の割合</strong>」として使われます。
        </p>
        <p class="prose">
          たとえば3,000万円の物件から年間150万円の家賃収入が得られれば、利回りは5%です。
          利回りが高いほど投資効率が良いように見えますが、実際には注意すべき点もあります。
        </p>
        <div class="point-box">
          <p class="point-label">まず押さえたいポイント</p>
          <ul class="point-list">
            <li>利回りは「物件の収益力」を手軽に比較できる指標</li>
            <li>利回りが高い物件には「理由」がある（立地・築年数・リスクなど）</li>
            <li>費用や空室を考慮しないと実態と大きくズレる場合がある</li>
          </ul>
        </div>
      </section>

      <!-- ─── Section 2: 表面 vs 実質 ─── -->
      <section class="article-section" id="gross-vs-net">
        <h2 class="article-h2">表面利回りと実質利回りの違い</h2>
        <p class="prose">
          不動産には「表面利回り」と「実質利回り」の2種類があります。
          どちらも重要ですが、用途が異なります。
        </p>

        <div class="formula-wrap">
          <div class="formula-card">
            <div class="formula-type">表面利回り（グロス利回り）</div>
            <div class="formula-eq">年間家賃収入（満室）÷ 物件価格 × 100</div>
            <p class="formula-note">費用を考慮しないシンプルな指標。物件比較の第一歩として使う。</p>
          </div>
          <div class="formula-card formula-card--main">
            <div class="formula-type">実質利回り（ネット利回り）</div>
            <div class="formula-eq">(年間家賃収入 − 年間経費) ÷ (物件価格 + 購入時諸費用) × 100</div>
            <p class="formula-note">費用を差し引いた実態に近い数値。<strong>投資判断ではこちらを重視する。</strong></p>
          </div>
        </div>

        <div class="table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th></th>
                <th>表面利回り</th>
                <th>実質利回り</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>空室損失</td>
                <td class="cell-no">考慮しない</td>
                <td class="cell-yes">考慮する</td>
              </tr>
              <tr>
                <td>管理費・修繕費</td>
                <td class="cell-no">考慮しない</td>
                <td class="cell-yes">考慮する</td>
              </tr>
              <tr>
                <td>購入時諸費用</td>
                <td class="cell-no">考慮しない</td>
                <td class="cell-yes">考慮する</td>
              </tr>
              <tr>
                <td>計算の手軽さ</td>
                <td class="cell-yes">簡単</td>
                <td class="cell-no">やや複雑</td>
              </tr>
              <tr>
                <td>主な用途</td>
                <td>物件の大まかな比較</td>
                <td>投資判断の精度向上</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="note-box">
          <p><strong>年間経費とは：</strong>管理費（家賃収入の5〜10%）・修繕費・固定資産税・保険料など</p>
          <p><strong>購入時諸費用とは：</strong>仲介手数料・登記費用・ローン事務手数料など（物件価格の5〜10%程度）</p>
        </div>
      </section>

      <!-- ─── Section 3: 利回りの目安 ─── -->
      <section class="article-section" id="yield-benchmark">
        <h2 class="article-h2">利回りの目安はどれくらいか</h2>
        <p class="prose">
          利回りの目安はエリアや物件種別によって大きく異なります。以下はあくまで参考値です。
          実際の物件は個別の条件によって変わるため、必ず自分でシミュレーションして確認してください。
        </p>
        <div class="table-wrap">
          <table class="benchmark-table">
            <thead>
              <tr>
                <th>エリア</th>
                <th>表面利回り（目安）</th>
                <th>実質利回り（目安）</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>東京23区</td>
                <td>4〜6%</td>
                <td>3〜4%</td>
              </tr>
              <tr>
                <td>大阪・名古屋中心部</td>
                <td>5〜7%</td>
                <td>4〜5%</td>
              </tr>
              <tr>
                <td>地方政令市</td>
                <td>7〜10%</td>
                <td>5〜7%</td>
              </tr>
              <tr>
                <td>地方・郊外</td>
                <td>10〜15%</td>
                <td>7〜10%</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="small-note">
          ※ 上記はあくまで参考値です。物件種別（区分・一棟・新築・中古）や市況によって異なります。
          利回りが高い地方物件は、空室リスクや流動性の低さも考慮が必要です。
        </p>
      </section>

      <!-- ─── CTA to Simulator ─── -->
      <div class="cta-banner">
        <p class="cta-text">計算式と目安が分かったところで、実際の物件で試算してみましょう。</p>
        <a href="#simulator" class="cta-btn">↓ シミュレーターで今すぐ試算する（無料）</a>
      </div>

      <!-- ─── Section 4: Simulator ─── -->
      <section class="tool-section" id="simulator">
        <h2 class="article-h2">🧮 利回りシミュレーター（無料）</h2>
        <p class="tool-section-desc">
          物件価格・月額家賃・費用を入力するだけで、表面利回りと実質利回りを即計算します。
          登録不要・完全無料でご利用いただけます。
        </p>

        <div class="calc-layout">
          <!-- ── Inputs ── -->
          <section class="card" aria-label="入力フォーム">
            <h3 class="card-heading">物件情報を入力</h3>

            <div class="field-group">
              <label class="field-label" for="price">
                物件価格
                <span class="field-unit">万円</span>
              </label>
              <input class="field-input" type="number" id="price"
                placeholder="3000" min="1" step="1" inputmode="numeric"
                data-shared="shared-property-price" />
            </div>

            <div class="field-group">
              <label class="field-label" for="rent">
                月額家賃（満室想定）
                <span class="field-unit">万円</span>
              </label>
              <input class="field-input" type="number" id="rent"
                placeholder="12" min="0" step="0.1" inputmode="decimal"
                data-shared="shared-monthly-rent" />
            </div>

            <hr class="divider" />
            <p class="section-label">費用（年額・任意）</p>

            <div class="field-group">
              <label class="field-label" for="vacancy">
                空室率
                <span class="field-unit">%</span>
              </label>
              <input class="field-input" type="number" id="vacancy"
                placeholder="10" min="0" max="100" step="1" inputmode="numeric"
                data-shared="shared-vacancy-rate" />
              <p class="field-hint">年間を通じた平均空室率の目安。一般的な目安は 5〜15%。</p>
            </div>

            <div class="field-group">
              <label class="field-label" for="mgmt">
                管理費率
                <span class="field-unit">%</span>
              </label>
              <input class="field-input" type="number" id="mgmt"
                placeholder="5" min="0" max="100" step="0.5" inputmode="decimal" />
              <p class="field-hint">家賃収入に対する管理会社手数料。一般的な目安は 5〜10%。</p>
            </div>

            <div class="field-group">
              <label class="field-label" for="repair">
                修繕費（年額）
                <span class="field-unit">万円</span>
              </label>
              <input class="field-input" type="number" id="repair"
                placeholder="6" min="0" step="1" inputmode="numeric" />
            </div>

            <div class="field-group">
              <label class="field-label" for="other">
                その他費用（年額）
                <span class="field-unit">万円</span>
              </label>
              <input class="field-input" type="number" id="other"
                placeholder="0" min="0" step="1" inputmode="numeric" />
              <p class="field-hint">固定資産税・保険料・ローン利息などを合算してください。</p>
            </div>

            <button class="btn-calc" id="calcBtn" type="button">計算する</button>
          </section>

          <!-- ── Results ── -->
          <section class="card results-card" id="resultsCard" aria-label="計算結果" aria-live="polite">
            <h3 class="card-heading">計算結果</h3>

            <div class="result-empty" id="resultEmpty">
              <p>左のフォームに入力して<br />「計算する」を押してください</p>
            </div>

            <div id="resultContent" hidden>

              <!-- Yield meters -->
              <div class="yield-row">
                <div class="yield-box" id="grossBox">
                  <div class="yield-label">表面利回り</div>
                  <div class="yield-value" id="grossYield">—</div>
                  <div class="yield-bar-wrap">
                    <div class="yield-bar" id="grossBar" style="width:0%"></div>
                  </div>
                  <div class="yield-note" id="grossNote"></div>
                </div>
                <div class="yield-box" id="netBox">
                  <div class="yield-label">実質利回り</div>
                  <div class="yield-value" id="netYield">—</div>
                  <div class="yield-bar-wrap">
                    <div class="yield-bar" id="netBar" style="width:0%"></div>
                  </div>
                  <div class="yield-note" id="netNote"></div>
                </div>
              </div>

              <!-- Detail table -->
              <table class="result-table">
                <tbody>
                  <tr>
                    <th>年間家賃収入（満室）</th>
                    <td id="rAnnualRent">—</td>
                  </tr>
                  <tr>
                    <th>空室考慮後収入</th>
                    <td id="rEffectiveRent">—</td>
                  </tr>
                  <tr class="table-sep">
                    <th>管理費</th>
                    <td id="rMgmt">—</td>
                  </tr>
                  <tr>
                    <th>修繕費</th>
                    <td id="rRepair">—</td>
                  </tr>
                  <tr>
                    <th>その他費用</th>
                    <td id="rOther">—</td>
                  </tr>
                  <tr class="table-total">
                    <th>年間総費用</th>
                    <td id="rTotalCost">—</td>
                  </tr>
                  <tr class="table-net">
                    <th>年間純収益（NOI）</th>
                    <td id="rNOI">—</td>
                  </tr>
                </tbody>
              </table>

              <p class="result-disclaimer">
                ※ 計算結果はあくまで参考値です。ローン返済・税金等は含まれていません。
              </p>
            </div>
          </section>
        </div>

        <div class="tool-next-cta">
