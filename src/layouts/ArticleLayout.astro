---
/**
 * ArticleLayout.astro
 * 記事+ツール統合型ページ用の共通レイアウト。
 * 純粋な記事ページ（/articles/*）で使用する。
 * 計算ツール統合ページ（/calculators/*）はBaseLayoutを直接使用する。
 *
 * 横展開時: このレイアウトに新しいProps(eyebrow, heroTitle等)を渡すだけで
 * 共通のヘロー・パンくずが自動生成される。
 */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface BreadcrumbItem {
  name: string;
  href?: string;
}

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  currentPath?: string;
  eyebrow?: string;
  heroTitle: string;
  heroDesc: string;
  breadcrumb?: BreadcrumbItem[];
  updatedDate?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  jsonLd,
  currentPath = '/',
  eyebrow = 'Article',
  heroTitle,
  heroDesc,
  breadcrumb = [],
  updatedDate,
} = Astro.props;
---

<BaseLayout {title} {description} {canonical} {ogImage} {jsonLd}>
  <Header slot="header" currentPath={currentPath} />

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <a href="/">ホーム</a>
        {breadcrumb.map((item) => (
          <Fragment>
            <span>›</span>
            {item.href
              ? <a href={item.href}>{item.name}</a>
              : <span>{item.name}</span>
            }
          </Fragment>
        ))}
      </nav>
      <p class="hero-eyebrow">{eyebrow}</p>
      <h1 class="hero-title">{heroTitle}</h1>
      <p class="hero-desc">{heroDesc}</p>
      {updatedDate && <p class="hero-date">最終更新: {updatedDate}</p>}
    </div>
  </section>

  <slot />

  <Footer slot="footer" />
</BaseLayout>

<style>
  .hero-date {
    margin-top: 12px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
  }
</style>
